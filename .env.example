# Gemini API Key for AI features
GEMINI_API_KEY=

# Mux API Keys for Video Transcoding and Streaming
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── Decentralized Social Layer ────────────────────────────────────────────────
# AES-256-GCM key for encrypting Fediverse credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
ENCRYPTION_KEY=

# Public URL of this deployment — used as OAuth redirect base and Mastodon app website.
VITE_APP_URL=https://plajah.com

# ─── Admin / Firebase service account ──────────────────────────────────────────
# Service-account JSON (the whole file's contents, single line) used by the
# classics seeder and the /api/admin/seed-classic-books endpoint to upload to
# Firebase Storage. Generate: Firebase console → Project settings →
# Service accounts → Generate new private key.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Shared secret guarding /api/admin/seed-classic-books?key=…
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SEED_KEY=
# Shared secret guarding /api/cron/publish-due-posts (the Manager Suite scheduled
# publisher). A scheduler (Cloud Scheduler / cron / uptime pinger) calls it each
# minute: POST /api/cron/publish-due-posts?key=<CRON_SECRET>. ADMIN_SEED_KEY also
# works, but a dedicated secret is cleaner. Same generator as above.
CRON_SECRET=

# ─── Firebase App Check (reCAPTCHA v3) ─────────────────────────────────────────
# reCAPTCHA v3 SITE key — public, embedded in the client. Attests that
# Firestore/Storage/Auth traffic comes from the real app. Register the matching
# SITE + SECRET pair in Firebase console → App Check → (this web app) →
# reCAPTCHA v3. The SECRET key lives ONLY in that console form — never here.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# ─── Studio: commercial social networks ────────────────────────────────────────
# Connect-flow credentials for the Manager Suite publish adapters
# (services/socialNetworks). Each network's adapter is built; it activates once
# its app credentials are present and (where noted) the app clears review.
#
# Meta (Instagram + Facebook + Threads) — one app covers all three:
META_APP_ID=
META_APP_SECRET=
# X (Twitter) — OAuth 2.0 app; requires a paid API plan ($200/mo Basic+):
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn — needs Marketing Developer Platform approval:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok — needs Content Posting API approval:
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube uses the Google OAuth client (Google Cloud) + a quota increase:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

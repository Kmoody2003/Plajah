# Gemini API Key for AI features
GEMINI_API_KEY=

# Mux API Keys for Video Transcoding and Streaming
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── Decentralized Social Layer ────────────────────────────────────────────────
# AES-256-GCM key for encrypting Fediverse credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
ENCRYPTION_KEY=

# Public URL of this deployment — used as OAuth redirect base and Mastodon app website.
VITE_APP_URL=https://plajah.com

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Plajah.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Plajah">

    <Grid x:Name="RootGrid">
        <!-- Mica/Acrylic backdrop applied in code-behind via SystemBackdrop -->

        <!-- Custom title bar — extends into non-client area; coordinated with web DesktopGlobalToolbar -->
        <Grid x:Name="AppTitleBar"
              Height="40"
              VerticalAlignment="Top"
              Canvas.ZIndex="10"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />       <!-- drag region -->
                <ColumnDefinition Width="144" />     <!-- caption buttons (Win11) -->
            </Grid.ColumnDefinitions>

            <!-- Kept collapsed for code-behind compatibility -->
            <TextBlock x:Name="TitleText" Text="Plajah" Visibility="Collapsed" />
            <StackPanel x:Name="MiniPlayerPanel" Visibility="Collapsed">
                <TextBlock x:Name="MiniTrackText" />
                <Button x:Name="MiniPrevBtn" Click="MiniPrev_Click" />
                <Button x:Name="MiniPlayPauseBtn" Click="MiniPlayPause_Click">
                    <FontIcon x:Name="PlayPauseIcon" />
                </Button>
                <Button x:Name="MiniNextBtn" Click="MiniNext_Click" />
            </StackPanel>
        </Grid>

        <!-- WebView2 — fills the entire window under the title bar -->
        <WebView2 x:Name="WebView"
                  NavigationCompleted="WebView_NavigationCompleted"
                  WebMessageReceived="WebView_MessageReceived"
                  Margin="0,0,0,0" />

        <!-- Offline banner — shown when the web view fails to load -->
        <Border x:Name="OfflineBanner"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Margin="12,56,12,0"
                Padding="16,10"
                CornerRadius="8"
                Background="{ThemeResource SystemFillColorCaution}"
                Visibility="Collapsed"
                Canvas.ZIndex="20">
            <TextBlock Text="You appear to be offline. Plajah requires an internet connection."
                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </Border>

        <!-- Loading overlay — shown while WebView2 initialises -->
        <Grid x:Name="LoadingOverlay"
              Background="#FF0A0412"
              Canvas.ZIndex="30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="Assets/StoreLogo.scale-100.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center" />
                <ProgressRing IsActive="True" Width="32" Height="32"
                              Foreground="{StaticResource PlajahPurpleBrush}" />
                <TextBlock Text="Loading Plajah…"
                           HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="#99FFFFFF" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

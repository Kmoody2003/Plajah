<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="mp uap3 uap5 rescap">

  <Identity
    Name="Plajah.App"
    Publisher="CN=PlajahInc"
    Version="1.0.0.0"
    ProcessorArchitecture="neutral" />

  <mp:PhoneIdentity
    PhoneProductId="00000000-0000-0000-0000-000000000000"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Plajah</DisplayName>
    <PublisherDisplayName>Plajah Inc.</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-100.png</Logo>
    <Description>Music, film, books, and creator tools — your full creative universe.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Desktop"   MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="PlajahApp"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="Plajah"
        Description="Music, film, books, and creator tools."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-100.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-100.png">

        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-100.png"
          Square310x310Logo="Assets\LargeTile.scale-100.png"
          ShortName="Plajah">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen Image="Assets\SplashScreen.scale-100.png"
                          BackgroundColor="#0A0412" />

        <!-- Lock-screen badge (for media notifications) -->
        <uap:LockScreen Notification="badge"
                        BadgeLogo="Assets\BadgeLogo.scale-100.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Toast notification activator -->
        <uap:Extension Category="windows.toastNotificationActivation">
          <uap:ToastNotificationActivation ToastActivatorCLSID="{A98D7A8F-4C3B-4B9F-8A2E-5F6D7C8B9A0E}" />
        </uap:Extension>

        <!-- Protocol handler: plajah://view=MUSIC etc. from external links -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="plajah">
            <uap:Logo>Assets\Square44x44Logo.scale-100.png</uap:Logo>
            <uap:DisplayName>Plajah Deep Link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- File type associations: .epub and .pdf for Lorea book reader -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="epub">
            <uap:SupportedFileTypes>
              <uap:FileType>.epub</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>ePub Book</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- File type associations: Photos & Images -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="image">
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.raw</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Plajah Photo Viewer</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- File type associations: Videos -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="video">
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Plajah Video Player</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- File type associations: Audio / Music -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="audio">
            <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Plajah Music Player</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Share target: receive content shared FROM other Windows apps -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Share to Plajah">
            <uap:SupportedDataFormats>
              <uap:DataFormat>http://schema.org/VideoObject</uap:DataFormat>
              <uap:DataFormat>http://schema.org/MusicRecording</uap:DataFormat>
            </uap:SupportedDataFormats>
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- Startup task (optional — runs minimized for notification delivery) -->
        <uap5:Extension Category="windows.startupTask" Executable="PlajahApp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PlajahStartup" Enabled="false" DisplayName="Plajah" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Network -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />

    <!-- Microphone — for audiobook recording (MAI Transcribe 1.5) -->
    <DeviceCapability Name="microphone" />

    <!-- Pictures library — for local photos import & gallery viewing -->
    <uap:Capability Name="picturesLibrary" />

    <!-- Music library — for local music file import -->
    <uap:Capability Name="musicLibrary" />

    <!-- Videos library — for local video import -->
    <uap:Capability Name="videosLibrary" />

    <!-- Documents — for importing books/PDFs -->
    <uap:Capability Name="documentsLibrary" />

    <!-- Restricted: allow running as a full-trust app (needed for WebView2 user data path) -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>

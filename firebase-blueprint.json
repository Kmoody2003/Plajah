{
  "entities": {
    "Album": {
      "title": "Album",
      "description": "A music album microsite project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the album" },
        "ownerId": { "type": "string", "description": "UID of the user who created the album" },
        "title": { "type": "string", "description": "Title of the album" },
        "artist": { "type": "string", "description": "Name of the artist" },
        "artistBio": { "type": "string", "description": "Short biography of the artist" },
        "artistImage": { "type": "string", "description": "URL to the artist's profile image" },
        "coverImage": { "type": "string", "description": "URL to the album cover image" },
        "headerImage": { "type": "string", "description": "URL to a large header image" },
        "description": { "type": "string", "description": "Description of the album" },
        "isPrivate": { "type": "boolean", "description": "Whether the album is private to the owner" },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "artist": { "type": "string" },
              "url": { "type": "string" },
              "duration": { "type": "number" },
              "playCount": { "type": "number", "description": "Public play count" },
              "images": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "slideshow": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "themeColor": { "type": "string", "description": "Primary theme color for the microsite" },
        "isPublic": { "type": "boolean", "description": "Whether the album is visible in the global archive" },
        "galleryUrl": { "type": "string", "description": "Optional URL to a custom gallery experience" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "twitter": { "type": "string" },
            "instagram": { "type": "string" },
            "spotify": { "type": "string" },
            "youtube": { "type": "string" },
            "website": { "type": "string" }
          }
        },
        "musicVideos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "liveFeedUrl": { "type": "string", "description": "Optional URL to a live video feed for this album" },
        "donationGoal": { "type": "number", "description": "Fundraising goal for this album" },
        "donationCurrent": { "type": "number", "description": "Current amount raised for this album" }
      },
      "required": ["id", "title", "artist", "coverImage", "tracks", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile for an artist/user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "featuredPhotoURL": { "type": "string", "description": "High quality photo for featured artist carousels" },
        "email": { "type": "string" },
        "followerCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "acceptsTips": { "type": "boolean" },
        "tipGoal": { "type": "number" },
        "tipCurrent": { "type": "number" },
        "payItForwardOptIn": { "type": "boolean", "description": "Whether the user participates in the Pay It Forward pool" },
        "payItForwardWinsMonth": { "type": "number", "description": "Number of wins in the current 30-day cycle" },
        "payItForwardWinsYear": { "type": "number", "description": "Number of wins in the current year" },
        "lastPayItForwardWinTimestamp": { "type": "number", "description": "Timestamp of the last win" },
        "liveStreamConfig": {
          "type": "object",
          "properties": {
            "streamUrl": { "type": "string" },
            "title": { "type": "string" },
            "isActive": { "type": "boolean" },
            "source": { "type": "string" }
          }
        },
        "revenue": {
          "type": "object",
          "properties": {
            "donations": { "type": "number" },
            "merch": { "type": "number" },
            "adRevenue": { "type": "number" },
            "subscriptions": { "type": "number" },
            "cryptoWallet": {
              "type": "object",
              "properties": {
                "bitcoin": { "type": "string" },
                "ethereum": { "type": "string" },
                "solana": { "type": "string" }
              }
            }
          }
        },
        "storeSettings": {
          "type": "object",
          "properties": {
            "isEnabled": { "type": "boolean" },
            "useExternalStore": { "type": "boolean" },
            "externalStoreUrl": { "type": "string" },
            "showDemoContent": { "type": "boolean" }
          }
        },
        "xHandle": { "type": "string", "description": "X (Twitter) handle for timeline display" },
        "xUrl": { "type": "string", "description": "Full URL to the user's X profile" },
        "xEmbedHtml": { "type": "string", "description": "Raw HTML for Twitter Publish embeds" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "FeedItem": {
      "title": "FeedItem",
      "description": "An item in the global social feed.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "type": { "type": "string", "enum": ["SONG", "PICTURE", "COMMENT"] },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "albumId": { "type": "string" },
        "songUrl": { "type": "string" },
        "songTitle": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "authorId", "type", "content", "timestamp"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A user comment on an album or track",
      "type": "object",
      "properties": {
        "author": { "type": "string", "description": "Name of the commenter" },
        "text": { "type": "string", "description": "Content of the comment" },
        "timestamp": { "type": "number", "description": "Timestamp of the comment" },
        "mediaTimestamp": { "type": "number", "description": "Timestamp in the media for time-stamped comments" },
        "trackId": { "type": "string", "description": "ID of the track, or 'album' for general comments" },
        "videoId": { "type": "string", "description": "ID of the video if commenting on a video" }
      },
      "required": ["author", "text", "timestamp"]
    },
    "LiveFeed": {
      "title": "LiveFeed",
      "description": "A live video broadcast from a studio.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerPhoto": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "ownerId", "title", "url", "timestamp"]
    },
    "MerchItem": {
      "title": "MerchItem",
      "description": "A merchandise item for sale by an artist.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["APPAREL", "MUSIC", "ACCESSORY", "DIGITAL", "COLLECTIBLES", "MEDIA"] },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isDigitalAsset": { "type": "boolean" },
        "linkedAssetId": { "type": "string" }
      },
      "required": ["id", "artistId", "title", "price", "imageUrl", "category"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for a store item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "productId", "userId", "rating", "comment", "timestamp"]
    },
    "Donation": {
      "title": "Donation",
      "description": "A financial contribution to an artist or album.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "toId": { "type": "string" },
        "albumId": { "type": "string" },
        "amount": { "type": "number" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "fromId", "fromName", "toId", "amount", "timestamp"]
    },
    "PPVEvent": {
      "title": "PPVEvent",
      "description": "A pay-per-view live streaming event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "streamUrl": { "type": "string" },
        "price": { "type": "number" },
        "isExclusive": { "type": "boolean" },
        "startTime": { "type": "number" },
        "duration": { "type": "number" },
        "status": { "type": "string", "enum": ["UPCOMING", "LIVE", "ENDED"] },
        "purchasedBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "ownerId", "ownerName", "title", "description", "thumbnailUrl", "streamUrl", "price", "isExclusive", "startTime", "duration", "status"]
    },
    "ProfileThemePreset": {
      "title": "ProfileThemePreset",
      "description": "A customized visual theme preset including background and elements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "mode": { "type": "string", "enum": ["PHOTO_ONLY", "VIDEO_ONLY", "MIX"] },
        "assets": { "type": "array", "items": { "type": "object" } },
        "coverImage": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "downloads": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "creatorId", "title", "description", "mode", "assets", "isPublic", "timestamp"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "A virtual classroom for online learning.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "price": { "type": "number" },
        "syllabus": { "type": "string" },
        "lessons": { "type": "array", "items": { "$ref": "Lesson" } },
        "assignments": { "type": "array", "items": { "$ref": "Assignment" } },
        "enrolledStudents": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      },
      "required": ["id", "ownerId", "ownerName", "title", "description", "thumbnailUrl", "price", "syllabus", "lessons", "assignments", "enrolledStudents", "category"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student's submission for an assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },

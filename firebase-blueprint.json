        "isPrivate": { "type": "boolean", "description": "Whether the video is private" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "playCount": { "type": "number", "description": "Public play count" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "ownerId", "title", "url", "timestamp"]
    },
    "VideoLike": {
      "title": "VideoLike",

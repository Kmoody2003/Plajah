        "roomId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "object" } },
        "startTime": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "roomId", "participants", "startTime", "isActive"]
    },
    "Post": {
      "title": "Post",

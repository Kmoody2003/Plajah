        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "lastAccessed": { "type": "number" }
      },
      "required": ["id", "classId", "studentId", "overallGrade", "completedLessons", "lastAccessed"]
    },
    "VideoChatSession": {
      "title": "VideoChatSession",

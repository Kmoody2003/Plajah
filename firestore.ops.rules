rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// plajah-ops — the org back office (ChMS, accounting, billing, HQ, church, Elevate Live, CRM, laundry,
// org vaults/assets, congregants, donations). Split out of plajah-prod on 2026-10-22 because one
// ruleset is capped at 256,000 compiled bytes; each database gets its own budget.
//
// Rules can only read documents in their OWN database, so the docs these rules authorize against —
// organizations, productions, businessPages, admins — are server-maintained, read-only MIRRORS of
// plajah-prod (services/opsMirror.ts; no client rule here, so clients can't touch them). Which
// collections live here is defined once in services/opsCollections.ts; keep it in step with this file.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    // PLATFORM admin = the owner and designated staff ONLY. Org / business / school admins
    // (organizations/{id}.admins, orgMemberships, business staff roles …) are separate and
    // never make someone a platform admin.
    // Trusted sources: the admins/{uid} collection (no client rule → console / service account
    // only) and the owner's VERIFIED sign-in email. Deliberately NOT users/{uid}.role — an owner
    // can write their own profile, so reading it here let any signed-in user make themselves admin.
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kmoody2003@gmail.com' && request.auth.token.email_verified == true)
      );
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function canAccessHqScope(data) {
      return isAuthenticated() && (
        (data.scopeKind == 'user' && data.scopeId == request.auth.uid) ||
        (data.scopeKind == 'org' && exists(/databases/$(database)/documents/organizations/$(data.scopeId)) && (
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.admins ||
          get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.creatorId == request.auth.uid ||
          // Staff/moderators holding MANAGE_CONTENT (denormalized on the org by
          // organizationService.recomputeOrgStaffUids). Only owners/admins can write that array.
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.get('staffUids', [])
        )) || isAdmin()
      );
    }
    function canAccessHqAsset(assetId) {
      return exists(/databases/$(database)/documents/orgAssets/$(assetId)) &&
        canAccessHqScope(get(/databases/$(database)/documents/orgAssets/$(assetId)).data);
    }
    function isValidDonation(data) {
      return hasRequiredFields(['fromId', 'fromName', 'toId', 'amount', 'timestamp']) &&
             data.fromId is string &&
             data.fromName is string &&
             data.toId is string &&
             data.amount is number && data.amount > 0 &&
             (!('albumId' in data) || (data.albumId is string)) &&
             (!('message' in data) || (data.message is string && data.message.size() < 500));
    }
    // ===============================================================
    // Plajah Billing — invoices / estimates / payment links / customers / price book.
    // Every doc carries entityKey = "KIND:id" (USER|ORG|BUSINESS|PRODUCTION). billingAdminOf mirrors
    // the server's resolveBillingEntity(): USER id==uid; BUSINESS id==owner uid; ORG creator/admins/
    // financeUids/accountingUids/pastorUids; PRODUCTION owner or an authority entry holding MANAGE_BUDGET.
    // Platform flags live in config/billingFlags (readable by everyone via the config rule above — they
    // are non-sensitive switches; writes are admin-only by the same rule).
    // billingInvoices are SERVER-WRITE ONLY: numbers, totals and Stripe ids are server-computed
    // (drafts are saved via POST /api/billing/invoices/save).
    // ===============================================================
    function billKind(k) { return k.split(':')[0]; }
    function billId(k) { return k.split(':')[1]; }
    function billProdAdmin(prodId) {
      let p = get(/databases/$(database)/documents/productions/$(prodId)).data;
      return p.ownerUid == request.auth.uid ||
        ('MANAGE_BUDGET' in p.get('authority', {}).get(request.auth.uid, {}).get('permissions', []));
    }
    function billingAdminOf(k) {
      return isAuthenticated() && (
        (billKind(k) == 'USER' && billId(k) == request.auth.uid) ||
        (billKind(k) == 'BUSINESS' && billId(k) == request.auth.uid) ||
        (billKind(k) == 'ORG' && (chmsFinance(billId(k)) ||
            request.auth.uid in orgDoc(billId(k)).get('accountingUids', []))) ||
        (billKind(k) == 'PRODUCTION' && billProdAdmin(billId(k)))
      );
    }
    // Read-only accounting viewers may read ORG invoices.
    function billingReadOf(k) {
      return billingAdminOf(k) || (isAuthenticated() && billKind(k) == 'ORG' &&
        request.auth.uid in orgDoc(billId(k)).get('accountingViewUids', []));
    }
    function pageStaffCan(pageId, perm) {
      let p = get(/databases/$(database)/documents/businessPages/$(pageId)).data;
      return isAuthenticated() && request.auth.uid in p.get('staffUids', [])
        && perm in p.get('staffSeats', {}).get(request.auth.uid, {}).get('perms', []);
    }
    // ── Hiring / volunteers (ATS) ────────────────────────────────────────────
    function orgAdminOf(orgId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.admins ||
        get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid
      );
    }
    function orgDoc(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)).data; }
    function orgPastorOrAdmin(orgId) {
      return orgAdminOf(orgId) || request.auth.uid in orgDoc(orgId).get('pastorUids', []);
    }
    // ── Elevate ChMS (people / finance / attendance) ─────────────────────────────
    function chmsFinance(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('financeUids', []) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', []));
    }
    function chmsGivingRead(orgId) {
      return chmsFinance(orgId) || (isAuthenticated() && request.auth.uid in orgDoc(orgId).get('givingViewUids', []));
    }
    function chmsPeopleStaff(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', []) ||
        request.auth.uid in orgDoc(orgId).get('staffUids', []) ||
        request.auth.uid in orgDoc(orgId).get('leaderUids', []));
    }
    // ── Elevate Accounting (double-entry) ────────────────────────────────────────
    function acctWrite(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('accountingUids', []) ||
        request.auth.uid in orgDoc(orgId).get('financeUids', []));
    }
    function acctRead(orgId) {
      return acctWrite(orgId) || (isAuthenticated() && (
        request.auth.uid in orgDoc(orgId).get('accountingViewUids', []) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', [])));
    }

    match /billingCustomers/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingItems/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingEstimates/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingPaymentLinks/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingInvoices/{id} {
      // Entity staff (incl. read-only accounting viewers) + the customer it was addressed to (never drafts).
      allow read: if billingReadOf(resource.data.entityKey) ||
        (isAuthenticated() && resource.data.get('customerUid', '') == request.auth.uid && resource.data.status != 'DRAFT');
      allow write: if false;   // server-only (service account bypasses rules)
    }
    // Server-only counters (sequential invoice/estimate numbers).
    match /billingCounters/{id} { allow read, write: if false; }
    // Per-entity billing preferences (default terms/footer/numbering prefix). Doc id IS the entityKey ("ORG:abc").
    match /billingSettings/{entityKey} {
      allow read: if billingReadOf(entityKey);
      allow create, update: if billingAdminOf(entityKey);
      allow delete: if false;
    }
    // Public receipt tokens (GET /r/:token is served by the server). Never client-readable: the token IS the secret.
    match /posReceipts/{token} {
      allow read, write: if false;
    }
    // Business CRM (services/crm): contacts + an append-only activity timeline, keyed by businessId = the
    // businessPages doc id. Only that page's owner (or an admin) can read or write; a contact can't be moved
    // onto another business. Queries must filter where('businessId', '==', id) for the get() to resolve.
    match /crmContacts/{id} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/businessPages/$(resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(resource.data.businessId, 'CRM'));
      allow delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/businessPages/$(resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(resource.data.businessId, 'CRM_ADMIN'));
      allow create: if isAuthenticated() && (
        get(/databases/$(database)/documents/businessPages/$(request.resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(request.resource.data.businessId, 'CRM'));
      allow update: if isAuthenticated() && request.resource.data.businessId == resource.data.businessId && (
        get(/databases/$(database)/documents/businessPages/$(resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(resource.data.businessId, 'CRM'));
    }
    match /crmActivities/{id} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/businessPages/$(resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(resource.data.businessId, 'CRM'));
      allow create: if isAuthenticated() && request.resource.data.byUid == request.auth.uid && (
        get(/databases/$(database)/documents/businessPages/$(request.resource.data.businessId)).data.ownerId == request.auth.uid || isAdmin()
        || pageStaffCan(request.resource.data.businessId, 'CRM'));
      allow update, delete: if isAdmin();
    }
    // Laundromat layer (services/laundryServer.ts). SERVER-ONLY writes: money, accounts and invoices never come from clients.
    // The owner may read their own settings / commercial accounts / invoices; staff read through the server.
    match /laundrySettings/{businessUid} { allow read: if isAuthenticated() && request.auth.uid == businessUid; allow write: if false; }
    match /laundryAccounts/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    match /laundryInvoices/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    match /laundryInvoiced/{id} { allow read, write: if false; }
    match /laundryCounters/{id} { allow read, write: if false; }
    match /laundryReminders/{id} { allow read, write: if false; }
    match /donations/{donationId} {
      allow read: if isAuthenticated() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid || isAdmin() ||
        // Elevate Finance Hub: the church's finance/trustee roles read native online gifts (churchId = org id).
        (resource.data.get('churchId', '') != '' && chmsGivingRead(resource.data.churchId)));
      allow create: if isAuthenticated() && isValidDonation(request.resource.data) && request.resource.data.fromId == request.auth.uid;
    }
    // Church congregant records (Servant Keeper import/export). Church staff only.
    match /congregants/{personId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.churchId)).data.admins;
      allow create: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(request.resource.data.churchId)).data.admins;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.churchId)).data.admins;
    }
    // Private Onboarding PII Vault: stores member phone, email, home address, birthDate, family/household details
    // submitted during membership onboarding so they NEVER sit on public-readable documents.
    // Strictly readable ONLY by the member themselves or authorized org pastors/staff/admins.
    match /orgOnboardingVault/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        chmsPeopleStaff(resource.data.orgId) ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        chmsPeopleStaff(request.resource.data.orgId) ||
        orgPastorOrAdmin(request.resource.data.orgId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
    }
    // Immutable Organization Security Events (screenshot attempts on financials, unauthorized export blocks, etc.).
    match /orgSecurityEvents/{eventId} {
      allow read: if isAuthenticated() && (
        orgPastorOrAdmin(resource.data.orgId) ||
        chmsFinance(resource.data.orgId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Giving: finance/pastors write, trustees read. Gifts are never deleted — void instead.
    match /chmsContributions/{id} {
      // A giver may read ONLY their own gifts (linkedUid denormalized from their ChmsPerson at write time).
      allow read: if chmsGivingRead(resource.data.orgId) ||
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid);
      allow create: if chmsFinance(request.resource.data.orgId) && request.resource.data.enteredBy == request.auth.uid && request.resource.data.amount > 0;
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsBatches/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsPledges/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update, delete: if chmsFinance(resource.data.orgId);
    }
    // Finance Hub misc ledger docs (kind: PAYOUT | TRANSFER | STATEMENT_LOG | RECURRING). Never deleted.
    match /chmsFinanceMeta/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    // Immutable finance audit trail (who entered/voided/approved/exported what).
    match /chmsAudit/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Pastoral-care bridge: "reach out" flags created by finance WITHOUT amounts; pastors/staff read + resolve.
    match /chmsCareFlags/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) && !('amount' in request.resource.data);
      allow update: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsImports/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) || chmsPeopleStaff(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId) || chmsPeopleStaff(resource.data.orgId);
      allow delete: if false;
    }
    // People directory: staff/leaders read+write; finance reads/writes (to match givers); a person can read their own linked record.
    match /chmsPeople/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId) ||
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) || chmsFinance(request.resource.data.orgId);
      allow update: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId) ||
        // Self-service: a linked congregant may change ONLY contact + directory-privacy fields on their own record.
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'phone', 'address', 'preferredName', 'photoUrl', 'directoryVisible', 'updatedAt'])) ||
        // Claim: link an unlinked record to the caller's account using a valid, unused, unexpired claim token for THIS person.
        (isAuthenticated() && resource.data.get('linkedUid', '') == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid', 'claimToken', 'updatedAt']) &&
          request.resource.data.linkedUid == request.auth.uid &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.personId == id &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.orgId == resource.data.orgId &&
          !('usedBy' in get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data) &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.expiresAt > request.time.toMillis());
      allow delete: if orgAdminOf(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', []));
    }
    // Claim tokens (doc id = unguessable token): staff mint them; the claimant reads by id and marks used.
    match /chmsClaims/{token} {
      allow get: if isAuthenticated();
      allow list: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && !('usedBy' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']) && request.resource.data.usedBy == request.auth.uid;
      allow delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Care/follow-up tasks (no private note content — staff only).
    match /chmsTasks/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Volunteer schedule: staff manage; an assignee may read their shift and respond (confirm / decline / swap).
    match /chmsShifts/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || (isAuthenticated() && request.auth.uid in resource.data.get('assignedUids', []));
      allow create: if chmsPeopleStaff(request.resource.data.orgId);
      allow update: if chmsPeopleStaff(resource.data.orgId) || (isAuthenticated() && request.auth.uid in resource.data.get('assignedUids', []) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignments', 'updatedAt']));
      allow delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Outbound message log.
    match /chmsMessages/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) && request.resource.data.sentBy == request.auth.uid;
      allow update, delete: if false;
    }
    match /chmsHouseholds/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) || chmsFinance(request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
    }
    match /chmsAttendance/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) ||
        // Self check-in: a linked congregant may check THEMSELVES in.
        (isAuthenticated() && request.resource.data.personId is string &&
          get(/databases/$(database)/documents/chmsPeople/$(request.resource.data.personId)).data.get('linkedUid', '') == request.auth.uid &&
          get(/databases/$(database)/documents/chmsPeople/$(request.resource.data.personId)).data.orgId == request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Pastoral care notes: PASTORAL = pastors/admins only; STAFF = staff; finance can never read notes.
    match /chmsNotes/{id} {
      allow read: if isAuthenticated() && (orgAdminOf(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', []) ||
        (resource.data.visibility == 'STAFF' && chmsPeopleStaff(resource.data.orgId)));
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid && chmsPeopleStaff(request.resource.data.orgId);
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }
    match /acctAccounts/{id} {
      // Department heads read the chart so their budget view can show account names (the chart is not sensitive).
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId);
      allow delete: if false;
    }
    // Journals are append-only: corrections are reversal entries. Only status/reversedBy may change.
    match /acctJournals/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedBy']);
      allow delete: if false;
    }
    match /acctVendors/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId);
      allow delete: if false;
    }
    // Expenses/bills/reimbursements: any staff/leader/accounting member may SUBMIT; approvers (dept heads,
    // pastors, accounting) read and decide; the submitter sees their own. Money state is accounting-only.
    match /acctExpenses/{id} {
      allow read: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid ||
        acctRead(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status in ['DRAFT', 'SUBMITTED'] && request.resource.data.amount > 0 && (
          acctWrite(request.resource.data.orgId) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('staffUids', []) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('leaderUids', []) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('pastorUids', []));
      allow update: if isAuthenticated() && (
        acctWrite(resource.data.orgId) ||
        // submitter edits/withdraws their own before approval
        (resource.data.submittedBy == request.auth.uid && resource.data.status in ['DRAFT', 'SUBMITTED'] &&
          request.resource.data.status in ['DRAFT', 'SUBMITTED', 'VOID']) ||
        // department heads / pastors approve or reject (never mark paid)
        ((request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []) || request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', [])) &&
          resource.data.status == 'SUBMITTED' && request.resource.data.status in ['APPROVED', 'REJECTED'] &&
          request.resource.data.submittedBy == resource.data.submittedBy && request.resource.data.amount == resource.data.amount));
      allow delete: if false;
    }
    match /acctBankAccounts/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    match /acctBankTxns/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if acctWrite(resource.data.orgId);
    }
    match /acctBudgets/{id} {
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Budget Pulse: budgeted projects/campaigns (spend is tagged via projectId / fundId on journal lines + expenses).
    match /acctProjects/{id} {
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Budget Pulse alerts: created by the server sweep (admin token) or finance clients; readers may only acknowledge/snooze.
    // Department heads read the alerts addressed to them via audienceUids (denormalised at creation).
    match /acctAlerts/{id} {
      allow read: if isAuthenticated() && (acctRead(resource.data.orgId) || request.auth.uid in resource.data.get('audienceUids', []));
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if isAuthenticated() && (acctRead(resource.data.orgId) || request.auth.uid in resource.data.get('audienceUids', [])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy', 'snoozedUntil']);
      allow delete: if false;
    }
    match /acctPeriods/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Stripe-synced payouts + lines are written by the server (admin token). Clients only mark a payout
    // matched/unmatched during bank reconciliation (acctService.acceptMatches / unmatch) — amounts are server truth.
    match /chmsPayouts/{id} {
      allow read: if chmsGivingRead(resource.data.orgId) || acctRead(resource.data.orgId);
      allow create: if false;
      allow update: if acctWrite(resource.data.orgId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reconciled', 'bankTxnId']);
      allow delete: if false;
    }
    match /chmsPayoutLines/{id} {
      allow read: if chmsGivingRead(resource.data.orgId) || acctRead(resource.data.orgId);
      allow write: if false;
    }
    // ── Content HQ — private DAM assets (files/docs/brand specs) ──────────────
    // scopeKind 'user' → the account owner; scopeKind 'org' → the org's admins/creator.
    match /orgAssets/{assetId} {
      function cxScopeOk(data) {
        return isAuthenticated() && (
          (data.scopeKind == 'user' && data.scopeId == request.auth.uid) ||
          (data.scopeKind == 'org' && (
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.admins ||
            get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.creatorId == request.auth.uid ||
            // Staff/moderators with MANAGE_CONTENT (denormalized staffUids; owner/admin-writable only).
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.get('staffUids', [])
          )) ||
          isAdmin()
        );
      }
      allow read: if cxScopeOk(resource.data);
      allow create: if cxScopeOk(request.resource.data) && request.resource.data.uploadedByUid == request.auth.uid;
      allow update: if cxScopeOk(resource.data) && cxScopeOk(request.resource.data);
      allow delete: if cxScopeOk(resource.data);
    }
    // Immutable revision records. Replacing a file creates a new version; it never
    // overwrites the version a reviewer approved.
    match /hqAssetVersions/{versionId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.uploadedByUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /hqComments/{commentId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.body is string && request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 4000;
      allow update: if canAccessHqAsset(resource.data.assetId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedByUid']);
      allow delete: if false;
    }
    match /hqReviewRequests/{reviewId} {
      allow read: if canAccessHqAsset(resource.data.assetId) ||
        (isAuthenticated() && request.auth.uid in resource.data.reviewerUids);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.requestedByUid == request.auth.uid;
      allow update: if canAccessHqAsset(resource.data.assetId) ||
        (isAuthenticated() && request.auth.uid in resource.data.reviewerUids &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decisions', 'status', 'completedAt']));
      allow delete: if false;
    }
    // Append-only asset audit. This is separate from the general org audit so an
    // asset can carry its complete evidence trail when delivered or exported.
    match /hqActivity/{eventId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /hqShareLinks/{shareId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if canAccessHqAsset(resource.data.assetId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt', 'expiresAt', 'allowComments', 'allowApproval', 'allowDownload', 'requireEmail']);
      allow delete: if false;
    }
    // Account-free reviewer decisions. Written ONLY by the server (Admin creds) through the
    // tokenized share endpoints — guests never authenticate — so client writes stay closed.
    // The asset's owning scope can read them to see who approved / requested changes.
    match /hqGuestDecisions/{decisionId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow write: if false;
    }
    // Durable security audit (Wave 3): retention purges + quota rejections. Written ONLY
    // by the server (Admin creds, which bypass rules) and it must outlive the assets it
    // records, so clients get no access at all.
    match /hqAuditLog/{entryId} {
      allow read, write: if false;
    }
    // Church education programs (Sunday school / Bible study plans). Anyone signed in can read; only the church's admins write.
    match /churchPrograms/{programId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid
        && (request.auth.uid in get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.admins
            || request.auth.uid == get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.creatorId);
      // A class's own teachers may update it (roster, weeks) but never move it or change ownership.
      allow update: if isAuthenticated() && request.auth.uid in resource.data.get('teacherUids', [])
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.admins);
    }
    // ── Christian Ed desk mirror (services/christianEdSync.ts) ───────────────────
    function eduProgram(pid) { return get(/databases/$(database)/documents/churchPrograms/$(pid)).data; }
    function eduTeacher(pid) {
      return isAuthenticated() && (request.auth.uid in eduProgram(pid).get('teacherUids', []) || orgAdminOf(eduProgram(pid).orgId));
    }
    function eduStudent(pid) { return isAuthenticated() && request.auth.uid in eduProgram(pid).get('studentUids', []); }
    match /churchEduAssignments/{aid} {
      allow read: if eduTeacher(resource.data.classroomId) || eduStudent(resource.data.classroomId);
      allow create, update: if eduTeacher(request.resource.data.classroomId);
      allow delete: if eduTeacher(resource.data.classroomId);
    }
    match /churchEduSubmissions/{sid} {
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || eduTeacher(resource.data.programId));
      // Students write their own turn-in (and may re-turn-in before review); review fields and the
      // RETURNED_WITH_FEEDBACK status are teacher-only.
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid
        && sid == request.resource.data.assignmentId + '__' + request.auth.uid
        && eduStudent(request.resource.data.programId)
        && request.resource.data.get('status', '') != 'RETURNED_WITH_FEEDBACK'
        && !request.resource.data.keys().hasAny(['reviewVerdicts', 'teacherFeedbackNote', 'reviewedByUid', 'reviewedAt']);
      allow update: if (isAuthenticated() && resource.data.studentUid == request.auth.uid
          && resource.data.status != 'RETURNED_WITH_FEEDBACK'
          && request.resource.data.get('status', '') != 'RETURNED_WITH_FEEDBACK'
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.programId == resource.data.programId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewVerdicts', 'teacherFeedbackNote', 'reviewedByUid', 'reviewedAt']))
        || (eduTeacher(resource.data.programId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewVerdicts', 'teacherFeedbackNote', 'earnedPoints', 'percentage', 'questionScores', 'reviewedByUid', 'reviewedAt', 'updatedAt']));
      allow delete: if eduTeacher(resource.data.programId);
    }
    // Answer keys stay with the class's teachers; the class copy in churchEduAssignments carries none.
    match /churchEduAnswerKeys/{aid} {
      allow read, delete: if eduTeacher(resource.data.programId);
      allow create, update: if eduTeacher(request.resource.data.programId) && request.resource.data.assignmentId == aid;
    }
    match /churchEduJoinRequests/{rid} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || eduTeacher(resource.data.programId));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.programId + '__' + request.auth.uid
        && request.resource.data.code == eduProgram(request.resource.data.programId).get('joinCode', '');
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || eduTeacher(resource.data.programId));
    }
    // ── Announcements: posts, flyers, polls, surveys (services/announcements/announcementService.ts) ──
    // class → the class's teachers post, its teachers + students read. members → org people staff post,
    // the uids denormalised into audienceUids read. public → org people staff post, anyone signed in reads.
    function annCanRead(a) {
      return isAuthenticated() && (a.audience == 'public' ||
        (a.audience == 'class' && (eduTeacher(a.programId) || eduStudent(a.programId))) ||
        (a.audience == 'members' && (request.auth.uid in a.get('audienceUids', []) || chmsPeopleStaff(a.orgId))) ||
        isAdmin());
    }
    function annManager(a) {
      return isAuthenticated() && ((a.audience == 'class' && eduTeacher(a.programId)) || (a.audience != 'class' && chmsPeopleStaff(a.orgId)));
    }
    function annDoc(id) { return get(/databases/$(database)/documents/orgAnnouncements/$(id)).data; }
    match /orgAnnouncements/{id} {
      allow read: if annCanRead(resource.data);
      allow create: if annManager(request.resource.data) && request.resource.data.authorUid == request.auth.uid && request.resource.data.id == id
        && request.resource.data.get('flyerJson', '').size() < 700000;
      allow update: if annManager(resource.data) && (
          (resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.orgId == resource.data.orgId && request.resource.data.audience == resource.data.audience
            && request.resource.data.get('programId', '') == resource.data.get('programId', ''))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'updatedAt']));
      allow delete: if (annManager(resource.data) && resource.data.authorUid == request.auth.uid)
        || (resource.data.audience != 'class' && orgAdminOf(resource.data.orgId)) || isAdmin();
    }
    // One response per person. Poll tallies are readable by the audience only when the author chose to
    // show results and nothing else (a survey) rides on it; survey answers stay with the author and managers.
    match /announcementResponses/{rid} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || annManager(annDoc(resource.data.annId)) ||
        (annDoc(resource.data.annId).get('poll', {}).get('showResults', false) == true && annDoc(resource.data.annId).get('survey', null) == null
          && annCanRead(annDoc(resource.data.annId))));
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.annId + '__' + request.auth.uid
        && annCanRead(annDoc(request.resource.data.annId));
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    // ── Template library (services/templates/docTemplateLibrary.ts) ───────────
    // platform → everyone reads. org → the org's Content HQ people read/write. user → owner only.
    // Platform templates are written ONLY by the server (routes/templateShare.ts): it resolves the
    // sharer's real roles in every org the document came from, applies each org's policy and strips the
    // org's content itself. Afterwards the owner may retitle it but never swap the document underneath.
    function tplOrgStaff(orgId) { return canAccessHqScope({'scopeKind': 'org', 'scopeId': orgId}) || chmsPeopleStaff(orgId); }
    match /docTemplates/{id} {
      allow read: if isAuthenticated() && (resource.data.tier == 'platform' || resource.data.ownerUid == request.auth.uid
        || (resource.data.tier == 'org' && tplOrgStaff(resource.data.orgId)) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.id == id
        && request.resource.data.bundleJson is string && request.resource.data.bundleJson.size() < 750000
        && (request.resource.data.tier == 'user'
          || (request.resource.data.tier == 'org' && tplOrgStaff(request.resource.data.orgId)));
      allow update: if isAuthenticated() && (
          (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.tier == resource.data.tier && request.resource.data.get('fromOrgId', '') == resource.data.get('fromOrgId', '')
            && (resource.data.tier != 'platform'
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'tags', 'updatedAt'])))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) && request.resource.data.uses == resource.data.get('uses', 0) + 1));
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid
        || (resource.data.tier == 'org' && orgAdminOf(resource.data.orgId)) || isAdmin());
    }
    match /orgTemplatePolicies/{orgId} {
      allow read: if isAuthenticated();
      allow write: if orgAdminOf(orgId) || isAdmin();
    }
    match /churchPrayers/{prayerId} {
      // Public wall prayers: any signed-in user. Private requests: author, pastors/ministers, prayer warriors, admins.
      allow read: if isAuthenticated() && (
        resource.data.get('isPrivate', false) == false ||
        resource.data.authorId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('prayerUids', []) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        // Anyone may add/remove themselves from the praying list.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayingIds']) ||
        // Org admins + pastors/ministers may mark answered.
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
    }
    // ── Plajah Elevate Live (auto article + briefing from live streams) ──────
    // Master Control → Elevate Live surface: per-org config, scheduled runs,
    // generated briefings and repurpose jobs. Org admins (creatorId/admins)
    // manage their own org's docs; platform admins manage all.
    match /elevateLiveConfigs/{orgId} {
      allow read: if orgAdminOf(orgId) || isAdmin();
      allow create, update: if orgAdminOf(orgId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /elevateLiveRuns/{runId} {
      allow read: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow create: if orgAdminOf(request.resource.data.orgId) || isAdmin();
      allow update: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /elevateBriefings/{briefingId} {
      allow read: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow create: if orgAdminOf(request.resource.data.orgId) || isAdmin();
      allow update: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow delete: if isAdmin();
    }
    // ── Live co-editing of creative projects (services/coedit) ───────────────────────────────
    // coedit/{projectId} holds membership (owner, members {uid: role}, memberIds). Only the owner
    // manages who's in; editors may rename; anyone but the owner may leave. Subcollections carry
    // the live op log, compacted snapshots (chunks), shared + private history, presence and each
    // member's held draft. Self-contained: nothing here reads plajah-prod.
    match /coedit/{pid} {
      function co() { return get(/databases/$(database)/documents/coedit/$(pid)).data; }
      function coRole() { return co().members.get(request.auth.uid, ''); }
      function coMember() { return isAuthenticated() && coRole() != ''; }
      function coEditor() { return isAuthenticated() && coRole() in ['owner', 'editor']; }
      function coShape(d) {
        return d.ownerId is string && d.kind is string && d.title is string && d.title.size() <= 300 &&
          d.members is map && d.memberIds is list && d.memberIds.size() <= 200 &&
          d.members.get(d.ownerId, '') == 'owner' && d.ownerId in d.memberIds;
      }
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] && coShape(request.resource.data) &&
        pid.matches('^' + request.resource.data.kind + '__.+$');
      allow update: if isAuthenticated() && coShape(request.resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId && request.resource.data.kind == resource.data.kind && (
          resource.data.ownerId == request.auth.uid ||
          (resource.data.members.get(request.auth.uid, '') == 'editor' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'chatRoomId'])) ||
          (request.auth.uid in resource.data.memberIds && !(request.auth.uid in request.resource.data.memberIds) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'names', 'photos', 'updatedAt']) &&
           request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
        );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /ops/{batchId} {
        allow read: if coMember();
        allow create, update: if coEditor() && request.resource.data.u == request.auth.uid &&
          request.resource.data.ops is string && request.resource.data.ops.size() < 1048000 &&
          request.resource.data.at == request.time &&
          (resource == null || resource.data.u == request.auth.uid);
        allow delete: if coEditor();
      }
      match /snap/{key} {
        allow read: if coMember();
        allow write: if coEditor();
      }
      match /chunks/{key} {
        allow read: if coMember();
        allow create, update: if coMember() && request.resource.data.d is string && request.resource.data.d.size() < 1000000;
        allow delete: if coMember();
      }
      match /versions/{vid} {
        allow read: if coMember() && (resource.data.private == false || resource.data.by == request.auth.uid);
        allow create: if coMember() && request.resource.data.by == request.auth.uid &&
          request.resource.data.private is bool && (coEditor() || request.resource.data.private == true);
        allow update: if coMember() && (resource.data.by == request.auth.uid || coEditor()) &&
          request.resource.data.by == resource.data.by && request.resource.data.private == resource.data.private;
        allow delete: if coMember() && (resource.data.by == request.auth.uid || coRole() == 'owner' ||
          (coEditor() && resource.data.reason == 'checkpoint'));
      }
      match /presence/{key} {
        allow read: if coMember();
        allow create, update: if coMember() && request.resource.data.uid == request.auth.uid && key.matches('^' + request.auth.uid + '_.+$');
        allow delete: if coMember() && (key.matches('^' + request.auth.uid + '_.+$') || coEditor());
      }
      match /drafts/{uid} {
        allow read, write: if coMember() && uid == request.auth.uid;
      }
      // Everyone's media in the project, with provenance. Only the contributor writes their entry
      // (status/tiers follow their uploads); the owner may remove anything.
      match /assets/{assetId} {
        allow read: if coMember();
        allow create: if coEditor() && request.resource.data.owner == request.auth.uid && request.resource.data.id == assetId;
        allow update: if coMember() && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner &&
          request.resource.data.id == resource.data.id;
        allow delete: if coMember() && (resource.data.owner == request.auth.uid || coRole() == 'owner');
      }
      // What each person brings to a live session (only what they chose to share).
      match /rigs/{key} {
        allow read: if coMember();
        allow create, update: if coMember() && request.resource.data.uid == request.auth.uid && key.matches('^' + request.auth.uid + '_.+$');
        allow delete: if coMember() && key.matches('^' + request.auth.uid + '_.+$');
      }
      // "May I use your preset?" — asked by a member, answered by the person asked.
      match /requests/{rid} {
        allow read: if coMember() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow create: if coMember() && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if coMember() && resource.data.to == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assetId']);
        allow delete: if coMember() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }
    }

    match /contentRepurposeJobs/{jobId} {
      allow read: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow create: if orgAdminOf(request.resource.data.orgId) || isAdmin();
      allow update: if orgAdminOf(resource.data.orgId) || isAdmin();
      allow delete: if isAdmin();
    }
    // ===============================================================
    // Moved from plajah-prod 2026-10-29 (ruleset over the 256,000-byte cap): education staff tools,
    // business back office, press/rights admin and other self-contained blocks. Text unchanged.
    // ===============================================================
    function tplReadable(d) {
      return d.visibility == 'public'
        || (isAuthenticated() && (d.ownerUid == request.auth.uid || request.auth.uid in d.get('sharedWith', [])))
        || isAdmin();
    }
    function tplValid(d) {
      return d.ownerUid == request.auth.uid
        && d.kind in ['ambo-slide', 'scripture-look', 'tela-motion']
        && d.visibility in ['private', 'shared', 'public']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.get('sharedWith', []) is list && d.get('sharedWith', []).size() <= 200
        && d.get('thumb', '') is string && d.get('thumb', '').size() <= 200000;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function canAccessWorksheetById(worksheetId) {
      return exists(/databases/$(database)/documents/digital_worksheets/$(worksheetId)) &&
        canAccessDigitalWorksheet(get(/databases/$(database)/documents/digital_worksheets/$(worksheetId)).data);
    }
    function canAccessDigitalWorksheet(data) {
      return isAuthenticated() && (
        data.createdBy == request.auth.uid ||
        request.auth.uid in data.get('accessUids', []) ||
        isAdmin()
      );
    }
    function worksheetAssignment(assignmentId) {
      return get(/databases/$(database)/documents/worksheet_assignments/$(assignmentId)).data;
    }
    function worksheetGradeFields() {
      return ['score', 'maxScore', 'percent', 'needsManualReview', 'gradedAt', 'preAssessment', 'teacherOverrides', 'teacherReviewedAt'];
    }
    function canAccessWorksheetAssignment(data) {
      return isAuthenticated() && (
        data.teacherUid == request.auth.uid ||
        request.auth.uid in data.get('studentIds', []) ||
        isAdmin()
      );
    }
    function worksheetKeyWrite(worksheetId) {
      return isAuthenticated() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.worksheetId == worksheetId
        && exists(/databases/$(database)/documents/digital_worksheets/$(worksheetId))
        && get(/databases/$(database)/documents/digital_worksheets/$(worksheetId)).data.createdBy == request.auth.uid;
    }
    function isValidAdCampaign(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'type', 'targetType', 'imageUrl', 'budget', 'frequency', 'probability', 'isActive', 'timestamp']) &&
             data.id is string && data.ownerId is string && data.title is string &&
             data.type in ['USER_PROMOTION', 'PARTNER', 'THIRD_PARTY'] &&
             data.targetType in ['POST', 'ALBUM', 'PROFILE', 'EXTERNAL'] &&
             data.imageUrl is string && data.budget is number && data.frequency is number &&
             data.probability is number && data.isActive is bool && data.timestamp is number;
    }
    function nrOwner(d) { return isAuthenticated() && d.get('ownerId', '') == request.auth.uid; }
    function piAdviserOk(d) { return d.get('tier', 'pro') != 'student' || (d.get('adviserApproval', null) != null && d.adviserApproval.uid == d.get('adviserUid', '')); }
    function piStaff(d) { return isAuthenticated() && (d.ownerId == request.auth.uid || request.auth.uid in d.get('staffUids', [])); }
    function nrOrgStaff(d) {
      return isAuthenticated() && d.get('orgId', '') != '' && request.auth.uid in orgDoc(d.orgId).get('staffUids', []);
    }
    function nrCreate(d) {
      return nrOwner(d) && (d.get('orgId', '') == '' || request.auth.uid in orgDoc(d.orgId).get('staffUids', []) || orgAdminOf(d.orgId));
    }
    function isValidProgressReport(data) {
      return hasRequiredFields(['id', 'classId', 'studentId', 'overallGrade', 'completedLessons', 'lastAccessed']) &&
             data.classId is string &&
             data.studentId is string &&
             data.overallGrade is number &&
             data.completedLessons is list &&
             data.lastAccessed is number;
    }
    function ownerStaffCan(ownerUid, perm) {
      return isAuthenticated() && ownerUid is string
        && perm in get(/databases/$(database)/documents/businessStaffIndex/$(ownerUid)).data.get('staffPerms', {}).get(request.auth.uid, []);
    }
    // experienceFilms/{exhibitId}: the minimal playback doc the Dossier hall reads so ANY visitor (signed in or not)
    // can watch an exhibit film from Mux. Public read; only a platform admin can write, and only this exact shape:
    // a public Mux playback id plus display fields. The film is SOURCED FROM a public Reello video: reelloVideoId names
    // it and muxPlaybackId is copied from it (so visitors never need to read videos/). The admin tools only write this
    // doc while that Reello video is public, and remove it when the video goes private or is deleted.
    // Deleting it sends the hall back to the live canvas film.
    match /experienceFilms/{exhibitId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['exhibitId', 'experienceId', 'reelloVideoId', 'title', 'muxPlaybackId', 'playbackPolicy', 'durationSec', 'width', 'height', 'captionsUrl', 'updatedAt'])
        && request.resource.data.keys().hasAll(['exhibitId', 'experienceId', 'reelloVideoId', 'title', 'muxPlaybackId', 'playbackPolicy', 'durationSec', 'updatedAt'])
        && request.resource.data.exhibitId == exhibitId
        && request.resource.data.reelloVideoId is string
        && request.resource.data.reelloVideoId.size() > 0 && request.resource.data.reelloVideoId.size() < 200
        && request.resource.data.playbackPolicy == 'public'
        && request.resource.data.muxPlaybackId is string
        && request.resource.data.muxPlaybackId.size() >= 8 && request.resource.data.muxPlaybackId.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() < 200
        && request.resource.data.durationSec is number && request.resource.data.durationSec > 0
        && (!('captionsUrl' in request.resource.data) || (request.resource.data.captionsUrl is string && request.resource.data.captionsUrl.size() < 1000));
      allow delete: if isAdmin();
    }
    // Learning support (IEP / 504 / neurodiversity) plans — sensitive. Readable only by the learner, their guardian and
    // the team the family chose (teamUids). The learner and guardian write; a child learner cannot change the team.
    // Team members may only log goal progress and edit the shared notes. Never listable by anyone else.
    // Education Commons (services/educationCouncil/commons.ts): members self-register unverified; proposals are
    // public to signed-in users; a member may only write their own ballot.
    match /educationCouncilMembers/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && request.resource.data.uid == uid && request.resource.data.verified == false;
      allow update: if isOwner(uid) && request.resource.data.verified == resource.data.verified && request.resource.data.uid == uid;
    }
    match /educationCommons/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid
                    && exists(/databases/$(database)/documents/educationCouncilMembers/$(request.auth.uid))
                    && request.resource.data.ballots.size() == 0 && request.resource.data.status == 'open';
      allow update: if isAuthenticated()
                    && exists(/databases/$(database)/documents/educationCouncilMembers/$(request.auth.uid))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ballots', 'status', 'updatedAt'])
                    && request.resource.data.ballots.diff(resource.data.ballots).affectedKeys().hasOnly([request.auth.uid]);
    }
    // Canonical store catalog (consolidated store system). Seller-owned; buyers may only
    // touch stock/soldCount/reviewCount (checkout + reviews).
    match /storeProducts/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.sellerId == request.auth.uid
                    || ownerStaffCan(request.resource.data.sellerId, 'INVENTORY'));
      // Stock and soldCount are written by the SELLER (dashboard) or the server order spine (admin
      // credentials) — never by shoppers. (A previous rule let ANY signed-in user rewrite any product's
      // stock.) Shoppers may only bump review aggregates.
      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                    || (request.resource.data.sellerId == resource.data.sellerId && ownerStaffCan(resource.data.sellerId, 'INVENTORY'))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'rating', 'updatedAt']));
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin() || ownerStaffCan(resource.data.sellerId, 'INVENTORY'));

      // Back-in-stock waitlist: a shopper adds/removes themselves; the seller reads it to notify.
      match /waitlist/{shopperUid} {
        allow create: if isAuthenticated() && request.auth.uid == shopperUid;
        allow read, delete: if isAuthenticated() && (request.auth.uid == shopperUid
                    || get(/databases/$(database)/documents/storeProducts/$(productId)).data.sellerId == request.auth.uid);
        allow update: if false;
      }
    }
    // Stock ledger — every receive/sale/adjust/damage, so "where did my inventory go" has an answer.
    // The seller reads + appends their own entries; the server writes sale entries; nobody edits history.
    match /stockMoves/{moveId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin() || ownerStaffCan(resource.data.sellerId, 'INVENTORY'));
      allow create: if isAuthenticated() && (request.resource.data.sellerId == request.auth.uid || ownerStaffCan(request.resource.data.sellerId, 'INVENTORY'));
      allow update, delete: if false;
    }
    // Orders are created ONLY by the server order spine (Stripe-paid / POS), which prices + stock-checks
    // every line. The seller may advance status / add tracking; the buyer reads.
    match /storeOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin() || ownerStaffCan(resource.data.sellerId, 'ORDERS'));
      allow create: if false;
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin() || ownerStaffCan(resource.data.sellerId, 'ORDERS'))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingNumber', 'trackingCarrier', 'shippedAt', 'oversold', 'sellerNote']);
    }
    // POS refunds: written ONLY by the server (/api/store/pos-refund: validates qty/amount, restocks through the
    // ledger, idempotent by id). The seller reads them for reports and the returns picker.
    match /storeRefunds/{refundId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin() || ownerStaffCan(resource.data.sellerId, 'REPORTS'));
      allow write: if false;
    }
    // Artist↔business cross-promo bookings: the business creates; both parties read; the creator
    // (or business) updates status (accept/decline). Queried by creatorUid / businessUid.
    match /promoBookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.businessUid == request.auth.uid || resource.data.creatorUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.businessUid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.businessUid == request.auth.uid);
    }
    // Owner-level staff index: the owner and the listed staff may read it; only the server writes it.
    match /businessStaffIndex/{ownerUid} {
      allow read: if isAuthenticated() && (request.auth.uid == ownerUid || request.auth.uid in resource.data.get('staffUids', []));
      allow write: if false;
    }
    // Digital signage slides, keyed by businessId = the businessPages doc id. Public read: in-store
    // screens are often unauthenticated TVs. Writes only by that page's owner (or an admin); an update
    // must stay owned by the same page owner on both sides (no moving a slide onto someone else's page).
    match /signageSlides/{id} {
      function signageOwner(bizId) {
        return get(/databases/$(database)/documents/businessPages/$(bizId)).data.ownerId == request.auth.uid;
      }
      allow read: if true;
      allow create: if isAuthenticated() && (signageOwner(request.resource.data.businessId) || isAdmin()
                    || pageStaffCan(request.resource.data.businessId, 'SIGNAGE'));
      allow update: if isAuthenticated() && ((signageOwner(resource.data.businessId) && signageOwner(request.resource.data.businessId)) || isAdmin()
                    || (pageStaffCan(resource.data.businessId, 'SIGNAGE') && pageStaffCan(request.resource.data.businessId, 'SIGNAGE')));
      allow delete: if isAuthenticated() && (signageOwner(resource.data.businessId) || isAdmin()
                    || pageStaffCan(resource.data.businessId, 'SIGNAGE'));
    }
    // Business-ops namespace: businesses/{ownerUid} holds a business's subcollections (the doc id IS
    // the owner's uid). Separate from the businessPages collection. Covers messaging opt-in/broadcasts
    // and the Team/HR module (staff, shifts, time-off). (Without this, those writes were denied.)
    match /businesses/{businessUid} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == businessUid;

      // A customer opts into a business's updates (writes their own doc); the business reads its list.
      match /subscribers/{customerUid} {
        allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid || ownerStaffCan(businessUid, 'CRM'));
        allow write: if isAuthenticated() && (request.auth.uid == customerUid || request.auth.uid == businessUid);
      }
      // Owner-managed: broadcast log + the Team/HR module.
      match /broadcasts/{id} { allow read, write: if isAuthenticated() && (request.auth.uid == businessUid || ownerStaffCan(businessUid, 'MARKETING')); }
      // Staff roster. PINs are NEVER client-readable/writable: the only PIN material is a salted hash in
      // staffSecrets (below), written by the server. Writes that carry pin/pinHash/pinSalt are rejected.
      match /staff/{id} {
        allow read, delete: if isAuthenticated() && request.auth.uid == businessUid;   // owner only: staff docs hold payRate
        allow create, update: if isAuthenticated() && request.auth.uid == businessUid
                              && !request.resource.data.keys().hasAny(['pin', 'pinHash', 'pinSalt']);
      }
      // Server-only: salted PIN hashes, open-shift markers, drawer pointer. No client access at all.
      match /staffSecrets/{id} { allow read, write: if false; }
      match /shiftOpen/{id}    { allow read, write: if false; }
      match /drawerState/{id}  { allow read, write: if false; }
      // Shifts are written by the server (PIN-verified clock in/out); the owner may read and correct them.
      match /shifts/{id}     { allow read, write: if isAuthenticated() && request.auth.uid == businessUid; allow read: if ownerStaffCan(businessUid, 'TEAM'); }   // owner may seed/correct; PIN clock events are server-written
      match /timeOff/{id}    { allow read, write: if isAuthenticated() && request.auth.uid == businessUid; allow read: if ownerStaffCan(businessUid, 'TEAM'); }
      // Cash drawer sessions + Z reports: server-written (staff sign in by PIN, not Firestore); the owner reads.
      match /drawerSessions/{id} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || ownerStaffCan(businessUid, 'REPORTS')); allow write: if false; }
      // Stored value (gift cards / store credit / wallets): SERVER-WRITE-ONLY. Owner reads; a customer reads only their own
      // customer-tied card (wallet / credit) and its ledger. The code-hash index (storedValueIndex) has NO client rule at all.
      match /storedValue/{cardId} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || resource.data.get('customerUid', '') == request.auth.uid); allow write: if false; }
      match /storedValueLedger/{entryId} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || resource.data.get('customerUid', '') == request.auth.uid); allow write: if false; }
      // Loyalty balances are written server-side (POS sale); the business and the customer can read.
      match /loyalty/{customerUid} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid); }
      // In-store deals: the business writes, anyone may read (register + storefront evaluate them).
      match /offers/{id} { allow read: if true; allow write: if isAuthenticated() && (request.auth.uid == businessUid || ownerStaffCan(businessUid, 'INVENTORY')); }
      // Now Playing — the business publishes the current in-store track; checked-in customers read it.
      match /nowPlaying/{id} { allow read: if true; allow write: if isAuthenticated() && (request.auth.uid == businessUid || ownerStaffCan(businessUid, 'SIGNAGE')); }
      // Presence — a customer checks in (writes their own doc); the business sees who's in-store.
      match /presence/{customerUid} {
        allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid || ownerStaffCan(businessUid, 'CRM'));
        allow write: if isAuthenticated() && (request.auth.uid == customerUid || request.auth.uid == businessUid);
      }
    }
    // Service tickets (repair orders, wash-and-fold). SERVER-ONLY writes (Admin/REST via /api/tickets/*, CAS-guarded).
    // The business owner may read their own tickets; staff (PIN sessions) read through the server. Customers never
    // read this collection: they use the HMAC link page (/t/:token), which strips internal notes, costs and audit.
    // Counters are server-only. There are no token docs: link tokens are HMACs, nothing is stored to leak.
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.businessUid == request.auth.uid || ownerStaffCan(resource.data.businessUid, 'ORDERS'));
      allow write: if false;
    }
    // Auto repair layer (services/autoServer.ts). Every write is SERVER-ONLY (Admin/REST, CAS-guarded).
    // vehicles / inspections: the owning business may read its own; staff PIN sessions read through the server.
    match /vehicles/{id} { allow read: if isAuthenticated() && (resource.data.businessUid == request.auth.uid || ownerStaffCan(resource.data.businessUid, 'ORDERS')); allow write: if false; }
    match /inspections/{id} { allow read: if isAuthenticated() && (resource.data.businessUid == request.auth.uid || ownerStaffCan(resource.data.businessUid, 'ORDERS')); allow write: if false; }
    // eBay-lite auctions. Public read; sellers own; bidders may only push bid fields;
    // a Buy-It-Now buyer may settle (status/winner/finalPrice) and route fundraiser proceeds.
    match /garageSale/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'currentBidderId', 'currentBidderName', 'bidCount']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerId', 'winnerName', 'finalPrice', 'sanctuaryFundraiserLink']) && request.resource.data.winnerId == request.auth.uid)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sanctuaryFundraiserLink']));
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());

      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.bidderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }
    match /progress_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidProgressReport(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid && isValidProgressReport(request.resource.data));
    }
    // ── Post Man bulletins — a business's letters to its followers ──────────
    // Pull model: readers query bulletins by the authors they follow, so there is no
    // recipient list to leak or sell. Public to signed-in readers; only the author writes.
    match /bulletins/{bulletinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.doc is string && request.resource.data.doc.size() <= 700000 &&
        request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    match /newsroom_stories/{id} {
      allow read: if nrOwner(resource.data) || nrOrgStaff(resource.data);
      allow create: if nrCreate(request.resource.data);
      allow update: if (nrOwner(resource.data) || nrOrgStaff(resource.data)) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if nrOwner(resource.data) || nrOrgStaff(resource.data);
    }
    match /newsroom_pitches/{id} {
      allow read: if nrOwner(resource.data) || nrOrgStaff(resource.data);
      allow create: if nrCreate(request.resource.data);
      allow update: if (nrOwner(resource.data) || nrOrgStaff(resource.data)) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if nrOwner(resource.data) || nrOrgStaff(resource.data);
    }
    match /newsroom_claims/{id} {
      allow read, delete: if nrOwner(resource.data) || nrOrgStaff(resource.data);
      allow create: if nrCreate(request.resource.data);
      allow update: if (nrOwner(resource.data) || nrOrgStaff(resource.data)) && request.resource.data.ownerId == resource.data.ownerId;
    }
    match /periodicalIssues/{id} {
      allow read: if (resource.data.status == 'published' && resource.data.get('isPublic', false) == true)
        || piStaff(resource.data)
        || (isAuthenticated() && resource.data.get('adviserUid', '') == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('adviserApproval', null) == null
        && request.resource.data.status != 'published';
      allow update: if (
          piStaff(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('adviserApproval', null) == resource.data.get('adviserApproval', null)
          && request.resource.data.get('adviserUid', '') == resource.data.get('adviserUid', '')
          && request.resource.data.get('tier', 'pro') == resource.data.get('tier', 'pro')
          && (request.resource.data.status != 'published' || piAdviserOk(resource.data))
        ) || (
          isAuthenticated() && resource.data.get('adviserUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adviserApproval', 'updatedAt'])
          && (request.resource.data.adviserApproval == null || request.resource.data.adviserApproval.uid == request.auth.uid)
        );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid && resource.data.status != 'published';
    }
    // Press credentials: the owner submits them SELF_ASSERTED; only platform staff may approve or reject.
    match /press_credentials/{id} {
      allow read: if nrOwner(resource.data) || isAdmin();
      allow create: if nrOwner(request.resource.data) && request.resource.data.reviewStatus == 'SELF_ASSERTED';
      allow update: if isAdmin() || (nrOwner(resource.data) && request.resource.data.reviewStatus == resource.data.reviewStatus && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if nrOwner(resource.data) || isAdmin();
    }
    // Melos productions — album workspaces + the Beats room's grooves. Owner or roster member
    // only; every subcollection (songs, arrangements, pins, samples, grooves…) inherits access
    // through the parent production lookup. PRIVATE by default; collaborator sharing = the
    // memberUids roster maintained by melosService.
    match /melosProductions/{prodId} {
      function isMelosMember() {
        return isAuthenticated()
          && (resource.data.ownerUid == request.auth.uid
              || request.auth.uid in resource.data.get('memberUids', []));
      }
      allow read, update, delete: if isMelosMember() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      match /{document=**} {
        function isParentMember() {
          let p = get(/databases/$(database)/documents/melosProductions/$(prodId)).data;
          return isAuthenticated()
            && (p.ownerUid == request.auth.uid || request.auth.uid in p.get('memberUids', []));
        }
        allow read, write: if isParentMember() || isAdmin();
      }
    }
    // Sync-license requests: a filmmaker asks a track owner to license an un-priced
    // track. Requester creates & reads their own; owner reads & responds (status/price).
    match /licenseRequests/{reqId} {
      allow read: if isAuthenticated() &&
                     (resource.data.requesterUid == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterUid == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid
                       && request.resource.data.ownerUid == resource.data.ownerUid
                       && request.resource.data.requesterUid == resource.data.requesterUid;
      allow delete: if isAdmin();
    }
    match /ad_campaigns/{campaignId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidAdCampaign(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidAdCampaign(request.resource.data)) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }
    // "I need a hand": the student writes it for chosen grown-ups; only those grown-ups (and the student) can read it.
    match /wellbeingRequests/{rid} {
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || request.auth.uid in resource.data.toUids);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.toUids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']);
    }
    // ── Sacred Library: per-user Bible notes (doc id = {uid}__{ref}) ─────────────
    // Lectio service notes — the record of which passages a member was shown,
    // and when. One doc per user per service (id = {uid}__{sessionId}).
    // OWNER-ONLY IN BOTH DIRECTIONS: what someone was shown, and when they were
    // in a service, is a fact about their spiritual life. The church must never
    // be able to read this — it is the member's copy, and it leaves with them.
    match /lectioServiceNotes/{noteId} {
      allow read:   if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && noteId == request.auth.uid + '__' + request.resource.data.sessionId
                    && request.resource.data.notes is list
                    && request.resource.data.notes.size() <= 200;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    // ── Identifier registry (opt-in rights layer) ─────────────────────────────
    // Works, editions, releases and the subject→triple index. Public read: a rights
    // record is meant to be citable and checkable by anyone (that is the whole point of
    // a registry). Writes are owner-only, and ownerUid is immutable once set so a record
    // cannot be reassigned to another account.
    match /registryWorks/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /registryManifestations/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /registryProducts/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    // subjectKey (e.g. BOOK_abc123) → { workId, manifestationId, productId }. Never
    // deletable by a client: losing the index would orphan a work's whole rights record.
    match /registryRefs/{subjectKey} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    // Published scan reconstructions. Artwork vectors, editable OCR text and interaction fields
    // remain one document, but only its teacher and assigned family accounts may retrieve it.
    match /digital_worksheets/{worksheetId} {
      allow read: if canAccessDigitalWorksheet(resource.data);
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isAdmin()) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    // The answer key split off a published worksheet (services/worksheetKeys.ts): its teacher only.
    // Students check and turn in through routes/worksheetGrading.ts, which reads this server-side.
    match /digital_worksheet_keys/{worksheetId} {
      allow read, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if worksheetKeyWrite(worksheetId);
      allow update: if worksheetKeyWrite(worksheetId) && resource.data.createdBy == request.auth.uid;
    }
    match /worksheet_assignments/{assignmentId} {
      allow read: if canAccessWorksheetAssignment(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.teacherUid == request.auth.uid &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow update: if isAuthenticated() &&
        (resource.data.teacherUid == request.auth.uid || isAdmin()) &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.worksheetId == resource.data.worksheetId;
      allow delete: if isAuthenticated() && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }
    match /worksheet_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        request.auth.uid in resource.data.get('guardianUids', []) ||
        (resource.data.assignmentId is string &&
          worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.assignmentId is string && (
        (request.resource.data.studentId == request.auth.uid && !request.resource.data.keys().hasAny(worksheetGradeFields())) ||
        worksheetAssignment(request.resource.data.assignmentId).teacherUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.worksheetId == resource.data.worksheetId &&
        request.resource.data.assignmentId == resource.data.assignmentId && (
          worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid ||
          isAdmin() ||
          (resource.data.studentId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(worksheetGradeFields()))
        );
      allow delete: if isAuthenticated() && (
        worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid || isAdmin()
      );
    }
    // Runtime failures and user ratings are append-only evidence. Actors may write only as
    // themselves and only for worksheets already inside their access boundary.
    match /assignment_quality_events/{eventId} {
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }
    match /assignment_quality_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }
    match /assignment_quality/{qualityId} {
      allow read: if canAccessWorksheetById(resource.data.worksheetId);
      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/digital_worksheets/$(request.resource.data.worksheetId)).data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.worksheetId == resource.data.worksheetId &&
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid;
      allow delete: if false;
    }
    // The teacher's own integrity configuration: personas + Silent Mode settings.
    // Silent Mode may never be switched off while a verified district persona is active —
    // enforced here rather than only in the UI, because the UI is the part an attacker skips.
    match /teacherIntegrity/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Traversed with .get() defaults throughout: a teacher who hasn't linked a district has
      // no personas.district map at all, and a bare `resource.data.personas.district.active`
      // raises on the missing key — which denies the write. That would lock every teacher
      // WITHOUT a district out of their own settings, the exact opposite of the intent.
      allow update: if isOwner(uid) &&
        !(resource.data.get('personas', {}).get('district', {}).get('active', false) == true &&
          request.resource.data.get('integritySettings', {}).get('campusSilentMode', 'auto') == 'off');
      allow delete: if false;
    }
    // District-persona rosters. SALTED HASHES ONLY — raw student identity never reaches
    // Plajah. Readable by the owning teacher and their district admin; by no one else, and by
    // no creator-context path at all. Deletable by the teacher so leaving a district actually
    // removes the data.
    match /districtPersona/{uid}/rosters/{termId} {
      allow read: if isOwner(uid) ||
        (isAuthenticated() && request.auth.token.districtAdmin == resource.data.districtId);
      allow create, update: if isOwner(uid) ||
        (isAuthenticated() && request.auth.token.districtAdmin == request.resource.data.districtId);
      allow delete: if isOwner(uid);
    }
    // Assignment templates. The licence wall: a template may only claim commercialUse if the
    // server has already validated its materials. licenseValidated is server-set (Admin REST),
    // so a client cannot forge its way past the gate — it can only ever write the flag false.
    match /assignmentTemplates/{templateId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerUid);

      // A new template is always unvalidated and non-commercial. Validation is something the
      // server grants afterwards; it is never a property a document can be born with.
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.licenseValidated == false &&
        request.resource.data.commercialUse == false;

      // The client may LOWER licenseValidated (editing materials invalidates prior approval)
      // but never raise it — writing `true` is the one transition reserved for the server's
      // Admin REST path, which bypasses these rules. Without this clause a client could simply
      // set the flag itself and walk straight through the commercial gate.
      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (request.resource.data.licenseValidated == false ||
         request.resource.data.licenseValidated == resource.data.licenseValidated) &&
        (request.resource.data.commercialUse == false ||
         request.resource.data.licenseValidated == true);

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
    // A template handed to a class. Readable by the assigning teacher and by the students it
    // was assigned to — students need it to actually do the work, but must never be able to
    // edit the rubric they're about to be graded against.
    match /templateAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.studentIds ||
        request.auth.uid in resource.data.get('guardianUids', [])
      );
      allow create: if isAuthenticated() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }
    // A student's turned-in work. The student owns the submission; the teacher owns the grade.
    match /templateSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.get('guardianUids', [])
      );
      // Turning in must arrive ungraded — otherwise a student could submit with a grade
      // already attached and the ledger would credit mastery nobody assessed.
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.grade == null &&
        // A Student Newsroom story's editorial decision (`review`) is the teacher's alone:
        // it is what lets a young reporter's story leave the classroom.
        request.resource.data.get('review', null) == null;
      // Only the teacher grades. A student may still edit their own work, but may never
      // touch the grade or review fields — hence the two separate, non-overlapping update paths.
      allow update: if isAuthenticated() && (
        (resource.data.teacherUid == request.auth.uid) ||
        (resource.data.studentId == request.auth.uid &&
         resource.data.status != 'graded' &&
         request.resource.data.grade == resource.data.grade &&
         request.resource.data.get('review', null) == resource.data.get('review', null) &&
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }
    match /templateLibrary/{templateId} {
      allow read: if tplReadable(resource.data);
      allow create: if isAuthenticated() && tplValid(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid && tplValid(request.resource.data))
        || (tplReadable(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
            && request.resource.data.uses == resource.data.get('uses', 0) + 1)
      );
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    // Scheduled posts: only the author reads/creates/cancels. The payload is published by the
    // author's client (or a future server job using the Admin SDK, which bypasses rules).
    // Reply audience / canReply is UI-level only: comment rules are intentionally unchanged.
    match /scheduled_posts/{id} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow create: if isRegisteredUser() && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.post is map
                    && request.resource.data.publishAt is number
                    && request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
  }
}

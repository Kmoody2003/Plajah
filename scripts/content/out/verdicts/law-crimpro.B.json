 "claims": [
  {
   "lessonId": "law-crimpro.l01",
   "claim": "United States v. Jones (2012): attaching a GPS tracker to a car was a search under the property-based (physical intrusion) test",
   "verdict": "supported",
   "sources": [
    "https://supreme.justia.com/cases/federal/us/565/400/"
   ],
   "note": ""
  },
  {
   "lessonId": "law-crimpro.l01",
   "claim": "Kyllo v. United States (2001): thermal imaging of a home with technology not in general public use is a search",
   "verdict": "supported",
   "sources": [
    "https://supreme.justia.com/cases/federal/us/533/27/"
   ],
   "note": ""
  },
  {
   "lessonId": "law-crimpro.l01",
   "claim": "Carpenter (2018) held acquiring historical CSLI (seven days) is a search, called its holding narrow, and lower courts continue to sort out tower dumps, real-time location and similar data",
   "verdict": "contradicted",
   "sources": [
    "https://supreme.justia.com/cases/federal/us/585/16-402/",
    "https://supreme.justia.com/cases/federal/us/609/25-112/"
   ],
   "note": "Carpenter itself is accurately described (it held accessing seven days of CSLI is a search and reserved shorter periods), but the lesson is now out of date: Chatrie v. United States (decided June 29, 2026) held that acquiring a person's Google Location History via a geofence warrant is a Fourth Amendment search, even for a limited time and from a third-party tech company, and remanded on particularity/probable cause. Add Chatrie and stop implying seven days is a threshold."
  },
  {

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegisteredUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // PLATFORM admin = the owner and designated staff ONLY. Org / business / school admins
    // (organizations/{id}.admins, orgMemberships, business staff roles …) are separate and
    // never make someone a platform admin.
    // Trusted sources: the admins/{uid} collection (no client rule → console / service account
    // only) and the owner's VERIFIED sign-in email. Deliberately NOT users/{uid}.role — an owner
    // can write their own profile, so reading it here let any signed-in user make themselves admin.
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kmoody2003@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Profile fields that carry platform privilege. Never settable or changeable by the account owner.
    function noPlatformPrivilegeGrab(newData) {
      return newData.get('role', 'user') == 'user' && newData.get('isAdmin', false) == false;
    }
    function platformPrivilegeUnchanged(newData, oldData) {
      return newData.get('role', null) == oldData.get('role', null)
          && newData.get('isAdmin', null) == oldData.get('isAdmin', null);
    }

    function canAccessDigitalWorksheet(data) {
      return isAuthenticated() && (
        data.createdBy == request.auth.uid ||
        request.auth.uid in data.get('accessUids', []) ||
        isAdmin()
      );
    }

    function worksheetAssignment(assignmentId) {
      return get(/databases/$(database)/documents/worksheet_assignments/$(assignmentId)).data;
    }

    function canAccessWorksheetAssignment(data) {
      return isAuthenticated() && (
        data.teacherUid == request.auth.uid ||
        request.auth.uid in data.get('studentIds', []) ||
        isAdmin()
      );
    }

    function canAccessWorksheetById(worksheetId) {
      return exists(/databases/$(database)/documents/digital_worksheets/$(worksheetId)) &&
        canAccessDigitalWorksheet(get(/databases/$(database)/documents/digital_worksheets/$(worksheetId)).data);
    }

    function productionById(prodId) {
      return get(/databases/$(database)/documents/productions/$(prodId)).data;
    }

    function isProductionMemberById(prodId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/productions/$(prodId)) &&
        productionById(prodId).get('isShowcase', false) != true && (
        productionById(prodId).ownerUid == request.auth.uid ||
        (productionById(prodId).memberUids is list && request.auth.uid in productionById(prodId).memberUids)
      );
    }

    function canManageProductionChatById(prodId) {
      let p = productionById(prodId);
      return isAuthenticated() && exists(/databases/$(database)/documents/productions/$(prodId)) &&
        p.get('isShowcase', false) != true && (
        p.ownerUid == request.auth.uid ||
        (p.authority is map && request.auth.uid in p.authority &&
         p.authority[request.auth.uid].permissions is list &&
         (('MANAGE_ROSTER' in p.authority[request.auth.uid].permissions) || ('MANAGE_SCHEDULE' in p.authority[request.auth.uid].permissions)))
      );
    }

    function canPostProductionChat(room) {
      return room.get('workspaceType', '') == 'PRODUCTION' &&
        room.get('productionId', '') is string &&
        isProductionMemberById(room.productionId) &&
        (room.get('postingPolicy', 'ALL_MEMBERS') == 'ALL_MEMBERS' || canManageProductionChatById(room.productionId));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function canAccessHqScope(data) {
      return isAuthenticated() && (
        (data.scopeKind == 'user' && data.scopeId == request.auth.uid) ||
        (data.scopeKind == 'org' && exists(/databases/$(database)/documents/organizations/$(data.scopeId)) && (
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.admins ||
          get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.creatorId == request.auth.uid ||
          // Staff/moderators holding MANAGE_CONTENT (denormalized on the org by
          // organizationService.recomputeOrgStaffUids). Only owners/admins can write that array.
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.get('staffUids', [])
        )) || isAdmin()
      );
    }

    function canAccessHqAsset(assetId) {
      return exists(/databases/$(database)/documents/orgAssets/$(assetId)) &&
        canAccessHqScope(get(/databases/$(database)/documents/orgAssets/$(assetId)).data);
    }

    match /sports_ingestion_runs/{docId} {
      allow read, write: if isAdmin();
    }

    // Chora transcode manifests (status + AAC-HLS / progressive / FLAC rendition URLs). The player
    // reads these to prefer a small, hardware-decodable stream over the raw WAV master — the whole
    // point of the transcode pipeline. WITHOUT a read rule the collection defaulted to deny, so
    // getTrackStream() silently caught permission-denied and fell back to WAV, and every transcode
    // was invisible to playback. Public read (the rendition URLs are already served openly via
    // /api/chora/media); only the server (service account, rules-exempt) writes them.
    match /choraStreams/{trackId} {
      allow read: if true;
      allow write: if false;
    }
    match /choraPrivateStreams/{trackId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /sports_game_event_research/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_source_registry/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Plajah platform media library — bumpers, idents, house ads, TV-open + Taleo pre-roll.
    // Public read (every broadcast/app pulls branding); admin-only write.
    match /platform_media/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dossier "Experiences" — the platform-admin-only asset area for the Dossier films on Mux.
    // experiences/{id}: the full record (Mux asset id, source file, hash, status). Platform admins ONLY, read and write.
    // Visitors never read this collection.
    match /experiences/{expId} {
      allow read, write: if isAdmin();
    }
    // experienceFilms/{exhibitId}: the minimal playback doc the Dossier hall reads so ANY visitor (signed in or not)
    // can watch an exhibit film from Mux. Public read; only a platform admin can write, and only this exact shape:
    // a public Mux playback id plus display fields. The film is SOURCED FROM a public Reello video: reelloVideoId names
    // it and muxPlaybackId is copied from it (so visitors never need to read videos/). The admin tools only write this
    // doc while that Reello video is public, and remove it when the video goes private or is deleted.
    // Deleting it sends the hall back to the live canvas film.
    match /experienceFilms/{exhibitId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['exhibitId', 'experienceId', 'reelloVideoId', 'title', 'muxPlaybackId', 'playbackPolicy', 'durationSec', 'width', 'height', 'captionsUrl', 'updatedAt'])
        && request.resource.data.keys().hasAll(['exhibitId', 'experienceId', 'reelloVideoId', 'title', 'muxPlaybackId', 'playbackPolicy', 'durationSec', 'updatedAt'])
        && request.resource.data.exhibitId == exhibitId
        && request.resource.data.reelloVideoId is string
        && request.resource.data.reelloVideoId.size() > 0 && request.resource.data.reelloVideoId.size() < 200
        && request.resource.data.playbackPolicy == 'public'
        && request.resource.data.muxPlaybackId is string
        && request.resource.data.muxPlaybackId.size() >= 8 && request.resource.data.muxPlaybackId.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() < 200
        && request.resource.data.durationSec is number && request.resource.data.durationSec > 0
        && (!('captionsUrl' in request.resource.data) || (request.resource.data.captionsUrl is string && request.resource.data.captionsUrl.size() < 1000));
      allow delete: if isAdmin();
    }

    match /sports_league_teams/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_league_news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_league_scores/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_league_standings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_league_leaders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_team_pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_team_rosters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_team_schedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_player_profiles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_player_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_team_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports_wikipedia_summaries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidAlbum(data) {
      return hasRequiredFields(['id', 'title', 'artist', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() < 200 &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() < 2000)) &&
             (!('tracks' in data) || (data.tracks is list && data.tracks.size() <= 100)) &&
             data.createdAt is number &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isPrivate' in data) || data.isPrivate is bool) &&
             (!('isScheduled' in data) || data.isScheduled is bool) &&
             (!('releaseDate' in data) || data.releaseDate is number) &&
             (!('galleryUrl' in data) || (data.galleryUrl is string && data.galleryUrl.size() < 2000)) &&
             (!('liveFeedUrl' in data) || (data.liveFeedUrl is string && data.liveFeedUrl.size() < 2000)) &&
             (!('socialLinks' in data) || (data.socialLinks is map)) &&
             (!('musicVideos' in data) || (data.musicVideos is list)) &&
             (!('bookChapters' in data) || (data.bookChapters is list)) &&
             (!('type' in data) || (data.type in ['MUSIC', 'VIDEO', 'BOOK', 'PHOTO'])) &&
             (!('price' in data) || (data.price is number)) &&
             (!('isPaywalled' in data) || (data.isPaywalled is bool)) &&
             (!('donationGoal' in data) || (data.donationGoal is number)) &&
             (!('donationCurrent' in data) || (data.donationCurrent is number)) &&
             (!('isGlobalArchive' in data) || (data.isGlobalArchive is bool));
    }

    function isValidLiveFeed(data) {
      return hasRequiredFields(['ownerId', 'ownerName', 'ownerPhoto', 'title', 'url', 'timestamp']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.url is string && data.url.size() < 2000;
    }

    function isValidUserProfile(data) {
      return hasRequiredFields(['uid', 'displayName', 'photoURL', 'email']) &&
             data.uid is string && data.displayName is string && data.photoURL is string && data.email is string &&
             (!('acceptsTips' in data) || (data.acceptsTips is bool)) &&
             (!('tipGoal' in data) || (data.tipGoal is number)) &&
             (!('tipCurrent' in data) || (data.tipCurrent is number)) &&
             (!('payItForwardOptIn' in data) || (data.payItForwardOptIn is bool)) &&
             (!('payItForwardWinsMonth' in data) || (data.payItForwardWinsMonth is number)) &&
             (!('payItForwardWinsYear' in data) || (data.payItForwardWinsYear is number)) &&
             (!('lastPayItForwardWinTimestamp' in data) || (data.lastPayItForwardWinTimestamp is number)) &&
             (!('liveStreamConfig' in data) || (data.liveStreamConfig is map)) &&
             (!('safetySettings' in data) || (data.safetySettings is map)) &&
             (!('mailingListCount' in data) || (data.mailingListCount is number)) &&
             (!('xHandle' in data) || (data.xHandle is string && data.xHandle.size() < 100)) &&
             (!('xUrl' in data) || (data.xUrl is string && data.xUrl.size() < 500)) &&
             (!('xEmbedHtml' in data) || (data.xEmbedHtml is string && data.xEmbedHtml.size() < 10000));
    }

    function isValidMailingListSubscriber(data) {
      return hasRequiredFields(['id', 'artistId', 'subscriberId', 'subscriberEmail', 'subscriberName', 'timestamp']) &&
             data.artistId is string &&
             data.subscriberId is string &&
             data.subscriberEmail is string &&
             data.subscriberName is string &&
             data.timestamp is number;
    }

    function isValidNewsletter(data) {
      return hasRequiredFields(['id', 'artistId', 'title', 'content', 'timestamp', 'sentCount']) &&
             data.artistId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.timestamp is number &&
             data.sentCount is number;
    }

    function isValidPayItForwardDonation(data) {
      return hasRequiredFields(['amount', 'donorId', 'timestamp']) &&
             data.amount is number && data.amount > 0 &&
             data.donorId is string &&
             data.timestamp is number;
    }

    function isValidPayItForwardWinner(data) {
      return hasRequiredFields(['uid', 'amount', 'timestamp', 'status']) &&
             data.uid is string &&
             data.amount is number &&
             data.timestamp is number &&
             data.status in ['PENDING', 'CLAIMED', 'PASSED'];
    }

    function isValidMerchItem(data) {
      return hasRequiredFields(['artistId', 'title', 'description', 'price', 'imageUrl', 'category']) &&
             data.artistId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.description is string && data.description.size() < 1000 &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string && data.imageUrl.size() < 2000 &&
             data.category in ['APPAREL', 'MUSIC', 'ACCESSORY', 'DIGITAL'] &&
             (!('stock' in data) || (data.stock is number));
    }

    function isValidDonation(data) {
      return hasRequiredFields(['fromId', 'fromName', 'toId', 'amount', 'timestamp']) &&
             data.fromId is string &&
             data.fromName is string &&
             data.toId is string &&
             data.amount is number && data.amount > 0 &&
             (!('albumId' in data) || (data.albumId is string)) &&
             (!('message' in data) || (data.message is string && data.message.size() < 500));
    }

    function isValidFeedItem(data) {
      return hasRequiredFields(['authorId', 'authorName', 'authorPhoto', 'type', 'content', 'timestamp']) &&
             data.type in ['PICTURE', 'SONG', 'COMMENT', 'VIDEO', 'BOOK', 'NEWS', 'GAME', 'WATCH_ALONG', 'LIVE_FEED', 'RESEARCH_PAPER'];
    }

    function isValidPostComment(data) {
      return hasRequiredFields(['author', 'text', 'timestamp']) &&
             data.author is string && data.author.size() > 0 && data.author.size() < 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000 &&
             data.timestamp is number &&
             (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('parentId' in data) || data.parentId is string || data.parentId == null);
    }

    function isValidComment(data) {
      return hasRequiredFields(['author', 'text', 'timestamp']) &&
             (hasRequiredFields(['trackId']) || hasRequiredFields(['videoId'])) &&
             data.author is string && data.author.size() > 0 && data.author.size() < 100 &&
             data.text is string && data.text.size() < 1000 &&
             // Allow an empty-text comment when it carries media (e.g. a GIF-only
             // reply) — otherwise the GIF write is rejected and the comment vanishes.
             (data.text.size() > 0
               || ('gifUrl' in data && data.gifUrl is string && data.gifUrl.size() > 0)
               || ('imageUrl' in data && data.imageUrl is string && data.imageUrl.size() > 0)) &&
             data.timestamp is number &&
             (!('trackId' in data) || data.trackId is string) &&
             (!('videoId' in data) || data.videoId is string) &&
             (!('gifUrl' in data) || (data.gifUrl is string && data.gifUrl.size() < 2000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000));
    }

    function isValidPhoto(data) {
      return hasRequiredFields(['ownerId', 'url', 'timestamp']) &&
             data.ownerId is string &&
             data.url is string && data.url.size() < 2000;
    }

    function isValidTVChannel(data) {
      return hasRequiredFields(['ownerId', 'ownerName', 'title', 'isLive']) &&
             data.ownerId is string &&
             data.ownerName is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200;
    }

    function isValidGame(data) {
      return hasRequiredFields(['title', 'url', 'thumbnailUrl', 'playCount', 'timestamp']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.url is string && data.url.size() < 2000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() < 2000 &&
             data.playCount is number;
    }

    function isValidPPVEvent(data) {
      return hasRequiredFields(['id', 'ownerId', 'ownerName', 'title', 'description', 'thumbnailUrl', 'streamUrl', 'price', 'isExclusive', 'startTime', 'duration', 'status']) &&
             data.ownerId is string &&
             data.title is string && data.title.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.isExclusive is bool &&
             data.startTime is number &&
             data.status in ['UPCOMING', 'LIVE', 'ENDED'];
    }

    function isValidClassroom(data) {
      return hasRequiredFields(['id', 'ownerId', 'ownerName', 'title', 'description', 'thumbnailUrl', 'price', 'syllabus', 'lessons', 'assignments', 'enrolledStudents', 'category']) &&
             data.ownerId is string &&
             data.title is string && data.title.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.lessons is list &&
             data.assignments is list &&
             data.enrolledStudents is list;
    }

    function isValidClassroomModule(data) {
      return hasRequiredFields(['id', 'name', 'description', 'url', 'coverArt', 'createdAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.url is string && data.url.size() > 0 &&
             data.description is string &&
             data.coverArt is string &&
             data.createdAt is number;
    }

    function isValidSubmission(data) {
      return hasRequiredFields(['id', 'assignmentId', 'studentId', 'studentName', 'timestamp']) &&
             data.assignmentId is string &&
             data.studentId is string &&
             data.timestamp is number;
    }

    function isValidProgressReport(data) {
      return hasRequiredFields(['id', 'classId', 'studentId', 'overallGrade', 'completedLessons', 'lastAccessed']) &&
             data.classId is string &&
             data.studentId is string &&
             data.overallGrade is number &&
             data.completedLessons is list &&
             data.lastAccessed is number;
    }

    function isValidVideoChatSession(data) {
      return hasRequiredFields(['id', 'roomId', 'participants', 'startTime', 'isActive']) &&
             data.roomId is string &&
             data.participants is list &&
             data.startTime is number &&
             data.isActive is bool;
    }

    function isValidPost(data) {
      return hasRequiredFields(['authorId', 'authorName', 'authorPhoto', 'text', 'timestamp']) &&
             data.text is string && data.text.size() < 5000 &&
             (!('media' in data) || data.media is list) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('modifiedAt' in data) || data.modifiedAt is number);
    }

    function isValidVideo(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'url', 'timestamp']) &&
             data.id is string && data.ownerId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.url is string && data.url.size() < 2000 &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('likesCount' in data) || (data.likesCount is number)) &&
             (!('commentsCount' in data) || (data.commentsCount is number));
    }

    function isValidVideoComment(data) {
      return hasRequiredFields(['id', 'videoId', 'userId', 'userName', 'userPhoto', 'text', 'timestamp']) &&
             data.text is string && data.text.size() < 2000 &&
             (data.text.size() > 0 || (('gifUrl' in data) && data.gifUrl is string && data.gifUrl.size() > 0)) &&
             (!('gifUrl' in data) || (data.gifUrl is string && data.gifUrl.size() < 2000)) &&
             (!('parentId' in data) || (data.parentId is string)) &&
             (!('mediaTimestamp' in data) || (data.mediaTimestamp is number));
    }

    function isValidVideoPlaylist(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'videoIds', 'timestamp']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.videoIds is list && data.videoIds.size() <= 500;
    }

    function isValidArticle(data) {
      return hasRequiredFields(['id', 'authorId', 'title', 'blocks', 'timestamp']) &&
             data.id is string && data.authorId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.blocks is list && data.blocks.size() <= 100 &&
             data.timestamp is number &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number);
    }

    function isValidBrandAccount(data) {
      return hasRequiredFields(['id', 'name', 'adminId', 'timestamp']) &&
             data.id is string && data.name is string && data.adminId is string &&
             data.timestamp is number &&
             (!('managers' in data) || data.managers is list) &&
             (!('brandPages' in data) || data.brandPages is list) &&
             (!('managedArtistIds' in data) || data.managedArtistIds is list);
    }

    function isValidFanPage(data) {
      return hasRequiredFields(['id', 'ownerId', 'name', 'timestamp']) &&
             data.id is string && data.ownerId is string && data.name is string &&
             data.timestamp is number &&
             (!('description' in data) || data.description is string) &&
             (!('members' in data) || data.members is list);
    }

    function isValidAdConfig(data) {
      return hasRequiredFields(['id', 'title', 'imageUrl', 'linkUrl', 'placement', 'isActive', 'impressions', 'clicks']) &&
             data.id is string && data.title is string && data.imageUrl is string && data.linkUrl is string &&
             data.placement in ['SIDEBAR', 'FEED', 'PLAYER', 'BANNER'] &&
             data.isActive is bool && data.impressions is number && data.clicks is number;
    }

    function isValidAdCampaign(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'type', 'targetType', 'imageUrl', 'budget', 'frequency', 'probability', 'isActive', 'timestamp']) &&
             data.id is string && data.ownerId is string && data.title is string &&
             data.type in ['USER_PROMOTION', 'PARTNER', 'THIRD_PARTY'] &&
             data.targetType in ['POST', 'ALBUM', 'PROFILE', 'EXTERNAL'] &&
             data.imageUrl is string && data.budget is number && data.frequency is number &&
             data.probability is number && data.isActive is bool && data.timestamp is number;
    }

    function isValidPersonalTrack(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'artist', 'url', 'timestamp']) &&
             data.id is string && data.ownerId is string && data.title is string &&
             data.artist is string && data.url is string && data.timestamp is number;
    }

    function isValidPersonalAlbum(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'artist', 'coverImage', 'tracks', 'createdAt']) &&
             data.id is string && data.ownerId is string && data.title is string &&
             data.artist is string && data.coverImage is string && data.tracks is list &&
             data.createdAt is number;
    }

    function isValidPersonalPlaylist(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'trackIds', 'timestamp']) &&
             data.id is string && data.ownerId is string && data.title is string &&
             data.trackIds is list && data.timestamp is number;
    }

    function isValidPostThemeBackground(data) {
      return hasRequiredFields(['id', 'name', 'theme', 'imageUrl', 'zones', 'createdAt']) &&
             data.id is string && data.name is string && data.name.size() < 200 &&
             data.theme in ['SCRAPBOOK', 'PHOTO_ALBUM', 'MUSIC_PLAYER', 'NEWSPAPER', 'ARCADE'] &&
             data.imageUrl is string && data.imageUrl.size() < 2000 &&
             data.zones is list && data.zones.size() <= 50 &&
             data.createdAt is number;
    }

    function isValidWorld(data) {
      return hasRequiredFields(['id', 'name', 'creatorId', 'createdAt']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.creatorId is string &&
             data.createdAt is number;
    }

    function isValidCharacter(data) {
      return hasRequiredFields(['id', 'worldId', 'name']) &&
             data.id is string && data.worldId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 10000)) &&
             (!('role' in data) || (data.role is string && data.role.size() < 200)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000)) &&
             (!('stats' in data) || (data.stats is map)) &&
             (!('tags' in data) || (data.tags is list)) &&
             (!('isPublished' in data) || (data.isPublished is bool));
    }

    function isValidLoreEntry(data) {
      return hasRequiredFields(['id', 'worldId', 'title', 'content']) &&
             data.id is string && data.worldId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.content is string && data.content.size() < 50000 &&
             (!('type' in data) || (data.type is string)) &&
             (!('isPublished' in data) || data.isPublished is bool);
    }

    function isValidTimeline(data) {
      return hasRequiredFields(['id', 'worldId', 'name', 'createdAt']) &&
             data.id is string &&
             data.worldId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.createdAt is number &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             (!('color' in data) || (data.color is string && data.color.size() < 50));
    }

    function isValidTimelineEvent(data) {
      return hasRequiredFields(['id', 'worldId', 'timelineId', 'title', 'year']) &&
             data.id is string &&
             data.worldId is string &&
             data.timelineId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.year is number &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             (!('isPublished' in data) || data.isPublished is bool) &&
             (!('linkedCharacterIds' in data) || data.linkedCharacterIds is list) &&
             (!('linkedLoreIds' in data) || data.linkedLoreIds is list) &&
             (!('linkedAssetIds' in data) || data.linkedAssetIds is list);
    }

    function isValidUniverse(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.type in ['ON_PLATFORM', 'ALLY'] &&
             (!('url' in data) || data.url is string) &&
             (!('coverImage' in data) || data.coverImage is string) &&
             data.description is string &&
             data.createdAt is number;
    }

    function isValidWebApp(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'url', 'thumbnailUrl', 'timestamp']) &&
             data.id is string && data.ownerId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.url is string && data.url.size() < 2000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() < 2000 &&
             data.timestamp is number &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             (!('category' in data) || (data.category is string)) &&
             (!('version' in data) || (data.version is string)) &&
             (!('size' in data) || (data.size is string)) &&
             (!('rating' in data) || (data.rating is number)) &&
             (!('reviewCount' in data) || (data.reviewCount is number)) &&
             (!('installCount' in data) || (data.installCount is number)) &&
             (!('isGlobalArchive' in data) || (data.isGlobalArchive is bool));
    }

    function isValidNotification(data) {
      return hasRequiredFields(['userId', 'senderId', 'senderName', 'type', 'title', 'message', 'isRead', 'timestamp']) &&
             data.userId is string && data.senderId is string &&
             data.type in ["MESSAGE", "COMMENT", "CONTENT", "SYSTEM", "LIKE", "FOLLOW", "HELLO"] &&
             data.title is string && data.title.size() < 200 &&
             data.message is string && data.message.size() < 1000 &&
             data.isRead is bool;
    }

    function isValidReview(data) {
      return hasRequiredFields(['id', 'productId', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'timestamp']) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 2000;
    }

    function isValidPhotoAlbum(data) {
      return hasRequiredFields(['id', 'ownerId', 'title', 'photoIds', 'timestamp']) &&
             data.id is string && data.ownerId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.photoIds is list && data.photoIds.size() <= 1000 &&
             data.timestamp is number;
    }

    function isValidChatRoom(data) {
      return hasRequiredFields(['participants', 'type', 'updatedAt']) &&
             data.participants is list && data.participants.size() <= 1000 &&
             data.type in ['PRIVATE', 'GROUP', 'PUBLIC_LIVE', 'CLASSROOM'] &&
             data.updatedAt is number &&
             (!('name' in data) || (data.name is string && data.name.size() < 200)) &&
             (!('ownerId' in data) || data.ownerId is string) &&
             (!('classId' in data) || (data.classId is string && data.classId.size() < 200)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() < 1000)) &&
             (!('typingUsers' in data) || (data.typingUsers is list && data.typingUsers.size() <= 100));
    }

    // ── Education DM policy (mirror of services/educationChat.ts canDM) ─────────
    // A student/child may only DM their teachers and guardians; students can never
    // DM other students or arbitrary adults. Adults DM freely. Enforced on create.
    function eduUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function isStudentUid(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) && (
        eduUser(uid).get('isChild', false) == true ||
        eduUser(uid).get('accountType', '') in ['CHILD', 'STUDENT'] ||
        eduUser(uid).get('childState', '') == 'SCHOOL_PROVISIONED'
      );
    }
    function isTeacherUid(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) && (
        eduUser(uid).get('accountType', '') == 'TEACHER' ||
        eduUser(uid).get('isTeacher', false) == true ||
        eduUser(uid).get('teacherVerification', 'UNVERIFIED') != 'UNVERIFIED'
      );
    }
    function isGuardianUidOf(adultUid, studentUid) {
      return exists(/databases/$(database)/documents/users/$(studentUid)) && (
        eduUser(studentUid).get('guardianUid', '') == adultUid ||
        adultUid in eduUser(studentUid).get('coGuardianUids', []) ||
        (exists(/databases/$(database)/documents/users/$(adultUid)) &&
         studentUid in eduUser(adultUid).get('childUids', []))
      );
    }
    // For a 2-person PRIVATE room: allow iff not student-involving, or the one adult
    // is the student's teacher/guardian. Two students, or student↔stranger, are denied.
    // True for a 1:1 PRIVATE room whose two participants have a block between them (either direction).
    // Short-circuits on room type, so group/live rooms pay no extra reads.
    function dmRoomBlocked(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.get('type', '') == 'PRIVATE'
             && get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants.size() == 2
             && isBlockedPair(get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants[0],
                              get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants[1]);
    }

    function dmPairAllowed(p) {
      return (!isStudentUid(p[0]) && !isStudentUid(p[1]))
        ? true
        : ((isStudentUid(p[0]) && isStudentUid(p[1]))
            ? false
            : (isStudentUid(p[0])
                ? (isTeacherUid(p[1]) || isGuardianUidOf(p[1], p[0]))
                : (isTeacherUid(p[0]) || isGuardianUidOf(p[0], p[1]))));
    }

    function isValidLiveTalk(data) {
      return hasRequiredFields(['id', 'hostId', 'title', 'isActive', 'timestamp']) &&
             data.id is string && data.hostId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             (!('topic' in data) || (data.topic is string && data.topic.size() < 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
             data.isActive is bool &&
             (!('speakers' in data) || data.speakers is list) &&
             (!('listeners' in data) || data.listeners is list) &&
             (!('sharedAssets' in data) || data.sharedAssets is list);
    }

    function isValidChatMessage(data) {
      return hasRequiredFields(['senderId', 'senderName', 'timestamp', 'type']) &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() < 100 &&
             data.timestamp is number &&
             data.type in ['TEXT', 'MEDIA', 'VOICE', 'SYSTEM', 'ACTION', 'IMAGE', 'VIDEO_NOTE'] &&
             (!('text' in data) || (data.text is string && data.text.size() < 5000)) &&
             (!('mediaId' in data) || data.mediaId is string) &&
             (!('voiceUrl' in data) || data.voiceUrl is string) &&
             (!('seenBy' in data) || (data.seenBy is list && data.seenBy.size() <= 1000)) &&
             (!('threadRootId' in data) || (data.threadRootId is string && data.threadRootId.size() > 0 && data.threadRootId.size() < 200)) &&
             (!('mentionUids' in data) || (data.mentionUids is list && data.mentionUids.size() <= 100)) &&
             (!('productionEntity' in data) || (
               data.productionEntity is map &&
               data.productionEntity.productionId is string && data.productionEntity.productionId.size() > 0 &&
               data.productionEntity.entityId is string && data.productionEntity.entityId.size() > 0 &&
               (!('actionId' in data.productionEntity) || data.productionEntity.actionId is string) &&
               data.productionEntity.entityType in ['TASK', 'SCENE', 'BREAKDOWN', 'CALL_SHEET', 'SCHEDULE', 'DECISION', 'ALERT', 'MEMBER', 'LOCATION']
             ));
    }

    function isValidThemePreset(data) {
      return hasRequiredFields(['id', 'creatorId', 'title', 'description', 'mode', 'assets', 'isPublic', 'timestamp']) &&
             data.id is string &&
             data.creatorId is string &&
             data.title is string &&
             data.description is string &&
             data.mode in ['PHOTO_ONLY', 'VIDEO_ONLY', 'MIX'] &&
             data.assets is list &&
             data.isPublic is bool &&
             data.timestamp is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /themePresets/{presetId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidThemePreset(request.resource.data) && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    match /liveTalks/{talkId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidLiveTalk(request.resource.data) && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.hostId == request.auth.uid && isValidLiveTalk(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listeners', 'speakers']) && 
         (request.auth.uid in request.resource.data.listeners || request.auth.uid in request.resource.data.speakers || request.auth.uid == resource.data.hostId)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedAssets']) && 
         (resource.data.hostId == request.auth.uid || request.auth.uid in resource.data.speakers)) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    match /systemConfig/{configId} {
      // landingBg and settings are public — guests need settings to load Chora/Reello/Taleo
      allow read: if configId == 'landingBg' || configId == 'settings' || isAuthenticated();
      allow write: if isAdmin();
    }

    // Feature flags (config/featureFlags) — every client reads them to gate features
    // (e.g. CONTENT_LICENSING, Web3); only admins may toggle. Without this rule the
    // write was default-denied, so the admin toggle reverted immediately.
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Plajah Billing — invoices / estimates / payment links / customers / price book.
    // Every doc carries entityKey = "KIND:id" (USER|ORG|BUSINESS|PRODUCTION). billingAdminOf mirrors
    // the server's resolveBillingEntity(): USER id==uid; BUSINESS id==owner uid; ORG creator/admins/
    // financeUids/accountingUids/pastorUids; PRODUCTION owner or an authority entry holding MANAGE_BUDGET.
    // Platform flags live in config/billingFlags (readable by everyone via the config rule above — they
    // are non-sensitive switches; writes are admin-only by the same rule).
    // billingInvoices are SERVER-WRITE ONLY: numbers, totals and Stripe ids are server-computed
    // (drafts are saved via POST /api/billing/invoices/save).
    // ===============================================================
    function billKind(k) { return k.split(':')[0]; }
    function billId(k) { return k.split(':')[1]; }
    function billProdAdmin(prodId) {
      let p = get(/databases/$(database)/documents/productions/$(prodId)).data;
      return p.ownerUid == request.auth.uid ||
        ('MANAGE_BUDGET' in p.get('authority', {}).get(request.auth.uid, {}).get('permissions', []));
    }
    function billingAdminOf(k) {
      return isAuthenticated() && (
        (billKind(k) == 'USER' && billId(k) == request.auth.uid) ||
        (billKind(k) == 'BUSINESS' && billId(k) == request.auth.uid) ||
        (billKind(k) == 'ORG' && (chmsFinance(billId(k)) ||
            request.auth.uid in orgDoc(billId(k)).get('accountingUids', []))) ||
        (billKind(k) == 'PRODUCTION' && billProdAdmin(billId(k)))
      );
    }
    // Read-only accounting viewers may read ORG invoices.
    function billingReadOf(k) {
      return billingAdminOf(k) || (isAuthenticated() && billKind(k) == 'ORG' &&
        request.auth.uid in orgDoc(billId(k)).get('accountingViewUids', []));
    }
    match /billingCustomers/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingItems/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingEstimates/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingPaymentLinks/{id} {
      allow read: if billingAdminOf(resource.data.entityKey);
      allow create: if billingAdminOf(request.resource.data.entityKey);
      allow update: if billingAdminOf(resource.data.entityKey) && request.resource.data.entityKey == resource.data.entityKey;
      allow delete: if billingAdminOf(resource.data.entityKey);
    }
    match /billingInvoices/{id} {
      // Entity staff (incl. read-only accounting viewers) + the customer it was addressed to (never drafts).
      allow read: if billingReadOf(resource.data.entityKey) ||
        (isAuthenticated() && resource.data.get('customerUid', '') == request.auth.uid && resource.data.status != 'DRAFT');
      allow write: if false;   // server-only (service account bypasses rules)
    }
    // Server-only counters (sequential invoice/estimate numbers).
    match /billingCounters/{id} { allow read, write: if false; }
    // Per-entity billing preferences (default terms/footer/numbering prefix). Doc id IS the entityKey ("ORG:abc").
    match /billingSettings/{entityKey} {
      allow read: if billingReadOf(entityKey);
      allow create, update: if billingAdminOf(entityKey);
      allow delete: if false;
    }

    match /photo_albums/{albumId} {
      allow read: if (!('isPublic' in resource.data) || resource.data.isPublic == true) || (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && isValidPhotoAlbum(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidPhotoAlbum(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /notifications/{notifId} {
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      ) && (
        isValidNotification(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /posts/{postId} {
      allow read: if (!('isPublic' in resource.data) || resource.data.isPublic == true) || (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin() ||
                    // Elevate DEPARTMENT threads: private posts readable by that department (query must filter orgAudience=='DEPARTMENT').
                    (resource.data.get('orgAudience', '') == 'DEPARTMENT' && orgInDepartment(resource.data.authorOrgId, resource.data.get('orgDepartmentId', '')));
      // Private accounts' posts go to `private_posts` (services/privatePostsService.ts); only org DEPARTMENT threads stay here.
      allow create: if isRegisteredUser() && isValidPost(request.resource.data) && request.resource.data.authorId == request.auth.uid
                    && (request.resource.data.get('orgAudience', '') == 'DEPARTMENT' || !isPrivateAccount(request.auth.uid));
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid && isValidPost(request.resource.data)) ||
                      // Atomic +1/-1 like toggles bound to the user's UID
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount']) &&
                        (
                          (request.auth.uid in request.resource.data.likedBy &&
                           !(request.auth.uid in resource.data.likedBy) &&
                           request.resource.data.likesCount == resource.data.likesCount + 1) ||
                          (!(request.auth.uid in request.resource.data.likedBy) &&
                           request.auth.uid in resource.data.likedBy &&
                           request.resource.data.likesCount == resource.data.likesCount - 1)
                        )) ||
                      // Controlled atomic comment count changes
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']) &&
                        (request.resource.data.likesCount == resource.data.likesCount + 1 || request.resource.data.likesCount == resource.data.likesCount - 1 || request.resource.data.likesCount == resource.data.likesCount) &&
                        (request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1 || request.resource.data.commentsCount == resource.data.commentsCount)) ||
                      // Quote / repost counters (services/postingService) — bounded +/-1 per write, nothing else touched.
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteCount']) &&
                        request.resource.data.quoteCount is number &&
                        request.resource.data.quoteCount >= 0 &&
                        (request.resource.data.quoteCount - resource.data.get('quoteCount', 0) == 1 || request.resource.data.quoteCount - resource.data.get('quoteCount', 0) == -1)) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount']) &&
                        request.resource.data.repostCount is number &&
                        request.resource.data.repostCount >= 0 &&
                        (request.resource.data.repostCount - resource.data.get('repostCount', 0) == 1 || request.resource.data.repostCount - resource.data.get('repostCount', 0) == -1)) ||
                      // Exclusive post view tracking — any signed-in user can add themselves to viewedBy (grows by exactly 1, only their UID)
                      (isAuthenticated() &&
                       'isExclusive' in resource.data && resource.data.isExclusive == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']) &&
                       request.resource.data.viewedBy.size() == resource.data.viewedBy.size() + 1 &&
                       request.auth.uid in request.resource.data.viewedBy);
      // Any signed-in user can delete an exclusive post that has expired or hit its view limit (distributed cleanup)
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin() ||
                      // Elevate: org pastors/admins/leaders moderate their org's threads.
                      (isAuthenticated() && resource.data.get('authorOrgId', '') != '' && (orgPastorOrAdmin(resource.data.authorOrgId) || request.auth.uid in orgDoc(resource.data.authorOrgId).get('leaderUids', []))) ||
                      (isAuthenticated() && 'isExclusive' in resource.data && resource.data.isExclusive == true && (
                        ('expiresAt' in resource.data && resource.data.expiresAt < request.time.toMillis()) ||
                        ('viewLimit' in resource.data && 'viewedBy' in resource.data && resource.data.viewedBy.size() >= resource.data.viewLimit)
                      ));

      match /comments/{commentId} {
        allow read: if orgThreadReadOk(postId);
        allow create: if isRegisteredUser() && isValidPostComment(request.resource.data) && orgThreadCommentOk(postId);
        allow update: if isAdmin() ||
                        (isAuthenticated() && resource.data.uid == request.auth.uid) ||
                        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount']));
        // The post's author may also clear comments on their own post (used when a post moves to private_posts).
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid)
                      || (isAuthenticated() && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if isRegisteredUser() && isValidVideo(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidVideo(request.resource.data)) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']) &&
                        (request.resource.data.likesCount == resource.data.likesCount + 1 || request.resource.data.likesCount == resource.data.likesCount - 1 || request.resource.data.likesCount == resource.data.likesCount) &&
                        (request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1 || request.resource.data.commentsCount == resource.data.commentsCount));
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && likeId == request.auth.uid + "_" + videoId;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isRegisteredUser() && isValidVideoComment(request.resource.data) && request.resource.data.userId == request.auth.uid;
        // Creator reply-with-video: the VIDEO's owner may attach/clear replyVideoId on a
        // comment — and ONLY that key, so this can't become a general comment-edit hole.
        allow update: if isAuthenticated()
                      && get(/databases/$(database)/documents/videos/$(videoId)).data.ownerId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyVideoId']);
        allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    // Music tracks. NOTE: this collection had NO rule at all, so every write was denied by
    // default — backendService.updateTrack has been silently failing. Owner-scoped where the
    // doc carries an artistId.
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
                            && (!('artistId' in resource.data) || resource.data.artistId == request.auth.uid || isAdmin());
    }

    // Sounds registry — "use this sound" resolves a sound's title in one read.
    match /sounds/{trackId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Live → Short clip records.
    match /live_clips/{clipId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.clippedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.clippedBy == request.auth.uid;
    }

    // Weekly photo salons — one entry per photographer (doc id IS their uid).
    match /photoSalons/{salonId}/entries/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.auth.uid == entryId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.photoUrl is string;
      allow delete: if isAuthenticated() && request.auth.uid == entryId;
      // Own entry edit, OR a cross-user applause write that may touch nothing but `applause`.
      allow update: if isAuthenticated() && (
                      (request.auth.uid == entryId && request.resource.data.ownerId == request.auth.uid)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applause'])
                    );
    }

    match /video_playlists/{playlistId} {
      allow read: if (!('isPublic' in resource.data) || resource.data.isPublic == true) || (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && isValidVideoPlaylist(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidVideoPlaylist(request.resource.data));
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /users/{userId} {
      // Public read is allowed but write-through validation prevents
      // sensitive fields like masterEmail / aliases from leaking via
      // unsafe clients.  The email field stored here is used for
      // admin checks only and is NEVER surfaced in public-facing UI
      // (enforced at the application layer — see email privacy guards
      // in AdminDashboard, VideoTab, App.tsx, etc.).
      allow read: if true;
      // Allow owner to update everything; others can only bump followerCount.
      // A guardian may also create + manage a CHILD profile they own (isChild +
      // guardianUid == their uid) — Firestore-only managed sub-accounts, no separate auth.
      // teacherVerification gates the right to provision child accounts — it is a SERVER-ONLY
      // field (set via the service account, which bypasses these rules). A client may never
      // self-grant it on create or change it on update, or the provisioning gate is bypassable.
      allow create: if (isOwner(userId) && isValidUserProfile(request.resource.data) &&
                       request.resource.data.get('teacherVerification', 'UNVERIFIED') == 'UNVERIFIED' &&
                       noPlatformPrivilegeGrab(request.resource.data)) ||
                      (isAuthenticated() &&
                       request.resource.data.isChild == true &&
                       request.resource.data.guardianUid == request.auth.uid) ||
                      // Managed EMPLOYEE profile: a business owner/admin provisions a Firestore-only
                      // work identity (no login). Must be flagged isEmployee and owned by the creator.
                      (isAuthenticated() &&
                       request.resource.data.isEmployee == true &&
                       request.resource.data.managedByUid == request.auth.uid);
      allow update: if (isOwner(userId) && isValidUserProfile(request.resource.data) &&
                       request.resource.data.get('teacherVerification', 'UNVERIFIED') == resource.data.get('teacherVerification', 'UNVERIFIED') &&
                       platformPrivilegeUnchanged(request.resource.data, resource.data)) ||
                      (isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) &&
                       math.abs(request.resource.data.followerCount - resource.data.followerCount) == 1) ||
                      (isAuthenticated() &&
                       resource.data.isChild == true &&
                       resource.data.guardianUid == request.auth.uid) ||
                      // A managed employee profile is managed by its creator, or by the employer
                      // org's admins (roster/role/badge edits, and owner-initiated claim linking).
                      (isAuthenticated() &&
                       resource.data.isEmployee == true && (
                         resource.data.managedByUid == request.auth.uid ||
                         request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.employerOrgId)).data.admins
                       )) ||
                      // Admin display-name fix: an admin may set ONLY the display name for any
                      // user (e.g. re-syncing a creator whose rename didn't propagate). Scoped to
                      // displayName alone so sensitive fields (email, teacherVerification, aliases)
                      // can never be touched via this path.
                      (isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));

      // Aria (PlajahAgent) conversation history. The owner may create and read their OWN sessions, and read
      // their messages and daily usage counter. Every message and usage write is SERVER-ONLY (the service
      // account in /api/agent/chat bypasses these rules), so a client can neither forge Aria's replies nor
      // reset its own daily cap. Private: no admin read access (same stance as Ora).
      match /muse_sessions/{sessionId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }
      match /muse_usage/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Private user data — only the account owner can read
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── Plajah Pixels projects (components/plajahPixels/services/projectService) ──
      // A saved visual project (layers/config — no PII). PUBLIC read so an artist can
      // attach one to a Chora Mix as an "Author's Show" and every listener's Mix player
      // can load and play it back. Only the owner may write.
      match /plajahProjects/{projectId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // ── Ora — personal productivity & wellbeing (services/oraService) ──────
      // The most sensitive data on the platform: mood, journals, goals.
      // Owner-only, with NO admin escape hatch — an admin has no legitimate
      // reason to read someone's journal, and a rule that allows it is a rule
      // that will eventually be used. Journal bodies and check-in notes are
      // additionally encrypted client-side, so a database dump is ciphertext.
      // Note these are subcollections: the public `allow read: if true` on the
      // parent users/{userId} document does not reach them.
      // Academia mastery + course progress — the learner writes; a guardian can read (parent hub).
      match /mastery/{docId}        { allow read: if isOwner(userId) || isGuardianOf(userId); allow write: if isOwner(userId); }
      match /schoolProgress/{docId} { allow read: if isOwner(userId) || isGuardianOf(userId); allow write: if isOwner(userId); }
      match /ora_profile/{docId}  { allow read, write: if isOwner(userId); }
      match /ora_checkins/{docId} { allow read, write: if isOwner(userId); }
      match /ora_entries/{docId}  { allow read, write: if isOwner(userId); }
      match /ora_goals/{docId}    { allow read, write: if isOwner(userId); }
      match /ora_rituals/{docId}  { allow read, write: if isOwner(userId); }
      match /ora_sessions/{docId} { allow read, write: if isOwner(userId); }
      // Thesa stash — a person's saved cards + private notes. Owner-only, no admin escape hatch;
      // never read by ranking, ads or recommendations (services/thesa/stashService).
      match /thesa_stash/{cardId} { allow read, write: if isOwner(userId); }

      // Feed preferences (feedPreferences region — agent CARDS): users/{uid}/prefs/feed holds
      // muted topics / content types, "show less like this" weights and the default tab.
      // Private to the owner; ranking reads it client-side only (services/feedPreferencesService).
      match /prefs/{docId} { allow read, write: if isOwner(userId); }

      // The Post Man. `postman_prefs` is the only one the CLIENT touches — letter
      // skin and focus mode. `postman_accounts` holds OAuth refresh tokens and is
      // written by the server with a service account, which bypasses these rules;
      // the deny here is what stops a signed-in user reading their own tokens out
      // of the browser, which is the whole point of holding them server-side.
      match /postman_prefs/{docId}    { allow read, write: if isOwner(userId); }
      match /postman_accounts/{docId} { allow read, write: if false; }

      // Source Mode vault — ciphertext only, and the key never leaves the device.
      // The client is the only thing that ever reads or writes it.
      match /vault_meta/{docId}    { allow read, write: if isOwner(userId); }
      match /vault_records/{docId} { allow read, write: if isOwner(userId); }

      // Watch / listen history + Continue Watching (services/watchHistoryService).
      // Private to the owner; localStorage is the offline fallback.
      match /watchHistory/{itemId} {
        allow read, write: if isOwner(userId);
      }
      match /activityHistory/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Mirror of the videos the owner has liked (for the "Liked videos" surface).
      // Written alongside the videos/{id}/likes doc; owner-private.
      match /likedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // Taleo thumbs up/down ratings on films/series — owner-private.
      match /titleRatings/{titleId} {
        allow read, write: if isOwner(userId);
      }

      // Video taste reactions (services/videoTasteService) — the signal behind the "% Match"
      // badge, and the video sibling of trackReactions. Each doc carries the facets of the title
      // it was about (genre/category/creator/world/tags) so the vector can be derived without
      // re-fetching every video. Owner-private: this is a record of what one person likes, and
      // nothing else needs to read it.
      match /videoReactions/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // Marketing campaigns (services/marketing/campaignService) — the Local Reach
      // Campaign Hub. Lives under the operating user's subtree even when scoped to
      // a managed BUSINESS/ORG identity (scope.id / authorOrgId are logical partition
      // fields, not a separate storage location) — owner-private, same as scheduledPosts.
      match /campaigns/{campaignId} {
        allow read, write: if isOwner(userId);
      }

      // Research notebook (services/notebookService) — synced across devices.
      // Private to the owner; localStorage is the offline cache.
      match /notebook/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // "Own it forever" content licenses for paid films + books (services/contentLicense)
      // — owner-private entitlement/VC records. READ-ONLY to the client: licenses are
      // minted SERVER-SIDE in the Stripe webhook after a real charge (admin writes bypass
      // rules), so a buyer can never self-grant an entitlement.
      match /contentLicenses/{licenseId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Media dedup index (services/mediaDedup) — fingerprint → uploaded url, so identical
      // re-uploads reuse the existing asset. Owner-only.
      match /mediaIndex/{fingerprint} {
        allow read, write: if isOwner(userId);
      }

      // Fediverse accounts (Mastodon, Bluesky, Threads) — server writes on
      // behalf of the user using their Firebase ID token. Credentials are
      // AES-256-GCM encrypted at rest; the raw token never leaves the server.
      match /fediverseAccounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      // Music pulse — snapshots of songs a customer heard while physically at a business
      // (the "Heard at {business}" feed). Owner-private; written when checked in.
      match /musicPulse/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Education identity: SERVER-ONLY collections ──────────────────────────────
    // These hold child password hashes, claim secrets, and FERPA access logs. They are
    // written exclusively by the backend via the service account (which bypasses these
    // rules); no client may ever read or write them.
    match /learnerCredentials/{username}      { allow read, write: if false; }
    match /claimTokens/{code}                 { allow read, write: if false; }
    match /accountAudit/{eventId}             { allow read, write: if false; }
    match /teacherVerificationRequests/{uid}  { allow read, write: if false; }
    // TV sign-in pairing codes. A doc here briefly holds a Firebase custom token, so it is
    // credential-grade: readable only by the backend service account. Default-deny would cover
    // this already; it is written out because "nobody added a rule" is a weaker guarantee than
    // "someone wrote deny on purpose".
    match /tvPairings/{code}                  { allow read, write: if false; }

    // Emergent-school model — written EXCLUSIVELY by the backend service account (routes/schools.ts),
    // which bypasses these rules. Clients go through /api/schools/* and never write directly.
    //   schools           — public info (name/state/counts), readable by anyone; no client writes.
    //   schoolMemberships — a member may read only their OWN membership row; no client writes.
    //   schoolClaims/Audit — credential-grade; backend only.
    match /schools/{schoolId}            { allow read: if true; allow write: if false; }
    match /schoolMemberships/{memberId}  { allow read: if request.auth != null && request.auth.uid == resource.data.uid; allow write: if false; }
    match /schoolClaims/{claimId}        { allow read, write: if false; }
    match /schoolAudit/{eventId}         { allow read, write: if false; }

    // ── Ora Rest — the shared ambient loop library (services/oraRest) ──────
    // One platform-wide library, rendered once and watched by everyone. Users
    // may submit their own serene backgrounds; the Rest channel itself only ever
    // plays entries that are APPROVED *and* carry a measured seam within
    // SEAM_THRESHOLD (enforced client-side by isRestEligible, since the seam is
    // computed from the rendered file rather than claimed by the author).
    match /oraRestLoops/{loopId} {
      // Approved loops are public — this is a channel. Work in progress is
      // visible only to its author (and to a reviewer).
      allow read: if resource.data.status == 'APPROVED'
                  || (isAuthenticated() && resource.data.get('authorUid', '') == request.auth.uid)
                  || isAdmin();

      // A submission may never arrive pre-approved: an author can only create
      // DRAFT or SUBMITTED, and must own it. Approval is a reviewer's act.
      allow create: if isAuthenticated()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status in ['DRAFT', 'SUBMITTED'];

      // The author may keep editing until it is approved, but can never move it
      // to APPROVED themselves, and can never change who wrote it.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.get('authorUid', '') == request.auth.uid
                        && resource.data.status != 'APPROVED'
                        && request.resource.data.status in ['DRAFT', 'SUBMITTED']
                        && request.resource.data.authorUid == resource.data.authorUid);

      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.get('authorUid', '') == request.auth.uid);
    }

    // ── Ora "your corner" — accountability (services/oraCorner) ────────────
    // The only cross-user surface in Ora. Membership is owner-written and
    // member-readable; the status card is owner-written and readable only by
    // the uids the owner has listed.
    //
    // The card is counts-only by construction (streak, checked-in-today, goal
    // counts) — no entries, no titles, no mood values. These rules are the
    // second line of that promise, not the first: oraCorner.publishStatus
    // assembles the card field by field so a private value cannot ride along.
    match /oraCorner/{cornerId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      // A corner is five people. Enforced here too, so a hand-rolled client
      // cannot turn a corner into a broadcast audience.
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.resource.data.memberUids.size() <= 5;
      allow update: if isAuthenticated()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.memberUids.size() <= 5;
      // The owner dissolves it; a member may delete only to remove themselves,
      // which the client models as dissolving their own single-member corner.
      allow delete: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid
                        || request.auth.uid in resource.data.memberUids);
    }

    match /oraCornerStatus/{statusUid} {
      allow read: if isAuthenticated()
                  && (request.auth.uid == statusUid
                      || request.auth.uid in resource.data.visibleToUids);
      // Only ever your own card, and the doc id must be your uid — otherwise a
      // client could publish a card in someone else's name.
      allow write: if isOwner(statusUid)
                   && (request.method == 'delete'
                       || request.resource.data.uid == request.auth.uid);
    }

    // ── Education: the Learner Ledger. A student owns their record; a guardian may read it. ──
    function isGuardianOf(studentId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(studentId)) &&
             get(/databases/$(database)/documents/users/$(studentId)).data.guardianUid == request.auth.uid;
    }
    // Learner / teacher corrections for lessons and questions. Anyone signed in may report; only admins read or resolve.
    match /contentReports/{id} {
      allow create: if isAuthenticated() && request.resource.data.keys().hasOnly(['kind','ref','courseId','note','excerpt','uid','at','status'])
                    && request.resource.data.note is string && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
    // Homeschool family records (weekly plan, hours log, portfolio). Private to the parent.
    match /homeschool/{parentUid} {
      allow read, write: if isOwner(parentUid);
    }
    match /readingProgress/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }
    // Voca read-aloud progress — the reader writes their own; guardians can read it.
    match /vocaProgress/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }
    // Homeroom: a student asks their guardian for text chat. Only the child creates it, addressed to
    // their own guardian; the child and that guardian can read it; only the guardian can resolve it.
    match /chatRequests/{id} {
      allow create: if isAuthenticated() && request.resource.data.childUid == request.auth.uid
                    && request.resource.data.guardianUid == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.guardianUid
                    && request.resource.data.status == 'pending';
      allow read: if isAuthenticated() && (resource.data.childUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.guardianUid == request.auth.uid;
    }
    // Homeroom: a student proposes a club and names a sponsor; it stays a draft until the sponsor accepts.
    match /clubProposals/{id} {
      allow create: if isAuthenticated() && request.resource.data.proposerUid == request.auth.uid
                    && request.resource.data.status == 'awaiting_sponsor';
      allow read: if isAuthenticated() && (resource.data.proposerUid == request.auth.uid || resource.data.sponsorUid == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.sponsorUid == request.auth.uid;
    }
    // Penna handwriting workshop — the learner writes their own progress as they practice.
    match /handwritingProgress/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }
    // Penna difficulty tuning — set BY an adult FOR the learner (the app blocks student self-edits;
    // a guardian can always write, and an adult account may tune its own).
    match /handwritingSettings/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId) || isGuardianOf(userId);
    }
    match /languageProgress/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }
    // Praxis venture — a founder's business-in-progress (one active per user).
    // Owner-owned; a guardian may read a minor's (simulated) venture, mirroring
    // the learner-progress collections above.
    match /ventures/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }
    // Live-stream cloud-recording manifest (segment count etc.), written live by the streamer;
    // the server reads it (admin) to assemble the replay.
    match /liveRecordings/{streamId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }
    match /learnerProficiency/{studentId} {
      allow read: if isOwner(studentId) || isGuardianOf(studentId);
      allow write: if isOwner(studentId);
    }
    match /learningLedger/{studentId}/records/{recordId} {
      allow read: if isOwner(studentId) || isGuardianOf(studentId);
      allow create: if isOwner(studentId);
      allow update, delete: if false; // append-only
    }
    match /competencyAssertions/{studentId}/items/{itemId} {
      allow read: if isOwner(studentId) || isGuardianOf(studentId);
      allow write: if isOwner(studentId);
    }

    // ── Rooms — the canonical platform primitive (services/roomService) ──
    // Host-owned rooms (TOPIC/PROFILE/WATCH/LISTEN/STUDY): creator is the host and
    // owns doc writes. Shared rooms (MATCH/TEAM/LEAGUE) have no host (hostId == '') and
    // a deterministic id — any signed-in user may materialize/update them (presence,
    // polls, live context), mirroring the wcMatchRooms model.
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.hostId == request.auth.uid ||
        (request.resource.data.hostId == '' && request.resource.data.kind in ['MATCH', 'TEAM', 'LEAGUE'])
      );
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.get('hostId', 'x') == '' ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
      match /members/{uid} {
        allow read: if true;
        allow write: if isAuthenticated() && uid == request.auth.uid;
      }
      match /chat/{msgId} {
        allow read: if true;
        allow create: if isAuthenticated()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 500;
      }
      // Banter polls (shared rooms): any signed-in user may add a poll and vote — votes
      // is a shared map mutated cross-user, matching the wcMatchRooms poll model.
      match /polls/{pollId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
      }
    }

    // Two-way (walkie-talkie): per-user prefs + per-pair transmission channel.
    match /walkiePrefs/{uid} {
      allow read, write: if isAuthenticated() && uid == request.auth.uid;
    }
    match /podcastLibrary/{uid} {
      allow read, write: if isAuthenticated() && uid == request.auth.uid;  // your followed-podcasts library, synced cross-device
    }
    match /studioAds/{uid} {
      allow read, write: if isAuthenticated() && uid == request.auth.uid;  // podcast studio ad library (reads + spots)
    }
    match /errorReports/{id} {
      // any signed-in user logs their own errors; only admins read/clear them
      allow create: if isAuthenticated();
      allow read, delete: if isAdmin();
    }
    match /uploadAttempts/{id} {
      // The upload-attempt ledger (services/uploadReports.ts). A creator opens and updates
      // their OWN rows as an upload progresses; they may read their own history so the app
      // can show "this upload failed". Admins read everything across the platform.
      // Update is restricted to the owner so a heartbeat can never be forged for someone
      // else's upload; nobody but an admin may delete (a deleted row is a lost failure).
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /trackAnalysis/{trackId} {
      // Precomputed waveform peaks + beat grid for a track. Public read (needed by the
      // player/DJ for any playable track); any signed-in user may compute + write it
      // (best-effort backfill). Size is bounded by the client (downsampled peaks).
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /taleoAnalysis/{albumId} {
      // Taleo Story Intelligence job docs (status + progress for the background
      // film-analysis worker). Owner-only read; only the server (service
      // account, rules-exempt) writes them.
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if false;
    }
    match /photoCritiques/{photoId}/entries/{critiqueId} {
      // Structured photo critique (composition / light / story, 1–5) — the doc id IS the
      // critic's uid, so a person can only ever write their own critique and re-submitting
      // updates rather than duplicating. Public read so aggregates are visible to everyone.
      allow read: if true;
      allow create, update: if isAuthenticated()
                            && request.auth.uid == critiqueId
                            && request.resource.data.composition is int
                            && request.resource.data.composition >= 1 && request.resource.data.composition <= 5
                            && request.resource.data.light is int
                            && request.resource.data.light >= 1 && request.resource.data.light <= 5
                            && request.resource.data.story is int
                            && request.resource.data.story >= 1 && request.resource.data.story <= 5;
      allow delete: if isAuthenticated() && request.auth.uid == critiqueId;
    }
    match /smartProductions/{productionId} {
      // Sports Director (Smart Director) multi-camera productions.
      // Read: public/unlisted productions are open to anyone with the link; a 'school'
      // production only to its owner and signed-in members of the linked school/org
      // (the orgMemberIndex/{orgId_uid} ACTIVE-membership marker).
      allow read: if resource == null
        || resource.data.get('audience', 'public') != 'school'
        || (isAuthenticated() && (
              resource.data.ownerId == request.auth.uid
              || exists(/databases/$(database)/documents/orgMemberIndex/$(resource.data.get('school', {}).get('orgId', '_') + '_' + request.auth.uid))));
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Only the owner directs (program, mode, consent, audience, outputs). Contributors may
      // only change the roster (join / leave / their role) — and clear program if they leave
      // while on it. (Per-slot ownership inside the feeds array isn't expressible here.)
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feeds', 'updatedAt'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feeds', 'updatedAt', 'directionState'])
            && request.resource.data.directionState.programFeedId == '')
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
    match /loginIssues/{id} {
      // Login failures happen while LOGGED OUT, so create must not require auth.
      // Guarded to a well-formed, size-capped login-issue doc so it can't be abused
      // as free storage. Only admins read/clear (for the login-trouble alert feed).
      allow create: if request.resource.data.keys().hasOnly(['provider','code','message','email','url','userAgent','createdAt'])
                    && request.resource.data.provider is string && request.resource.data.provider.size() < 40
                    && request.resource.data.message is string && request.resource.data.message.size() < 500
                    && request.resource.data.createdAt is int;
      allow read, delete: if isAdmin();
    }
    match /liveFeed/{id} {
      // Admin-only analytics/site-health collection (server-populated). It had no rule,
      // so it fell through to default-deny — which failed the admin Analytics query.
      allow read, write: if isAdmin();
    }
    match /userHealth/{uid} {
      // Per-user experience-health snapshots. Owner writes own; owner + admins read.
      allow read: if isAdmin() || (isAuthenticated() && uid == request.auth.uid);
      allow write: if isAuthenticated() && uid == request.auth.uid;
    }
    match /walkiePresence/{uid} {
      allow read: if isAuthenticated();                                  // hot contacts read peer presence
      allow write: if isAuthenticated() && uid == request.auth.uid;      // own presence only
    }
    match /walkieChannels/{pairId} {
      // pairId is the two uids sorted + joined by "__"
      allow read: if isAuthenticated() && request.auth.uid in pairId.split('__');
      match /tx/{txId} {
        allow read: if isAuthenticated() && request.auth.uid in pairId.split('__');
        allow create: if isAuthenticated()
                      && request.resource.data.fromUid == request.auth.uid
                      && request.auth.uid in pairId.split('__');
        allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
      }
    }

    // ── Social safety helpers (blocks / private accounts) ──
    function isPrivateAccount(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
             && get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) == true;
    }
    function isBlockedPair(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
             || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    match /follows/{followId} {
      // followId is followerId_followingId
      allow read: if true;
      allow create: if isAuthenticated()
                    && followId == request.resource.data.followerId + "_" + request.resource.data.followingId
                    && !isBlockedPair(request.resource.data.followerId, request.resource.data.followingId)
                    && (
                      // Self-follow: denied for private accounts (they must approve a request).
                      (request.resource.data.followerId == request.auth.uid
                        && request.resource.data.followerId != request.resource.data.followingId
                        && !isPrivateAccount(request.resource.data.followingId))
                      ||
                      // Approval: the followed (private) account creates the edge for the requester,
                      // ONLY while that requester's pending request exists.
                      (request.resource.data.followingId == request.auth.uid
                        && exists(/databases/$(database)/documents/follow_requests/$(followId))
                        && get(/databases/$(database)/documents/follow_requests/$(followId)).data.status == 'pending'
                        && get(/databases/$(database)/documents/follow_requests/$(followId)).data.requesterId == request.resource.data.followerId
                        && get(/databases/$(database)/documents/follow_requests/$(followId)).data.targetId == request.auth.uid)
                    );
      // Follower can change only their notification bell level.
      allow update: if isAuthenticated()
                    && resource.data.followerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyLevel']);
      // Follower unfollows; the followed account may also remove a follower (used by block).
      allow delete: if isAuthenticated()
                    && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    // follow_requests/{requesterId_targetId} — request to follow a private account.
    match /follow_requests/{reqId} {
      allow get: if isAuthenticated()
                 && (resource.data.requesterId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow list: if isAuthenticated()
                  && (resource.data.requesterId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId != request.auth.uid
                    && reqId == request.auth.uid + '_' + request.resource.data.targetId
                    && request.resource.data.status == 'pending'
                    && !isBlockedPair(request.auth.uid, request.resource.data.targetId)
                    // Rate limit: the SAME batch must bump rateLimits/{me} (see rateLimits rules below);
                    // that doc's own rules force lastFollowRequestAt == request.time and cap 30/hour, 1 per 2s.
                    && getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.get('lastFollowRequestAt', null) == request.time;
      // The target resolves a pending request (only status + resolvedAt may change).
      allow update: if isAuthenticated()
                    && resource.data.targetId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);
      // Requester can cancel unless declined; a decline sticks for 7 days (then the requester may
      // clear it and ask again). Target can clear anytime.
      allow delete: if isAuthenticated()
                    && ((resource.data.requesterId == request.auth.uid
                         && (resource.data.status != 'declined'
                             || ('resolvedAt' in resource.data && request.time > resource.data.resolvedAt + duration.value(7, 'd'))))
                        || resource.data.targetId == request.auth.uid);
    }

    // blocks/{blocker_blocked} — readable by either party, written only by the blocker.
    match /blocks/{blockId} {
      allow get: if isAuthenticated()
                 && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow list: if isAuthenticated()
                  && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.blockerId == request.auth.uid
                    && request.resource.data.blockedId is string
                    && request.resource.data.blockedId != request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // users/{uid}/mutes/{target} — private to the owner.
    match /users/{userId}/mutes/{targetId} {
      allow read, write: if isOwner(userId);
    }

    // rateLimits/{uid} — owner-only counter doc. The follow-request fields (frCount, frWindowStart,
    // lastFollowRequestAt) can ONLY advance through a valid transition at request.time (min 2s gap,
    // max 30 per rolling hour window), so the owner cannot rewind them; follow_requests creates
    // require this doc to be bumped in the same batch (getAfter). Never deletable (a delete would reset).
    function rlFrTouched(keys) {
      return keys.hasAny(['frCount', 'frWindowStart', 'lastFollowRequestAt']);
    }
    function rlFrAdvance(o, n) {
      return n.lastFollowRequestAt == request.time
          && o.get('lastFollowRequestAt', timestamp.date(1970, 1, 1)) + duration.value(2, 's') <= request.time
          && (
               (o.get('frWindowStart', timestamp.date(1970, 1, 1)) + duration.value(1, 'h') <= request.time
                 && n.frCount == 1 && n.frWindowStart == request.time)
               ||
               (n.frWindowStart == o.get('frWindowStart', timestamp.date(1970, 1, 1))
                 && n.frCount == o.get('frCount', 0) + 1 && n.frCount <= 30)
             );
    }
    // Say-hi counter (hlCount, hlWindowStart, lastHelloAt): same shape as the follow-request one —
    // min 3s gap, max 30 per rolling 24h window; hellos creates require the same-batch bump (getAfter).
    function rlHlTouched(keys) {
      return keys.hasAny(['hlCount', 'hlWindowStart', 'lastHelloAt']);
    }
    function rlHlAdvance(o, n) {
      return n.lastHelloAt == request.time
          && o.get('lastHelloAt', timestamp.date(1970, 1, 1)) + duration.value(3, 's') <= request.time
          && (
               (o.get('hlWindowStart', timestamp.date(1970, 1, 1)) + duration.value(24, 'h') <= request.time
                 && n.hlCount == 1 && n.hlWindowStart == request.time)
               ||
               (n.hlWindowStart == o.get('hlWindowStart', timestamp.date(1970, 1, 1))
                 && n.hlCount == o.get('hlCount', 0) + 1 && n.hlCount <= 30)
             );
    }
    match /rateLimits/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.keys().size() <= 20
                    && (!rlFrTouched(request.resource.data.keys())
                        || (request.resource.data.lastFollowRequestAt == request.time
                            && request.resource.data.frWindowStart == request.time
                            && request.resource.data.frCount == 1))
                    && (!rlHlTouched(request.resource.data.keys())
                        || (request.resource.data.lastHelloAt == request.time
                            && request.resource.data.hlWindowStart == request.time
                            && request.resource.data.hlCount == 1));
      allow update: if isOwner(userId) && request.resource.data.keys().size() <= 20
                    && (!rlFrTouched(request.resource.data.diff(resource.data).affectedKeys())
                        || rlFrAdvance(resource.data, request.resource.data))
                    && (!rlHlTouched(request.resource.data.diff(resource.data).affectedKeys())
                        || rlHlAdvance(resource.data, request.resource.data));
      allow delete: if false;
    }

    // user_sanctions/{uid} — written by admins from the ReportsQueue (warnings, suspension marker,
    // reportBlocked = barred from filing reports). The subject can read their own record.
    match /user_sanctions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Private-account posts (services/privatePostsService.ts) ──
    // Readable by the author or an approved follower (follows edge exists; edges to private
    // accounts only come from approval). Provable ONLY for per-author equality queries
    // (`where('authorId','==',X)`): that pins resource.data.authorId so the follows path is
    // computable. Unfiltered / `in` / range queries are rejected by the engine (fail closed).
    function canReadPrivateAuthor(authorId) {
      return isAuthenticated()
             && (request.auth.uid == authorId
                 || exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorId))
                 || isAdmin());
    }
    match /private_posts/{postId} {
      allow read: if canReadPrivateAuthor(resource.data.authorId);
      allow create: if isRegisteredUser() && isValidPost(request.resource.data)
                    && request.resource.data.authorId == request.auth.uid
                    && isPrivateAccount(request.auth.uid);
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid && isValidPost(request.resource.data))
                    // like toggles by a viewer who can see the post
                    || (canReadPrivateAuthor(resource.data.authorId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])
                        && ((request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy)
                             && request.resource.data.likesCount == resource.data.likesCount + 1)
                            || (!(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy
                             && request.resource.data.likesCount == resource.data.likesCount - 1)))
                    // comment counter bumps by a viewer who can see the post
                    || (canReadPrivateAuthor(resource.data.authorId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
                        && (request.resource.data.commentsCount == resource.data.commentsCount + 1
                            || request.resource.data.commentsCount == resource.data.commentsCount - 1));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if canReadPrivateAuthor(get(/databases/$(database)/documents/private_posts/$(postId)).data.authorId);
        allow create: if isRegisteredUser() && isValidPostComment(request.resource.data)
                      && canReadPrivateAuthor(get(/databases/$(database)/documents/private_posts/$(postId)).data.authorId);
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid)
                      || (isAuthenticated() && get(/databases/$(database)/documents/private_posts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    match /feed/{postId} {
      allow read: if true;
      // The feed mirror is world-readable, so a private account must not mirror post text into it.
      allow create: if isAuthenticated() && isValidFeedItem(request.resource.data)
                    && (!('authorId' in request.resource.data) || !isPrivateAccount(request.resource.data.authorId));
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid && isValidFeedItem(request.resource.data)) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidPostComment(request.resource.data);
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      }
    }

    // An OER textbook is free to every account, permanently. Plajah does not sell textbooks
    // and never places them behind Plajah+. That is not only policy — it is the condition that
    // makes hosting the CC BY-NC-SA titles lawful, since NonCommercial restricts commercial
    // use rather than hosting. So the "free" half of the record is pinned here: once a doc is
    // an oerTextbook, nobody (including an admin, including a future feature that means well)
    // can price it, paywall it, or quietly drop the flag to get around the first two.
    // NOTE the .get(field, default) accessors. Reading a field that does not exist is an ERROR
    // in rules, and an error denies the write — so `resource.data.oerTextbook` on an ordinary
    // album (which has no such field) would refuse every normal album create, edit and delete
    // on the platform. Optional fields must always be read with a default.
    function oerTextbookStaysFree() {
      return !(resource.data.get('oerTextbook', false) == true) || (
        request.resource.data.get('oerTextbook', false) == true &&
        request.resource.data.get('price', 1) == 0 &&
        request.resource.data.get('isPaywalled', true) == false &&
        request.resource.data.get('oerLicense', '') == resource.data.get('oerLicense', '') &&
        request.resource.data.get('oerAttribution', '') == resource.data.get('oerAttribution', '')
      );
    }

    match /albums/{albumId} {
      allow read: if true;
      // A client may not mint an OER textbook — those come from the ingest script over the
      // Admin REST path, which bypasses rules. Otherwise anyone could stamp oerTextbook on
      // their own work and inherit a protection that isn't theirs.
      allow create: if ((isAuthenticated() && isValidAlbum(request.resource.data) && request.resource.data.ownerId == request.auth.uid) || isAdmin())
                    && !(request.resource.data.get('oerTextbook', false) == true);
      allow update: if (isDocOwner() || isAdmin()) && isValidAlbum(request.resource.data) && oerTextbookStaysFree();
      allow delete: if (isDocOwner() || isAdmin()) && !(resource.data.get('oerTextbook', false) == true);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow update, delete: if isAdmin();
      }
    }

    match /live_feeds/{feedId} {
      allow read: if true;
      allow create: if (isAuthenticated() && isValidLiveFeed(request.resource.data) && request.resource.data.ownerId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && isValidLiveFeed(request.resource.data) && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /merch/{merchId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidMerchItem(request.resource.data) && request.resource.data.artistId == request.auth.uid;
      allow update: if isAuthenticated() && isValidMerchItem(request.resource.data) && resource.data.artistId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.artistId == request.auth.uid || isAdmin());
    }

    // Canonical store catalog (consolidated store system). Seller-owned; buyers may only
    // touch stock/soldCount/reviewCount (checkout + reviews).
    match /storeProducts/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      // Stock and soldCount are written by the SELLER (dashboard) or the server order spine (admin
      // credentials) — never by shoppers. (A previous rule let ANY signed-in user rewrite any product's
      // stock.) Shoppers may only bump review aggregates.
      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'rating', 'updatedAt']));
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());

      // Back-in-stock waitlist: a shopper adds/removes themselves; the seller reads it to notify.
      match /waitlist/{shopperUid} {
        allow create: if isAuthenticated() && request.auth.uid == shopperUid;
        allow read, delete: if isAuthenticated() && (request.auth.uid == shopperUid
                    || get(/databases/$(database)/documents/storeProducts/$(productId)).data.sellerId == request.auth.uid);
        allow update: if false;
      }
    }

    // Stock ledger — every receive/sale/adjust/damage, so "where did my inventory go" has an answer.
    // The seller reads + appends their own entries; the server writes sale entries; nobody edits history.
    match /stockMoves/{moveId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Orders are created ONLY by the server order spine (Stripe-paid / POS), which prices + stock-checks
    // every line. The seller may advance status / add tracking; the buyer reads.
    match /storeOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingNumber', 'trackingCarrier', 'shippedAt', 'oversold', 'sellerNote']);
    }

    // POS refunds: written ONLY by the server (/api/store/pos-refund: validates qty/amount, restocks through the
    // ledger, idempotent by id). The seller reads them for reports and the returns picker.
    match /storeRefunds/{refundId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Public receipt tokens (GET /r/:token is served by the server). Never client-readable: the token IS the secret.
    match /posReceipts/{token} {
      allow read, write: if false;
    }

    // Artist↔business cross-promo bookings: the business creates; both parties read; the creator
    // (or business) updates status (accept/decline). Queried by creatorUid / businessUid.
    match /promoBookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.businessUid == request.auth.uid || resource.data.creatorUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.businessUid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.businessUid == request.auth.uid);
    }

    // Public business directory. Anyone may browse (the Business hub lists all businesses); the owner
    // manages their own page. (Without this rule, client reads were permission-denied, which threw and
    // left the Business dashboard's loading gate spinning forever.)
    match /businessPages/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Business-ops namespace: businesses/{ownerUid} holds a business's subcollections (the doc id IS
    // the owner's uid). Separate from the businessPages collection. Covers messaging opt-in/broadcasts
    // and the Team/HR module (staff, shifts, time-off). (Without this, those writes were denied.)
    match /businesses/{businessUid} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == businessUid;

      // A customer opts into a business's updates (writes their own doc); the business reads its list.
      match /subscribers/{customerUid} {
        allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid);
        allow write: if isAuthenticated() && (request.auth.uid == customerUid || request.auth.uid == businessUid);
      }
      // Owner-managed: broadcast log + the Team/HR module.
      match /broadcasts/{id} { allow read, write: if isAuthenticated() && request.auth.uid == businessUid; }
      // Staff roster. PINs are NEVER client-readable/writable: the only PIN material is a salted hash in
      // staffSecrets (below), written by the server. Writes that carry pin/pinHash/pinSalt are rejected.
      match /staff/{id} {
        allow read, delete: if isAuthenticated() && request.auth.uid == businessUid;
        allow create, update: if isAuthenticated() && request.auth.uid == businessUid
                              && !request.resource.data.keys().hasAny(['pin', 'pinHash', 'pinSalt']);
      }
      // Server-only: salted PIN hashes, open-shift markers, drawer pointer. No client access at all.
      match /staffSecrets/{id} { allow read, write: if false; }
      match /shiftOpen/{id}    { allow read, write: if false; }
      match /drawerState/{id}  { allow read, write: if false; }
      // Shifts are written by the server (PIN-verified clock in/out); the owner may read and correct them.
      match /shifts/{id}     { allow read, write: if isAuthenticated() && request.auth.uid == businessUid; }   // owner may seed/correct; PIN clock events are server-written
      match /timeOff/{id}    { allow read, write: if isAuthenticated() && request.auth.uid == businessUid; }
      // Cash drawer sessions + Z reports: server-written (staff sign in by PIN, not Firestore); the owner reads.
      match /drawerSessions/{id} { allow read: if isAuthenticated() && request.auth.uid == businessUid; allow write: if false; }
      // Stored value (gift cards / store credit / wallets): SERVER-WRITE-ONLY. Owner reads; a customer reads only their own
      // customer-tied card (wallet / credit) and its ledger. The code-hash index (storedValueIndex) has NO client rule at all.
      match /storedValue/{cardId} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || resource.data.get('customerUid', '') == request.auth.uid); allow write: if false; }
      match /storedValueLedger/{entryId} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || resource.data.get('customerUid', '') == request.auth.uid); allow write: if false; }
      // Loyalty balances are written server-side (POS sale); the business and the customer can read.
      match /loyalty/{customerUid} { allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid); }
      // In-store deals: the business writes, anyone may read (register + storefront evaluate them).
      match /offers/{id} { allow read: if true; allow write: if isAuthenticated() && request.auth.uid == businessUid; }
      // Now Playing — the business publishes the current in-store track; checked-in customers read it.
      match /nowPlaying/{id} { allow read: if true; allow write: if isAuthenticated() && request.auth.uid == businessUid; }
      // Presence — a customer checks in (writes their own doc); the business sees who's in-store.
      match /presence/{customerUid} {
        allow read: if isAuthenticated() && (request.auth.uid == businessUid || request.auth.uid == customerUid);
        allow write: if isAuthenticated() && (request.auth.uid == customerUid || request.auth.uid == businessUid);
      }
    }

    // Service tickets (repair orders, wash-and-fold). SERVER-ONLY writes (Admin/REST via /api/tickets/*, CAS-guarded).
    // The business owner may read their own tickets; staff (PIN sessions) read through the server. Customers never
    // read this collection: they use the HMAC link page (/t/:token), which strips internal notes, costs and audit.
    // Counters are server-only. There are no token docs: link tokens are HMACs, nothing is stored to leak.
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid;
      allow write: if false;
    }
    match /ticketCounters/{id} { allow read, write: if false; }

    // Auto repair layer (services/autoServer.ts). Every write is SERVER-ONLY (Admin/REST, CAS-guarded).
    // vehicles / inspections: the owning business may read its own; staff PIN sessions read through the server.
    match /vehicles/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    match /inspections/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    // Vehicle Passport: the customer reads their OWN passports/entries (ownerUid); shops never read these directly -
    // a shop sees other shops' entries only through the server with an owner-issued, 48h share token.
    match /passports/{id} { allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid; allow write: if false; }
    match /passportEntries/{id} { allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid; allow write: if false; }
    // NHTSA caches + reminder de-dupe: server-only, nothing sensitive but no client business reading them.
    match /vinCache/{id} { allow read, write: if false; }
    match /recallCache/{id} { allow read, write: if false; }
    match /serviceReminders/{id} { allow read, write: if false; }

    // Laundromat layer (services/laundryServer.ts). SERVER-ONLY writes: money, accounts and invoices never come from clients.
    // The owner may read their own settings / commercial accounts / invoices; staff read through the server.
    match /laundrySettings/{businessUid} { allow read: if isAuthenticated() && request.auth.uid == businessUid; allow write: if false; }
    match /laundryAccounts/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    match /laundryInvoices/{id} { allow read: if isAuthenticated() && resource.data.businessUid == request.auth.uid; allow write: if false; }
    match /laundryInvoiced/{id} { allow read, write: if false; }
    match /laundryCounters/{id} { allow read, write: if false; }
    match /laundryReminders/{id} { allow read, write: if false; }

    match /storeReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount']);
      allow delete: if isAdmin();
    }

    // eBay-lite auctions. Public read; sellers own; bidders may only push bid fields;
    // a Buy-It-Now buyer may settle (status/winner/finalPrice) and route fundraiser proceeds.
    match /garageSale/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'currentBidderId', 'currentBidderName', 'bidCount']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerId', 'winnerName', 'finalPrice', 'sanctuaryFundraiserLink']) && request.resource.data.winnerId == request.auth.uid)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sanctuaryFundraiserLink']));
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());

      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.bidderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /donations/{donationId} {
      allow read: if isAuthenticated() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid || isAdmin() ||
        // Elevate Finance Hub: the church's finance/trustee roles read native online gifts (churchId = org id).
        (resource.data.get('churchId', '') != '' && chmsGivingRead(resource.data.churchId)));
      allow create: if isAuthenticated() && isValidDonation(request.resource.data) && request.resource.data.fromId == request.auth.uid;
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /tv_channels/{channelId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidTVChannel(request.resource.data) && channelId == request.auth.uid;
      allow delete: if isAuthenticated() && (channelId == request.auth.uid || isAdmin());
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidGame(request.resource.data);
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPhoto(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidPhoto(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /classroom_modules/{moduleId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidClassroomModule(request.resource.data);
      allow delete: if isAdmin();
    }

    function classroomMeetingReader(data, uid) {
      let classroom = get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data;
      return classroom.ownerId == uid || uid in classroom.enrolledStudents;
    }
    function classroomMeetingActive(data) {
      return data.get('workspaceType', '') != 'CLASSROOM_MEETING' || (
        classroomMeetingReader(data, request.auth.uid) &&
        get(/databases/$(database)/documents/liveClassSessions/$(data.liveClassSessionId)).data.status == 'LIVE'
      );
    }
    function validClassroomMeetingRoom(data) {
      let classroom = get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data;
      let session = getAfter(/databases/$(database)/documents/liveClassSessions/$(data.liveClassSessionId)).data;
      return data.ownerId == classroom.ownerId && request.auth.uid == classroom.ownerId &&
        session.classroomId == data.classroomId && session.hostId == classroom.ownerId &&
        data.type == 'GROUP' && data.nibblesEnabled == false &&
        data.participants.hasAll(classroom.enrolledStudents) && classroom.ownerId in data.participants &&
        data.participants.toSet().difference(classroom.enrolledStudents.toSet()).hasOnly([classroom.ownerId]);
    }
    function classroomMeetingRoomUpdate(before, after) {
      return (before.get('workspaceType', '') != 'CLASSROOM_MEETING' && after.get('workspaceType', '') != 'CLASSROOM_MEETING') ||
        (before.get('workspaceType', '') == 'CLASSROOM_MEETING' && after.get('workspaceType', '') == 'CLASSROOM_MEETING' &&
         before.classroomId == after.classroomId && before.liveClassSessionId == after.liveClassSessionId && validClassroomMeetingRoom(after));
    }
    match /chat_rooms/{roomId} {
      function meetingMember() {
        return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants &&
          classroomMeetingActive(get(/databases/$(database)/documents/chat_rooms/$(roomId)).data);
      }
      function classroomThreadAccess() {
        return !exists(/databases/$(database)/documents/chat_rooms/$(roomId)) ||
          get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.get('workspaceType', '') != 'CLASSROOM_MEETING' ||
          classroomMeetingReader(get(/databases/$(database)/documents/chat_rooms/$(roomId)).data, request.auth.uid);
      }
      function meetingControl() {
        return get(/databases/$(database)/documents/chat_rooms/$(roomId)/meetings/control).data;
      }
      function hasMeetingControl() {
        return exists(/databases/$(database)/documents/chat_rooms/$(roomId)/meetings/control);
      }
      function meetingScope(uid, scope) {
        return uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants && (
          (!hasMeetingControl() && scope == 'main') ||
          (hasMeetingControl() && !(uid in meetingControl().removedIds) &&
           meetingControl().assignments.get(uid, 'main') == scope &&
           (scope == 'main' || scope in meetingControl().breakoutRooms))
        );
      }
      function meetingManager() {
        return meetingMember() && !(request.auth.uid in meetingControl().removedIds) &&
          (request.auth.uid == meetingControl().hostId || request.auth.uid in meetingControl().moderatorIds);
      }
      function validMeeting(data) {
        return data.keys().hasOnly(['hostId', 'moderatorIds', 'breakoutRooms', 'assignments', 'removedIds', 'muteRequests', 'revision']) &&
          data.hostId is string && data.moderatorIds is list && data.moderatorIds.size() <= 100 &&
          data.breakoutRooms is map && data.breakoutRooms.size() <= 12 &&
          data.assignments is map && data.assignments.size() <= 1000 &&
          data.removedIds is list && data.removedIds.size() <= 1000 && !(data.hostId in data.removedIds) &&
          data.muteRequests is map && data.muteRequests.size() <= 1000 && data.revision is int && data.revision >= 1;
      }
      match /meetings/{controlId} {
        allow read: if meetingMember();
        allow create: if controlId == 'control' && meetingMember() && validMeeting(request.resource.data) &&
          request.auth.uid == get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.get('ownerId', '') &&
          request.resource.data.hostId == request.auth.uid && request.resource.data.revision == 1;
        allow update: if controlId == 'control' && meetingManager() && validMeeting(request.resource.data) &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.revision == resource.data.revision + 1 &&
          (request.auth.uid == resource.data.hostId || request.resource.data.moderatorIds == resource.data.moderatorIds);
      }
      match /meeting_rtc/{scope} {
        allow read: if meetingMember() && meetingScope(request.auth.uid, scope);
        match /participants/{uid} {
          allow read: if meetingMember() && meetingScope(request.auth.uid, scope);
          allow create, update: if meetingMember() && uid == request.auth.uid && meetingScope(uid, scope) &&
            request.resource.data.keys().hasOnly(['role', 'name', 'joinedAt']) && request.resource.data.role == 'participant' &&
            request.resource.data.name is string && request.resource.data.name.size() <= 200;
          // Removed or reassigned users may delete their own stale presence.
          allow delete: if isAuthenticated() && uid == request.auth.uid;
        }
        match /signals/{edge} {
          function edgeAllowed() {
            let peers = edge.split('__');
            return meetingMember() && meetingScope(request.auth.uid, scope) && peers.size() == 2 &&
              request.auth.uid in peers && meetingScope(peers[0], scope) && meetingScope(peers[1], scope);
          }
          function edgeSender() { return edge.split('__')[0] == request.auth.uid; }
          allow read: if edgeAllowed();
          allow create, update: if edgeAllowed() && edgeSender() &&
            request.resource.data.keys().hasOnly(['description']) && request.resource.data.description is map;
          allow delete: if edgeAllowed() && edgeSender();
          match /candidates/{candidateId} {
            allow read: if edgeAllowed();
            allow create: if edgeAllowed() && edgeSender() && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          }
        }
        match /messages/{messageId} {
          allow read: if meetingMember() && meetingScope(request.auth.uid, scope);
          allow create: if meetingMember() && meetingScope(request.auth.uid, scope) &&
            request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'timestamp']) &&
            request.resource.data.senderId == request.auth.uid && request.resource.data.senderName is string &&
            request.resource.data.senderName.size() <= 100 && request.resource.data.text is string &&
            request.resource.data.text.matches('^enc:.*') && request.resource.data.text.size() <= 16000 &&
            request.resource.data.timestamp is number;
        }
      }
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        resource.data.type == 'PUBLIC_LIVE' || 
        isAdmin()
      );
      // Education DM policy: a student-involving PRIVATE 1:1 must pass dmPairAllowed.
      allow create: if isAuthenticated() && isValidChatRoom(request.resource.data) && (
        (request.resource.data.get('workspaceType', '') == 'CLASSROOM_MEETING' &&
         roomId == 'class_meeting_' + request.resource.data.liveClassSessionId && validClassroomMeetingRoom(request.resource.data)) ||
        (request.resource.data.get('workspaceType', '') == 'PRODUCTION' &&
         request.resource.data.get('productionId', '') is string &&
         request.resource.data.get('nibblesEnabled', true) == false &&
         canManageProductionChatById(request.resource.data.productionId)) ||
        (request.resource.data.get('workspaceType', '') != 'PRODUCTION' && request.resource.data.get('workspaceType', '') != 'CLASSROOM_MEETING' && (
          request.resource.data.type != 'PRIVATE' ||
          request.resource.data.participants.size() != 2 ||
          (dmPairAllowed(request.resource.data.participants)
           // Social safety: no NEW 1:1 DM between people where either has blocked the other.
           && !isBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1]))
        ))
      );
      allow update: if isAuthenticated() && classroomMeetingRoomUpdate(resource.data, request.resource.data) && (
        (resource.data.get('workspaceType', '') == 'PRODUCTION' &&
         request.resource.data.get('workspaceType', '') == 'PRODUCTION' &&
         request.resource.data.get('productionId', '') == resource.data.get('productionId', '') &&
         request.resource.data.get('nibblesEnabled', true) == false &&
         canManageProductionChatById(resource.data.productionId) && isValidChatRoom(request.resource.data)) ||
        (resource.data.get('workspaceType', '') != 'PRODUCTION' && request.auth.uid in resource.data.participants && isValidChatRoom(request.resource.data) &&
         (request.auth.uid == resource.data.get('ownerId', '') ||
          (request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '') &&
           request.resource.data.get('meetingModeratorIds', []) == resource.data.get('meetingModeratorIds', [])))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typingUsers', 'updatedAt', 'lastMessage'])) ||
        isAdmin()
      );
      
      match /messages/{messageId} {
        // Hardened read logic for messages:
        // 1. If the room is identified as a live chat via naming convention, allow reading (lax fallback)
        // 2. OR if the parent room doc exists AND user is participant or type is PUBLIC_LIVE
        allow read: if isAuthenticated() && classroomThreadAccess() && (
          roomId.matches("^live_chat_.*") || 
          (exists(/databases/$(database)/documents/chat_rooms/$(roomId)) && (
            request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants ||
            get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.type == 'PUBLIC_LIVE'
          )) ||
          isAdmin()
        );
        allow create: if isAuthenticated() && classroomThreadAccess() && isValidChatMessage(request.resource.data) &&
          request.resource.data.senderId == request.auth.uid && !dmRoomBlocked(roomId) && (
            get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.get('workspaceType', '') != 'PRODUCTION' ||
            canPostProductionChat(get(/databases/$(database)/documents/chat_rooms/$(roomId)).data)
          ) && (
            !('productionEntity' in request.resource.data) ||
            (get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.get('workspaceType', '') == 'PRODUCTION' &&
             request.resource.data.productionEntity.productionId == get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.productionId)
          );
        allow update: if isAuthenticated() && (
          // Seen receipts (any reader).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) &&
           request.auth.uid in request.resource.data.seenBy) ||
          // Arm the ephemeral countdown (burn-after-read + intimate "gift" open) — a room participant.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'burnAfter', 'giftOpenedAt']) &&
           exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
           request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants)
        );
        allow delete: if isAdmin()
          || (isAuthenticated() && resource.data.senderId == request.auth.uid)
          // Ephemeral (burning / gift) messages self-destruct — any room participant may reap them.
          || (isAuthenticated()
              && (resource.data.get('burnAfter', null) != null || resource.data.get('burnAfterSeen', false) == true || resource.data.get('giftMedia', false) == true)
              && exists(/databases/$(database)/documents/chat_rooms/$(roomId))
              && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants);
      }

      // Intimate in-chat games (e.g. Magic 8-Ball) — any room participant may read/write.
      match /games/{gameId} {
        allow read, write: if isAuthenticated()
          && exists(/databases/$(database)/documents/chat_rooms/$(roomId))
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    // Shared Couples Diary — private to the two DM participants. Entry text is also
    // safeword-encrypted client-side; these rules are the hard access boundary.
    match /couplesDiaries/{roomId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid in resource.data.participantUids;
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.participantUids.size() == 2;
    }

    // Nibble invites — shareable partner-invite tokens. The code is an unguessable
    // token shared privately, so any signed-in user may read one they were given.
    // Only the inviter creates; the accepter (not the inviter) marks it ACCEPTED.
    match /nibbleInvites/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.inviterUid == request.auth.uid;
      allow update: if isAuthenticated()
                    && request.auth.uid != resource.data.inviterUid
                    && request.resource.data.inviterUid == resource.data.inviterUid;
      allow delete: if isAuthenticated() && (resource.data.inviterUid == request.auth.uid || isAdmin());
    }

    // Fabula projects — owner-only index docs. Full project JSON lives in Storage
    // (fabula/{uid}/...); this doc backs listing + ownership.
    match /fabula_projects/{projectId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /collab_projects/{projectId} {
      allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(resource.data.chatRoomId)).data.participants);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(resource.data.chatRoomId)).data.participants);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /calls/{callId} {
      allow read: if isAuthenticated() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /ppv_events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPPVEvent(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid && isValidPPVEvent(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purchasedBy']) && request.resource.data.purchasedBy.hasAll(resource.data.purchasedBy))
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    function validLiveClassSession(data) {
      return data.keys().hasOnly(['classroomId', 'hostId', 'title', 'scheduledAt', 'durationMinutes', 'meetingUrl', 'status', 'recordingUrl', 'attendeeIds', 'createdAt']) &&
        data.classroomId is string && data.hostId is string && data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.scheduledAt is number && data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 1440 &&
        data.status in ['SCHEDULED', 'LIVE', 'ENDED'] && data.attendeeIds is list && data.attendeeIds.size() <= 1000 && data.createdAt is number &&
        (!('meetingUrl' in data) || (data.meetingUrl is string && data.meetingUrl.size() <= 2000 && data.meetingUrl.matches('^https://.*')));
    }
    match /liveClassSessions/{sessionId} {
      allow read: if isAuthenticated() && classroomMeetingReader(resource.data, request.auth.uid);
      allow create: if isAuthenticated() && validLiveClassSession(request.resource.data) &&
        request.resource.data.hostId == request.auth.uid &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.ownerId == request.auth.uid &&
        request.resource.data.status == 'SCHEDULED';
      allow update: if isAuthenticated() && validLiveClassSession(request.resource.data) &&
        resource.data.hostId == request.auth.uid &&
        get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.ownerId == request.auth.uid &&
        request.resource.data.classroomId == resource.data.classroomId && request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (resource.data.status != 'ENDED' || request.resource.data.status == 'ENDED');
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }
    match /classrooms/{classId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidClassroom(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid && isValidClassroom(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) && request.resource.data.enrolledStudents.hasAll(resource.data.enrolledStudents))
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /submissions/{subId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        get(/databases/$(database)/documents/classrooms/$(get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.classId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isValidSubmission(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (get(/databases/$(database)/documents/classrooms/$(get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.classId)).data.ownerId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade', 'feedback'])) ||
        isAdmin()
      );
    }

    match /progress_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidProgressReport(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid && isValidProgressReport(request.resource.data));
    }

    match /video_chats/{chatId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidVideoChatSession(request.resource.data);
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'isActive'])
      );
    }

    match /pay_it_forward/status {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pay_it_forward/vault {
      allow read, write: if isAdmin();
    }

    match /pay_it_forward_donations/{donationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.donorId == request.auth.uid);
      allow create: if isAuthenticated() && isValidPayItForwardDonation(request.resource.data) && request.resource.data.donorId == request.auth.uid;
    }

    match /pay_it_forward_winners/{winnerId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if (isAdmin()) || 
                      (isAuthenticated() && resource.data.uid == request.auth.uid && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       resource.data.status == 'PENDING' &&
                       request.resource.data.status in ['CLAIMED', 'PASSED']);
    }

    match /test/connection {
      allow read: if true;
    }

    match /mailing_lists/{subId} {
      // subId is artistId_subscriberId
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.artistId || request.auth.uid == resource.data.subscriberId || isAdmin());
      allow create: if isAuthenticated() && isValidMailingListSubscriber(request.resource.data) && request.resource.data.subscriberId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.subscriberId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
    }

    match /newsletters/{newsId} {
      allow read: if isAuthenticated() && (resource.data.artistId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidNewsletter(request.resource.data) && request.resource.data.artistId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.artistId == request.auth.uid || isAdmin());
    }

    // ── Campaigns (routes/campaigns.ts) ──────────────────────────────────────
    // All three are written by the SERVER with a service account, which bypasses
    // these rules. The client is read-only, and only for its own records, so a
    // sender can see their history and who they may no longer contact — but
    // cannot forge a send record or quietly delete someone off the suppression
    // list. Suppression that a sender can edit is not suppression.
    match /campaign_senders/{ownerId} {
      allow read: if isOwner(ownerId);
      allow write: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /campaign_suppression/{entryId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /articles/{articleId} {
      allow read: if (!('isPublic' in resource.data) || resource.data.isPublic == true) || (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && isValidArticle(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid && isValidArticle(request.resource.data)) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']));
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow update, delete: if isAdmin();
      }
    }

    match /brand_accounts/{brandId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidBrandAccount(request.resource.data) && request.resource.data.adminId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.adminId == request.auth.uid || request.auth.uid in resource.data.managers) && isValidBrandAccount(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.adminId == request.auth.uid || isAdmin());
    }

    match /fan_pages/{pageId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidFanPage(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members) && isValidFanPage(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /personal_tracks/{trackId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && isValidPersonalTrack(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) && isValidPersonalTrack(request.resource.data)) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /personal_albums/{albumId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && isValidPersonalAlbum(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) && isValidPersonalAlbum(request.resource.data)) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /personal_playlists/{playlistId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && isValidPersonalPlaylist(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) && isValidPersonalPlaylist(request.resource.data)) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Canonical cross-service media index (media-library API). Public-read catalog;
    // owner-write; artistId is immutable (per PlayGround.api security_spec).
    match /mediaAssets/{assetId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.artistId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.artistId == request.auth.uid
                       && request.resource.data.artistId == resource.data.artistId;
      allow delete: if isAuthenticated() && resource.data.artistId == request.auth.uid || isAdmin();
    }

    // Saved Spatial Mixer projects (arrangement + IAMF metadata + private-locker stem URLs).
    // Owner-only, never shared.
    match /spatial_mixes/{mixId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Melos productions — album workspaces + the Beats room's grooves. Owner or roster member
    // only; every subcollection (songs, arrangements, pins, samples, grooves…) inherits access
    // through the parent production lookup. PRIVATE by default; collaborator sharing = the
    // memberUids roster maintained by melosService.
    match /melosProductions/{prodId} {
      function isMelosMember() {
        return isAuthenticated()
          && (resource.data.ownerUid == request.auth.uid
              || request.auth.uid in resource.data.get('memberUids', []));
      }
      allow read, update, delete: if isMelosMember() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      match /{document=**} {
        function isParentMember() {
          let p = get(/databases/$(database)/documents/melosProductions/$(prodId)).data;
          return isAuthenticated()
            && (p.ownerUid == request.auth.uid || request.auth.uid in p.get('memberUids', []));
        }
        allow read, write: if isParentMember() || isAdmin();
      }
    }

    // Sync-license requests: a filmmaker asks a track owner to license an un-priced
    // track. Requester creates & reads their own; owner reads & responds (status/price).
    match /licenseRequests/{reqId} {
      allow read: if isAuthenticated() &&
                     (resource.data.requesterUid == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterUid == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid
                       && request.resource.data.ownerUid == resource.data.ownerUid
                       && request.resource.data.requesterUid == resource.data.requesterUid;
      allow delete: if isAdmin();
    }

    // Private movie/TV locker (Plex-style, surfaced in Taleo). Owner-only, never shared.
    match /personal_videos/{videoId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Private ebook library (own EPUB/PDF the user imports, surfaced in Lorea).
    // Owner-only, never shared — same legal invariant as the music/video lockers.
    match /personal_books/{bookId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ad_campaigns/{campaignId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidAdCampaign(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidAdCampaign(request.resource.data)) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /postThemeBackgrounds/{bgId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPostThemeBackground(request.resource.data);
      allow update: if isAdmin() && isValidPostThemeBackground(request.resource.data);
      allow delete: if isAdmin();
    }

    match /worlds/{worldId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidWorld(request.resource.data) && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && (
                       // Normal owner update
                       (resource.data.creatorId == request.auth.uid && (
                         isValidWorld(request.resource.data) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timelineIds', 'assetIds', 'characterIds', 'loreIds', 'creatorId'])
                       )) ||
                       // Claim ownership of worlds with blank creatorId (legacy data fix)
                       (resource.data.creatorId == '' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorId']) && request.resource.data.creatorId == request.auth.uid)
                     ));
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /characters/{characterId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidCharacter(request.resource.data) && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin()) && isValidCharacter(request.resource.data);
        allow delete: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
      }

      match /lore/{loreId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidLoreEntry(request.resource.data) && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin()) && isValidLoreEntry(request.resource.data);
        allow delete: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
      }

      match /timeline/{eventId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidTimelineEvent(request.resource.data) && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin()) && isValidTimelineEvent(request.resource.data);
        allow delete: if isAuthenticated() && (get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid || isAdmin());
      }

      match /timelines/{timelineId} {
        allow read: if true;
        allow create: if isAdmin() || (isAuthenticated() && isValidTimeline(request.resource.data) && get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid);
        allow update: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid && isValidTimeline(request.resource.data));
        allow delete: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/worlds/$(worldId)).data.creatorId == request.auth.uid);
      }
    }

    // ── Hide N Seek ─────────────────────────────────────────────────────────

    // Alternate tracks subcollection — only album owner can write; authenticated users can read
    // (client enforces H&S window; reading outside a window doesn't expose audio at the platform level)
    match /albums/{albumId}/hideNSeekAlternates/{altId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/albums/$(albumId)).data.ownerId == request.auth.uid);
    }

    // Per-user discovery progress — each user reads/writes only their own doc
    match /hideNSeekProgress/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // Aggregate stats — readable by anyone; written by any authenticated user (discovery increments)
    match /hideNSeekStats/{albumId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ────────────────────────────────────────────────────────────────────────

    match /universes/{universeId} {
      allow list, get: if true;
      allow create, update: if isAdmin() && isValidUniverse(request.resource.data);
      allow delete: if isAdmin();
    }

    match /web_apps/{appId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidWebApp(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidWebApp(request.resource.data)) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['installCount', 'rating', 'reviewCount']));
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidReview(request.resource.data) && request.resource.data.userId == request.auth.uid;
        allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    // Aggregated creator metrics. Written ONLY by the server (service account bypasses rules);
    // the client is denied outright, because a client-writable counter is a forgeable counter and
    // that is precisely how the old track_stats/albums increments were being attempted.
    // Readable by the content owner only — these are business metrics, not public numbers.
    match /contentStats/{contentId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow write: if false;

      // Per-day buckets behind the same ownership check. Rules do not inherit, so the parent
      // condition has to be restated here or these would be unreachable.
      match /daily/{day} {
        allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // The PUBLIC half of the metrics rollup: play count and the thumbs tally, and nothing else.
    // Deliberately separate from contentStats — that doc also carries watch-time and the retention
    // curve, which are the creator's business metrics. Rules cannot restrict which FIELDS a read
    // returns, so the only way to publish one number without publishing all of them is a separate
    // document. Written by the server alone (service account bypasses rules).
    match /publicStats/{contentId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-voter record backing the publicStats thumbs tally. Server-only in both directions: it
    // exists so the aggregate can apply a vote DELTA rather than blindly adding, and it is not a
    // public who-voted-what list.
    match /contentRatings/{contentId}/voters/{uid} {
      allow read, write: if false;
    }

    // Legacy public play counters. Now written exclusively by /api/metrics/events (the server's
    // service account bypasses rules), so client writes are denied outright.
    //
    // These rules USED to let any signed-in client do a +1. That made every counter forgeable —
    // and it did not even work: the writer in backendService.incrementTrackPlay also sent
    // trackId/albumId/lastPlayed, which hasOnly(['playCount']) rejected, so every play after the
    // first was silently denied and the numbers on screen were stuck near zero.
    match /track_stats/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /video_stats/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // GAMIFICATION - Achievements, Points, Badges
    // ===============================================================

    // Achievements (System and Admin-created)
    match /achievements/{id} {
      allow read: if true; // Public read
      allow create: if isAdmin() && hasRequiredFields(['title', 'description', 'category', 'pointsValue']);
      allow update: if isAdmin();
      allow delete: if false; // Prevent deletion, use deactivation
    }

    // User Achievement Progress — server/admin writes only; owner can read
    match /userAchievements/{document=**} {
      allow read: if isAuthenticated() && (
        isOwner(get(/databases/$(database)/documents/userAchievements/$(document)).data.userId) || isAdmin()
      );
      // Only admin can grant achievements — prevents self-granting
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Opt-in public achievement showcase (services/publicAchievementsService.ts). One doc per
    // (user, achievement), id = `${uid}_${achievementId}`. The private `userAchievements` stay owner-read;
    // this is the owner's explicit, celebratory mirror that followers' feed cards read. Content is pinned
    // to the admin-curated `achievements` catalog (title/description must match it, KITH_* embargoed ones
    // are refused) so an owner cannot publish arbitrary text. Honest limit: ownership of the unlock itself
    // is self-asserted (userAchievements ids are random so rules cannot cross-check them).
    // Gated on users/{uid}.shareAchievements != false and on the account not being private.
    function paValid(d, id) {
      return d.keys().hasOnly(['userId', 'achievementId', 'title', 'description', 'icon', 'backgroundColor', 'category', 'pointsValue', 'earnedAt'])
        && d.keys().hasAll(['userId', 'achievementId', 'title', 'earnedAt'])
        && d.userId == request.auth.uid
        && d.achievementId is string && d.achievementId.size() > 0 && d.achievementId.size() < 128
        && id == d.userId + '_' + d.achievementId
        && d.earnedAt is number && d.earnedAt <= request.time.toMillis() + 300000
        && (!('pointsValue' in d) || d.pointsValue is number)
        && (!('icon' in d) || (d.icon is string && d.icon.size() < 64))
        && (!('backgroundColor' in d) || (d.backgroundColor is string && d.backgroundColor.size() < 32))
        && exists(/databases/$(database)/documents/achievements/$(d.achievementId))
        && get(/databases/$(database)/documents/achievements/$(d.achievementId)).data.title == d.title
        && get(/databases/$(database)/documents/achievements/$(d.achievementId)).data.get('description', '') == d.get('description', '')
        && !(get(/databases/$(database)/documents/achievements/$(d.achievementId)).data.get('triggerType', '').matches('KITH_.*'))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('shareAchievements', true) != false
        && !isPrivateAccount(request.auth.uid);
    }
    match /publicAchievements/{id} {
      allow read: if true;
      allow create: if isRegisteredUser() && paValid(request.resource.data, id);
      allow update: if isRegisteredUser() && resource.data.userId == request.auth.uid && paValid(request.resource.data, id);
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ===============================================================
    // DEBATES (services/debateService.ts) — public structured-discourse threads.
    // This collection had NO match → every client read/write was default-denied, which broke the
    // Pulse tab, debate challenges and the profile debate record. Reads are public (debates are public
    // discourse). Writes are bounded to exactly the transitions debateService performs:
    //   create  — the challenger, PENDING, zeroed counters
    //   accept  — the defender, PENDING → ACTIVE (+acceptedAt/endsAt ≤ ~25h out); decline — PENDING → DECLINED
    //   postCount +1 (ACTIVE only), self-disqualification log append (participants only)
    //   side vote — a non-participant may add/remove ONLY their own uid in the two supporter arrays
    //   judging — after endsAt: ACTIVE → ENDED → JUDGED(+verdict); verdict refinement within 15 min
    // Residual risk: judging is client-triggered (verdict content is not server-verifiable) — move
    // triggerAriaJudgment to a Cloud Function and drop the judging branches when that exists.
    // ===============================================================
    function dbtAff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function dbtOnlyMine(oldL, newL) {
      return newL is list && newL.size() <= oldL.size() + 1
        && newL.toSet().difference(oldL.toSet()).hasOnly([request.auth.uid])
        && oldL.toSet().difference(newL.toSet()).hasOnly([request.auth.uid]);
    }
    function dbtParent(debateId) {
      return get(/databases/$(database)/documents/debates/$(debateId)).data;
    }
    function dbtVerdictOk(v) {
      return v is map && v.winner in ['CHALLENGER', 'DEFENDER', 'DRAW'];
    }

    match /debates/{debateId} {
      allow read: if true;
      allow create: if isAdmin() || (isRegisteredUser()
        && request.resource.data.keys().hasAll(['challengerId', 'defenderId', 'topic', 'createdAt', 'endsAt', 'status'])
        && request.resource.data.challengerId == request.auth.uid
        && request.resource.data.defenderId is string
        && request.resource.data.defenderId != request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 1000
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt <= request.time.toMillis() + 300000
        && request.resource.data.endsAt is number
        && request.resource.data.get('postCount', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.get('challengerSupporters', []) == []
        && request.resource.data.get('defenderSupporters', []) == []
        && request.resource.data.get('disqualified', []) == []
        && !('verdict' in request.resource.data)
        && request.resource.data.get('sourcePostText', '').size() <= 20000
        && request.resource.data.get('sourceCommentText', '').size() <= 5000);
      allow update: if isAdmin() || (isRegisteredUser() && (
        // accept
        (resource.data.defenderId == request.auth.uid && resource.data.status == 'PENDING'
          && dbtAff().hasOnly(['status', 'acceptedAt', 'endsAt'])
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.acceptedAt is number
          && request.resource.data.endsAt is number
          && request.resource.data.endsAt <= request.time.toMillis() + 90000000)
        // decline
        || (resource.data.defenderId == request.auth.uid && resource.data.status == 'PENDING'
          && dbtAff().hasOnly(['status']) && request.resource.data.status == 'DECLINED')
        // post counter +1
        || (resource.data.status == 'ACTIVE' && dbtAff().hasOnly(['postCount'])
          && request.resource.data.postCount == resource.data.postCount + 1)
        // a participant logs their own disqualification
        || ((resource.data.challengerId == request.auth.uid || resource.data.defenderId == request.auth.uid)
          && dbtAff().hasOnly(['disqualified'])
          && request.resource.data.disqualified.size() == resource.data.get('disqualified', []).size() + 1
          && request.resource.data.disqualified[request.resource.data.disqualified.size() - 1].uid == request.auth.uid)
        // side vote: not a participant, only your own uid, never on both sides
        || (resource.data.status == 'ACTIVE'
          && resource.data.challengerId != request.auth.uid && resource.data.defenderId != request.auth.uid
          && dbtAff().hasOnly(['challengerSupporters', 'defenderSupporters'])
          && dbtOnlyMine(resource.data.get('challengerSupporters', []), request.resource.data.get('challengerSupporters', []))
          && dbtOnlyMine(resource.data.get('defenderSupporters', []), request.resource.data.get('defenderSupporters', []))
          && !(request.auth.uid in request.resource.data.get('challengerSupporters', []) && request.auth.uid in request.resource.data.get('defenderSupporters', [])))
        // judging (client-triggered; see header)
        || (resource.data.status == 'ACTIVE' && request.time.toMillis() > resource.data.endsAt
          && dbtAff().hasOnly(['status']) && request.resource.data.status == 'ENDED')
        || (resource.data.status in ['ACTIVE', 'ENDED'] && request.time.toMillis() > resource.data.endsAt
          && dbtAff().hasOnly(['status', 'verdict']) && request.resource.data.status == 'JUDGED'
          && dbtVerdictOk(request.resource.data.verdict))
        || (resource.data.status == 'JUDGED' && dbtAff().hasOnly(['verdict'])
          && dbtVerdictOk(request.resource.data.verdict)
          && request.time.toMillis() < resource.data.get('verdict', {}).get('generatedAt', 0) + 900000)
      ));
      allow delete: if isAdmin();

      match /posts/{postId} {
        allow read: if true;
        allow create: if isAdmin() || (isRegisteredUser()
          && request.resource.data.keys().hasAll(['debateId', 'authorId', 'side', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['debateId', 'authorId', 'authorName', 'authorPhoto', 'side', 'text', 'mediaUrl', 'mediaType',
               'dataVizPresetId', 'timestamp', 'isDisqualified', 'disqualifyReason', 'flaggedForReview', 'reactions', 'replyToId'])
          && request.resource.data.debateId == debateId
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000
          && request.resource.data.timestamp is number
          && request.resource.data.get('reactions', {}) == {}
          && (
            (request.resource.data.authorId == request.auth.uid && dbtParent(debateId).status == 'ACTIVE')
            // the "accepted / declined" system line the defender's client writes
            || (request.resource.data.authorId == 'PLAJAH_SYSTEM' && dbtParent(debateId).defenderId == request.auth.uid
                && dbtParent(debateId).status in ['ACTIVE', 'DECLINED'])
          ));
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    // User Points Balance — read-only for owner; only admin can write
    // Users MUST NOT be able to self-modify point balances
    match /userPoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Points Transactions (Audit Trail) — admin-write only; immutable once created
    match /pointsTransactions/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow create: if isAdmin();
      allow update: if false; // Immutable transactions
      allow delete: if false;
    }

    // ── Kith Sightings ────────────────────────────────────────────────────────
    // Everything here is written by the server (service account, which bypasses
    // these rules) via /api/kith/**. Clients may READ their own records and may
    // never write any of them — if a client could create a sighting or edit a
    // counter, the entire anti-farm model would be worthless.

    // Spawns. Owner-readable so the UI can render what the server issued.
    match /kithSightings/{sightingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false; // server-only — see routes/kithSightings.ts
    }

    // Per-user counters, cooldown and daily cap.
    match /kithHunters/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // server-only
    }

    // The Field Log — append-only, and only the server appends.
    match /kithSightingLog/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // server-only
    }

    // User Badges
    match /userBadges/{document=**} {
      allow read: if isOwner(get(/databases/$(database)/documents/userBadges/$(document)).data.userId);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Badge Definitions
    match /badges/{id} {
      allow read: if true; // Public read
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ===============================================================
    // CLUBS
    // ===============================================================

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      // allow unclaimed demo club to be claimed by any authenticated user
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.admins ||
        resource.data.creatorId == request.auth.uid ||
        (resource.data.creatorId == '' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorId', 'admins', 'isDemo', 'updatedAt']) && request.resource.data.creatorId == request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /clubPosts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
      }

      match /clubGallery/{itemId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.uploaderId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
      }

      match /clubChatMessages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
      }

      match /clubEvents/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.hostId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
      }

      match /clubStickyNotes/{noteId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.admins || isAdmin());
      }
    }

    match /clubMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.admins ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Organizations (Part 2): a parallel account = business page + club. ──
    match /organizations/{orgId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.admins ||
        resource.data.creatorId == request.auth.uid ||
        // anyone may bump follower/member counters
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'memberCount', 'updatedAt']) ||
        // Elevate: pastors manage ministries/rosters + the derived role index (cannot touch money/admins/ownership).
        (request.auth.uid in resource.data.get('pastorUids', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ministries', 'rosterIntro', 'setupState', 'pastorUids', 'financeUids', 'prayerUids', 'leaderUids', 'givingViewUids', 'accountingUids', 'accountingViewUids', 'staffUids', 'memberCount', 'updatedAt'])) ||
        // Elevate: finance roles own giving setup only.
        (request.auth.uid in resource.data.get('financeUids', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['givingFunds', 'givingUrl', 'stripeAccountId', 'setupState', 'legalName', 'ein', 'statementFooter', 'financeSettings', 'updatedAt'])) ||
        // Elevate: department heads edit ministry/department definitions.
        (request.auth.uid in resource.data.get('leaderUids', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ministries', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());

      // Append-only audit trail of sensitive org actions (services/orgAudit.ts). Owner/admins
      // read; any authed actor may append an entry stamped with their own uid; never edited.
      match /audit/{entryId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.admins ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Hiring / volunteers (ATS) ────────────────────────────────────────────
    function orgAdminOf(orgId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.admins ||
        get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid
      );
    }
    function productionStaffOf(prodId) {
      let p = get(/databases/$(database)/documents/productions/$(prodId)).data;
      return isAuthenticated() && p.get('isShowcase', false) != true && (
        p.ownerUid == request.auth.uid ||
        (p.authority is map
          && request.auth.uid in p.authority
          && p.authority[request.auth.uid].permissions is list
          && 'MANAGE_HIRING' in p.authority[request.auth.uid].permissions)
      );
    }
    // Job/volunteer postings — public can read OPEN ones; only org admins write.
    match /jobPostings/{postingId} {
      allow read: if (resource.data.status == 'OPEN') || orgAdminOf(resource.data.orgId) ||
                     (resource.data.productionId is string && productionStaffOf(resource.data.productionId)) || isAdmin();
      allow create: if orgAdminOf(request.resource.data.orgId) ||
                       (request.resource.data.productionId is string && productionStaffOf(request.resource.data.productionId));
      allow update, delete: if orgAdminOf(resource.data.orgId) ||
                               (resource.data.productionId is string && productionStaffOf(resource.data.productionId)) || isAdmin();
    }
    // Applications — PII-sensitive. Anyone signed in may apply to an OPEN posting (creating their
    // own application at stage APPLIED); org admins manage; an applicant may read/withdraw only theirs.
    match /applications/{appId} {
      allow read: if orgAdminOf(resource.data.orgId) ||
                     (resource.data.productionId is string && productionStaffOf(resource.data.productionId)) ||
                     (isAuthenticated() && resource.data.applicantUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() &&
                       request.resource.data.stage == 'APPLIED' &&
                       get(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobId)).data.status == 'OPEN';
      allow update: if orgAdminOf(resource.data.orgId) ||
                       (resource.data.productionId is string && productionStaffOf(resource.data.productionId)) ||
                       // the applicant may only withdraw their own application
                       (isAuthenticated() && resource.data.applicantUid == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'updatedAt']) &&
                        request.resource.data.stage == 'WITHDRAWN');
      allow delete: if orgAdminOf(resource.data.orgId) ||
                       (resource.data.productionId is string && productionStaffOf(resource.data.productionId)) || isAdmin();
    }
    match /productionInvites/{token} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.productionId is string && productionStaffOf(request.resource.data.productionId);
      allow update, delete: if productionStaffOf(resource.data.productionId) ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'active']) &&
         request.resource.data.uses == resource.data.uses + 1 && resource.data.active == true &&
         resource.data.expiresAt > request.time.toMillis() && resource.data.uses < resource.data.maxUses);
    }

    // Multi-site program-feed registry (Part 3, Phase 5): campuses publish live
    // program outputs; master control lists them. Not sensitive (just discovery).
    match /program_feeds/{feedId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Church congregant records (Servant Keeper import/export). Church staff only.
    match /congregants/{personId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.churchId)).data.admins;
      allow create: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(request.resource.data.churchId)).data.admins;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.churchId)).data.admins;
    }

    function orgDoc(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)).data; }
    function orgPastorOrAdmin(orgId) {
      return orgAdminOf(orgId) || request.auth.uid in orgDoc(orgId).get('pastorUids', []);
    }
    // A valid, unexpired, unrevoked invite whose org + role match the membership being created.
    function inviteOk(data) {
      let inv = get(/databases/$(database)/documents/orgInvites/$(data.inviteToken)).data;
      return inv.orgId == data.orgId && inv.roleKey == data.roleKey && inv.get('revoked', false) == false &&
        inv.expiresAt > request.time.toMillis() && inv.uses < inv.maxUses &&
        (inv.get('requireApproval', false) == false || data.status == 'PENDING') &&
        data.role in ['MEMBER', 'STAFF', 'MODERATOR'] && !('permissions' in data) && !('isSenior' in data);
    }

    // ── Elevate social threads ────────────────────────────────────────────────
    // Rules cannot query memberships by random id, so organizationService keeps a deterministic marker
    // orgMemberIndex/{orgId_uid} (ACTIVE members only, with the ministryIds they belong to) and
    // orgFollowers/{orgId_uid} for followers.
    function orgIsMemberOrFollower(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/orgMemberIndex/$(orgId + '_' + request.auth.uid)) ||
        exists(/databases/$(database)/documents/orgFollowers/$(orgId + '_' + request.auth.uid)) ||
        orgPastorOrAdmin(orgId)
      );
    }
    function orgInDepartment(orgId, deptId) {
      return isAuthenticated() && (
        orgPastorOrAdmin(orgId) ||
        request.auth.uid in orgDoc(orgId).get('leaderUids', []) ||
        (exists(/databases/$(database)/documents/orgMemberIndex/$(orgId + '_' + request.auth.uid)) &&
          deptId in get(/databases/$(database)/documents/orgMemberIndex/$(orgId + '_' + request.auth.uid)).data.get('ministryIds', []))
      );
    }
    // May the caller add a comment under this post? PUBLIC/unmarked = anyone; MEMBERS = members+followers; DEPARTMENT = dept only.
    function orgThreadCommentOk(postId) {
      let p = get(/databases/$(database)/documents/posts/$(postId)).data;
      return p.get('orgAudience', 'PUBLIC') == 'PUBLIC' ||
        (p.get('orgAudience', 'PUBLIC') == 'MEMBERS' && orgIsMemberOrFollower(p.authorOrgId)) ||
        (p.get('orgAudience', 'PUBLIC') == 'DEPARTMENT' && orgInDepartment(p.authorOrgId, p.get('orgDepartmentId', '')));
    }
    function orgThreadReadOk(postId) {
      let p = get(/databases/$(database)/documents/posts/$(postId)).data;
      return p.get('orgAudience', 'PUBLIC') != 'DEPARTMENT' || orgInDepartment(p.authorOrgId, p.get('orgDepartmentId', ''));
    }

    match /orgFollowers/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
        (followId == request.resource.data.orgId + '_' + request.auth.uid ||
         followId == request.resource.data.orgId + '__' + request.resource.data.get('ministryId', '') + '__' + request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || orgAdminOf(resource.data.orgId));
      allow update: if false;
    }

    match /orgMemberIndex/{indexId} {
      allow read: if isAuthenticated();
      // Marker for an ACTIVE membership. Self (joining) or org admin/pastor (adding/accepting).
      allow create, update: if isAuthenticated() && indexId == request.resource.data.orgId + '_' + request.resource.data.userId && (
        request.resource.data.userId == request.auth.uid ||
        orgPastorOrAdmin(request.resource.data.orgId) || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) || isAdmin()
      );
    }

    match /orgMemberships/{membershipId} {
      allow read: if isAuthenticated();
      // Join yourself as a plain member (PENDING/ACTIVE), via a valid role-setup invite, OR an org admin/pastor adds a member.
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid && (
          (request.resource.data.role == 'MEMBER' && (request.resource.data.status == 'PENDING' || !('roleKey' in request.resource.data)) && !('permissions' in request.resource.data) && !('isSenior' in request.resource.data)) ||
          ('inviteToken' in request.resource.data && inviteOk(request.resource.data))
        )) ||
        orgPastorOrAdmin(request.resource.data.orgId) ||
        isAdmin()
      );
      // Members may edit ONLY their own presentation fields — never role/status/permissions (closes self-promotion).
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'aboutInOrg', 'orgPhotoUrl', 'syncToProfile'])) ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
    }

    // ── Elevate ChMS (people / finance / attendance) ─────────────────────────────
    function chmsFinance(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('financeUids', []) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', []));
    }
    function chmsGivingRead(orgId) {
      return chmsFinance(orgId) || (isAuthenticated() && request.auth.uid in orgDoc(orgId).get('givingViewUids', []));
    }
    function chmsPeopleStaff(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', []) ||
        request.auth.uid in orgDoc(orgId).get('staffUids', []) ||
        request.auth.uid in orgDoc(orgId).get('leaderUids', []));
    }
    // Giving: finance/pastors write, trustees read. Gifts are never deleted — void instead.
    match /chmsContributions/{id} {
      // A giver may read ONLY their own gifts (linkedUid denormalized from their ChmsPerson at write time).
      allow read: if chmsGivingRead(resource.data.orgId) ||
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid);
      allow create: if chmsFinance(request.resource.data.orgId) && request.resource.data.enteredBy == request.auth.uid && request.resource.data.amount > 0;
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsBatches/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsPledges/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update, delete: if chmsFinance(resource.data.orgId);
    }
    // Finance Hub misc ledger docs (kind: PAYOUT | TRANSFER | STATEMENT_LOG | RECURRING). Never deleted.
    match /chmsFinanceMeta/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    // Immutable finance audit trail (who entered/voided/approved/exported what).
    match /chmsAudit/{id} {
      allow read: if chmsGivingRead(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Pastoral-care bridge: "reach out" flags created by finance WITHOUT amounts; pastors/staff read + resolve.
    match /chmsCareFlags/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) && !('amount' in request.resource.data);
      allow update: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow delete: if false;
    }
    match /chmsImports/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsFinance(request.resource.data.orgId) || chmsPeopleStaff(request.resource.data.orgId);
      allow update: if chmsFinance(resource.data.orgId) || chmsPeopleStaff(resource.data.orgId);
      allow delete: if false;
    }
    // People directory: staff/leaders read+write; finance reads/writes (to match givers); a person can read their own linked record.
    match /chmsPeople/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId) ||
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) || chmsFinance(request.resource.data.orgId);
      allow update: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId) ||
        // Self-service: a linked congregant may change ONLY contact + directory-privacy fields on their own record.
        (isAuthenticated() && resource.data.get('linkedUid', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'phone', 'address', 'preferredName', 'photoUrl', 'directoryVisible', 'updatedAt'])) ||
        // Claim: link an unlinked record to the caller's account using a valid, unused, unexpired claim token for THIS person.
        (isAuthenticated() && resource.data.get('linkedUid', '') == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid', 'claimToken', 'updatedAt']) &&
          request.resource.data.linkedUid == request.auth.uid &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.personId == id &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.orgId == resource.data.orgId &&
          !('usedBy' in get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data) &&
          get(/databases/$(database)/documents/chmsClaims/$(request.resource.data.claimToken)).data.expiresAt > request.time.toMillis());
      allow delete: if orgAdminOf(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', []));
    }
    // Claim tokens (doc id = unguessable token): staff mint them; the claimant reads by id and marks used.
    match /chmsClaims/{token} {
      allow get: if isAuthenticated();
      allow list: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && !('usedBy' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']) && request.resource.data.usedBy == request.auth.uid;
      allow delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Care/follow-up tasks (no private note content — staff only).
    match /chmsTasks/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Volunteer schedule: staff manage; an assignee may read their shift and respond (confirm / decline / swap).
    match /chmsShifts/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || (isAuthenticated() && request.auth.uid in resource.data.get('assignedUids', []));
      allow create: if chmsPeopleStaff(request.resource.data.orgId);
      allow update: if chmsPeopleStaff(resource.data.orgId) || (isAuthenticated() && request.auth.uid in resource.data.get('assignedUids', []) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignments', 'updatedAt']));
      allow delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Outbound message log.
    match /chmsMessages/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) && request.resource.data.sentBy == request.auth.uid;
      allow update, delete: if false;
    }
    match /chmsHouseholds/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) || chmsFinance(request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId) || chmsFinance(resource.data.orgId);
    }
    match /chmsAttendance/{id} {
      allow read: if chmsPeopleStaff(resource.data.orgId);
      allow create: if chmsPeopleStaff(request.resource.data.orgId) ||
        // Self check-in: a linked congregant may check THEMSELVES in.
        (isAuthenticated() && request.resource.data.personId is string &&
          get(/databases/$(database)/documents/chmsPeople/$(request.resource.data.personId)).data.get('linkedUid', '') == request.auth.uid &&
          get(/databases/$(database)/documents/chmsPeople/$(request.resource.data.personId)).data.orgId == request.resource.data.orgId);
      allow update, delete: if chmsPeopleStaff(resource.data.orgId);
    }
    // Pastoral care notes: PASTORAL = pastors/admins only; STAFF = staff; finance can never read notes.
    match /chmsNotes/{id} {
      allow read: if isAuthenticated() && (orgAdminOf(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', []) ||
        (resource.data.visibility == 'STAFF' && chmsPeopleStaff(resource.data.orgId)));
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid && chmsPeopleStaff(request.resource.data.orgId);
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // ── Elevate Accounting (double-entry) ────────────────────────────────────────
    function acctWrite(orgId) {
      return isAuthenticated() && (orgAdminOf(orgId) ||
        request.auth.uid in orgDoc(orgId).get('accountingUids', []) ||
        request.auth.uid in orgDoc(orgId).get('financeUids', []));
    }
    function acctRead(orgId) {
      return acctWrite(orgId) || (isAuthenticated() && (
        request.auth.uid in orgDoc(orgId).get('accountingViewUids', []) ||
        request.auth.uid in orgDoc(orgId).get('pastorUids', [])));
    }
    match /acctAccounts/{id} {
      // Department heads read the chart so their budget view can show account names (the chart is not sensitive).
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId);
      allow delete: if false;
    }
    // Journals are append-only: corrections are reversal entries. Only status/reversedBy may change.
    match /acctJournals/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedBy']);
      allow delete: if false;
    }
    match /acctVendors/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if acctWrite(resource.data.orgId);
      allow delete: if false;
    }
    // Expenses/bills/reimbursements: any staff/leader/accounting member may SUBMIT; approvers (dept heads,
    // pastors, accounting) read and decide; the submitter sees their own. Money state is accounting-only.
    match /acctExpenses/{id} {
      allow read: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid ||
        acctRead(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status in ['DRAFT', 'SUBMITTED'] && request.resource.data.amount > 0 && (
          acctWrite(request.resource.data.orgId) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('staffUids', []) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('leaderUids', []) ||
          request.auth.uid in orgDoc(request.resource.data.orgId).get('pastorUids', []));
      allow update: if isAuthenticated() && (
        acctWrite(resource.data.orgId) ||
        // submitter edits/withdraws their own before approval
        (resource.data.submittedBy == request.auth.uid && resource.data.status in ['DRAFT', 'SUBMITTED'] &&
          request.resource.data.status in ['DRAFT', 'SUBMITTED', 'VOID']) ||
        // department heads / pastors approve or reject (never mark paid)
        ((request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []) || request.auth.uid in orgDoc(resource.data.orgId).get('pastorUids', [])) &&
          resource.data.status == 'SUBMITTED' && request.resource.data.status in ['APPROVED', 'REJECTED'] &&
          request.resource.data.submittedBy == resource.data.submittedBy && request.resource.data.amount == resource.data.amount));
      allow delete: if false;
    }
    match /acctBankAccounts/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    match /acctBankTxns/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if acctWrite(resource.data.orgId);
    }
    match /acctBudgets/{id} {
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Budget Pulse: budgeted projects/campaigns (spend is tagged via projectId / fundId on journal lines + expenses).
    match /acctProjects/{id} {
      allow read: if acctRead(resource.data.orgId) || (isAuthenticated() && request.auth.uid in orgDoc(resource.data.orgId).get('leaderUids', []));
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Budget Pulse alerts: created by the server sweep (admin token) or finance clients; readers may only acknowledge/snooze.
    // Department heads read the alerts addressed to them via audienceUids (denormalised at creation).
    match /acctAlerts/{id} {
      allow read: if isAuthenticated() && (acctRead(resource.data.orgId) || request.auth.uid in resource.data.get('audienceUids', []));
      allow create: if acctWrite(request.resource.data.orgId);
      allow update: if isAuthenticated() && (acctRead(resource.data.orgId) || request.auth.uid in resource.data.get('audienceUids', [])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy', 'snoozedUntil']);
      allow delete: if false;
    }
    match /acctPeriods/{id} {
      allow read: if acctRead(resource.data.orgId);
      allow create, update: if acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    // Stripe-synced payouts + lines are written by the server (admin token); clients read only.
    match /chmsPayouts/{id} {
      allow read: if chmsGivingRead(resource.data.orgId) || acctRead(resource.data.orgId);
      allow create, update: if chmsFinance(request.resource.data.orgId) || acctWrite(request.resource.data.orgId);
      allow delete: if false;
    }
    match /chmsPayoutLines/{id} {
      allow read: if chmsGivingRead(resource.data.orgId) || acctRead(resource.data.orgId);
      allow write: if false;
    }

    // ── Elevate role-setup invites (link / QR / email). Doc id = unguessable token. ──
    match /orgInvites/{token} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && orgPastorOrAdmin(resource.data.orgId);
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid && (
        orgAdminOf(request.resource.data.orgId) ||
        (request.auth.uid in orgDoc(request.resource.data.orgId).get('pastorUids', []) && request.resource.data.roleKey != 'SENIOR_PASTOR') ||
        (request.auth.uid in orgDoc(request.resource.data.orgId).get('leaderUids', []) &&
          request.resource.data.roleKey in ['VOLUNTEER', 'PRAYER_WARRIOR', 'MEMBER', 'STAFF', 'MEDIA_TEAM'])
      );
      allow update: if isAuthenticated() && (
        // redeem: bump uses by exactly one
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) &&
          request.resource.data.uses == resource.data.uses + 1 && request.resource.data.uses <= resource.data.maxUses) ||
        // revoke
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) &&
          (resource.data.createdBy == request.auth.uid || orgPastorOrAdmin(resource.data.orgId)))
      );
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || orgPastorOrAdmin(resource.data.orgId));
    }

    // ── Content HQ — private DAM assets (files/docs/brand specs) ──────────────
    // scopeKind 'user' → the account owner; scopeKind 'org' → the org's admins/creator.
    match /orgAssets/{assetId} {
      function cxScopeOk(data) {
        return isAuthenticated() && (
          (data.scopeKind == 'user' && data.scopeId == request.auth.uid) ||
          (data.scopeKind == 'org' && (
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.admins ||
            get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.creatorId == request.auth.uid ||
            // Staff/moderators with MANAGE_CONTENT (denormalized staffUids; owner/admin-writable only).
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(data.scopeId)).data.get('staffUids', [])
          )) ||
          isAdmin()
        );
      }
      allow read: if cxScopeOk(resource.data);
      allow create: if cxScopeOk(request.resource.data) && request.resource.data.uploadedByUid == request.auth.uid;
      allow update: if cxScopeOk(resource.data) && cxScopeOk(request.resource.data);
      allow delete: if cxScopeOk(resource.data);
    }

    // Immutable revision records. Replacing a file creates a new version; it never
    // overwrites the version a reviewer approved.
    match /hqAssetVersions/{versionId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.uploadedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /hqComments/{commentId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.body is string && request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 4000;
      allow update: if canAccessHqAsset(resource.data.assetId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedByUid']);
      allow delete: if false;
    }

    match /hqReviewRequests/{reviewId} {
      allow read: if canAccessHqAsset(resource.data.assetId) ||
        (isAuthenticated() && request.auth.uid in resource.data.reviewerUids);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.requestedByUid == request.auth.uid;
      allow update: if canAccessHqAsset(resource.data.assetId) ||
        (isAuthenticated() && request.auth.uid in resource.data.reviewerUids &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decisions', 'status', 'completedAt']));
      allow delete: if false;
    }

    // Append-only asset audit. This is separate from the general org audit so an
    // asset can carry its complete evidence trail when delivered or exported.
    match /hqActivity/{eventId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /hqShareLinks/{shareId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow create: if canAccessHqAsset(request.resource.data.assetId) &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if canAccessHqAsset(resource.data.assetId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt', 'expiresAt', 'allowComments', 'allowApproval', 'allowDownload', 'requireEmail']);
      allow delete: if false;
    }

    // Account-free reviewer decisions. Written ONLY by the server (Admin creds) through the
    // tokenized share endpoints — guests never authenticate — so client writes stay closed.
    // The asset's owning scope can read them to see who approved / requested changes.
    match /hqGuestDecisions/{decisionId} {
      allow read: if canAccessHqAsset(resource.data.assetId);
      allow write: if false;
    }

    // Durable security audit (Wave 3): retention purges + quota rejections. Written ONLY
    // by the server (Admin creds, which bypass rules) and it must outlive the assets it
    // records, so clients get no access at all.
    match /hqAuditLog/{entryId} {
      allow read, write: if false;
    }

    // ── Music sync-license grants — created only by the Stripe webhook (Admin SDK) ──
    // The buyer and the rights owner can READ their grants; clients never write.
    match /syncLicenseGrants/{grantId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.rightsOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Church/org prayer wall.
    // Teacher versions of lessons. The built lesson is never modified: a version is the teacher's own record, scoped to classes they own.
    // Readable by any signed-in user (it is lesson text, no personal data). Only a teacher account that owns every class it names can write it,
    // so a student cannot publish a version to their classmates. At most 5 classes per version.
    match /lessonOverlays/{overlayId} {
      function isTeacherAccount() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'TEACHER'; }
      function ownsClass(id) { return get(/databases/$(database)/documents/classrooms/$(id)).data.ownerId == request.auth.uid; }
      function classesOk(ids) {
        return ids.size() <= 5
          && (ids.size() < 1 || ownsClass(ids[0]))
          && (ids.size() < 2 || ownsClass(ids[1]))
          && (ids.size() < 3 || ownsClass(ids[2]))
          && (ids.size() < 4 || ownsClass(ids[3]))
          && (ids.size() < 5 || ownsClass(ids[4]));
      }
      function validDoc() {
        return request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() < 30000
          && request.resource.data.visibility in ['class', 'shared']
          && request.resource.data.classIds is list && classesOk(request.resource.data.classIds);
      }
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacherAccount() && validDoc();
      allow update: if isAuthenticated() && isTeacherAccount() && resource.data.authorUid == request.auth.uid && validDoc();
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // Church education programs (Sunday school / Bible study plans). Anyone signed in can read; only the church's admins write.
    match /churchPrograms/{programId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid
        && (request.auth.uid in get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.admins
            || request.auth.uid == get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.creatorId);
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.admins);
    }

    // Ora wellbeing in education. classWeather holds anonymous counters only (no user ids).
    match /classWeather/{wid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.keys().hasOnly(['classId', 'day', 'counts']);
    }
    // "I need a hand": the student writes it for chosen grown-ups; only those grown-ups (and the student) can read it.
    match /wellbeingRequests/{rid} {
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || request.auth.uid in resource.data.toUids);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.toUids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']);
    }

    match /churchPrayers/{prayerId} {
      // Public wall prayers: any signed-in user. Private requests: author, pastors/ministers, prayer warriors, admins.
      allow read: if isAuthenticated() && (
        resource.data.get('isPrivate', false) == false ||
        resource.data.authorId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        request.auth.uid in orgDoc(resource.data.orgId).get('prayerUids', []) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        // Anyone may add/remove themselves from the praying list.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayingIds']) ||
        // Org admins + pastors/ministers may mark answered.
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        orgPastorOrAdmin(resource.data.orgId) ||
        isAdmin()
      );
    }

    match /clubPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        // Like toggles — array only grows/shrinks by the requesting user's UID
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         (request.resource.data.likes.hasAll(resource.data.likes) || resource.data.likes.hasAll(request.resource.data.likes))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount'])) ||
        // Admins can pin/unpin posts
        (request.auth.uid in get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.admins &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /clubGallery/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploaderId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || isAdmin());
    }

    match /clubChat/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    match /clubEvents/{eventId} {
      allow read: if isAuthenticated();
      // hostId is the field used by ClubEvent (not creatorId)
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        // RSVP updates — attendeeIds only
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // SANCTUARY (Patreon / Kickstarter / GoFundMe hybrid)
    // ===============================================================

    // Sanctuary identity — one per account (doc id == ownerId).
    match /sanctuaries/{ownerId} {
      allow read: if true;   // discoverable; PRIVATE gating is enforced in-app
      allow create, delete: if isOwner(ownerId) || isAdmin();
      allow update: if isOwner(ownerId) || isAdmin() ||
        // Crowdfunding contributions may bump only the campaign totals.
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campaign', 'updatedAt']));
    }

    // Membership tiers — owned by the creator.
    match /sanctuaryTiers/{tierId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin() ||
        // Member joins/leaves adjust the count only.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])));
    }

    // A fan's membership record.
    match /sanctuaryMemberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.memberId == request.auth.uid || isAdmin());
    }

    // Exclusive content (tier-gated or à la carte).
    match /sanctuaryContent/{contentId} {
      allow read: if isAuthenticated();  // access to the URL is gated in-app / server-side
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin() ||
        // Like/comment counters.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']));
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // The sanctuary's gated feed.
    match /sanctuaryPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Gated media wall.
    match /sanctuaryGallery/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || isAdmin());
    }

    // Scheduled member events.
    match /sanctuaryEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid || isAdmin() ||
        // RSVP toggles only touch the attendee list.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']));
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    // Member chat (lounge or gated channel).
    match /sanctuaryChat/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // À la carte purchases — a buyer's private receipts (written by the Stripe
    // webhook via service account; client creates only for free/test unlocks).
    match /sanctuaryPurchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Campaign pledges — readable so the banner can sum live totals; only the
    // webhook (service account) writes them.
    match /sanctuaryPledges/{pledgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // DISCUSSION (Reddit-style forum)
    // ===============================================================

    match /discussionBoards/{boardId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postCount', 'memberCount', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /discussionPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Author can edit content
        resource.data.authorId == request.auth.uid ||
        // Votes: only allow increment/decrement by exactly 1 (prevents vote stuffing)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) &&
         math.abs(request.resource.data.upvotes - resource.data.upvotes) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downvotes']) &&
         math.abs(request.resource.data.downvotes - resource.data.downvotes) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
         math.abs(request.resource.data.upvotes - resource.data.upvotes) <= 1 &&
         math.abs(request.resource.data.downvotes - resource.data.downvotes) <= 1) ||
        // Comment count: only increment by 1
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
         request.resource.data.commentCount == resource.data.commentCount + 1) ||
        // Moderation flags (reportedBy, isRemoved)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy']) &&
         request.resource.data.reportedBy.hasAll(resource.data.reportedBy)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRemoved', 'removedReason', 'body']) &&
         isAdmin()) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /discussionComments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) &&
         math.abs(request.resource.data.upvotes - resource.data.upvotes) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().affectedKeys().hasOnly(['downvotes']) &&
         math.abs(request.resource.data.downvotes - resource.data.downvotes) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
         request.resource.data.replyCount == resource.data.replyCount + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy']) &&
         request.resource.data.reportedBy.hasAll(resource.data.reportedBy)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRemoved', 'body']) &&
         isAdmin()) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /discussionVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /discussionAliases/{aliasId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // LIVE STREAMS (WebRTC signaling via Firestore)
    // ===============================================================
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Chat messages — public read, authenticated write
      match /chat/{msgId} {
        allow read: if true;
        allow create: if isAuthenticated();
      }

      // Viewer signaling docs — authenticated users can join as a viewer
      match /viewers/{viewerId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();

        match /offer/{docId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
        match /answer/{docId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
        match /broadcaster_candidates/{candidateId} {
          allow read: if true;
          allow create: if isAuthenticated();
        }
        match /viewer_candidates/{candidateId} {
          allow read: if true;
          allow create: if isAuthenticated();
        }
      }
    }

    // ===============================================================
    // FAST CHANNEL SCHEDULES
    // ===============================================================
    // One doc per user — the owner controls it; everyone can read (needed for viewers)
    match /fast_channel_schedules/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // FAST channel identity (name/number/category/logo) — public read for Live rails & EPG feeds.
    match /fast_channels/{ownerId} {
      allow read: if true;
      allow write: if isOwner(ownerId) || isAdmin();
    }

    // Linked internet-radio stations a creator brings on-platform by link — public read for the
    // Radio directory & profiles; only the station's owner (or an admin) may create/change it.
    match /linked_stations/{stationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.ownerUid) || isAdmin();
      allow update, delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Broadcast-out destinations (Restream / per-platform RTMP). SECRET-BEARING (stream keys), so
    // read is owner-only — NOT public like linked_stations. One doc per account.
    match /broadcast_destinations/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Up-to-3 concurrent sources + the saved-feed library — public read for the "Live Now" rails.
    match /channel_sources/{ownerId} {
      allow read: if true;
      allow write: if isOwner(ownerId) || isAdmin();
    }

    // ===============================================================
    // CHANNEL BUMPERS
    // ===============================================================
    match /channel_bumpers/{bumperId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // ===============================================================
    // FAST CHANNEL ASSET GRANTS
    // ===============================================================
    // fromUserId grants toUserId access to assets
    match /fast_channel_access/{grantId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.toUserId == '*' ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid || isAdmin();
    }

    // ===============================================================
    // FAST CHANNEL PLATFORM LIBRARY
    // ===============================================================
    match /fast_channel_library/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUserId == request.auth.uid || isAdmin();
    }

    // ===============================================================
    // WORLD CUP 2026 — Picks, Follows, Fan Clubs
    // ===============================================================

    // Player follows (WC2026 current players)
    match /wcFollowedPlayers/{userId}/players/{playerId} {
      allow read:   if isOwner(userId);
      allow write:  if isOwner(userId);
    }

    // Player follows (historical players — WC2022/2018)
    match /wcHistPlayerFollows/{userId}/players/{playerId} {
      allow read:   if isOwner(userId);
      allow write:  if isOwner(userId);
    }

    // Free-to-play picks
    match /wcPicks/{userId} {
      allow read:  if isAuthenticated();   // leaderboard visibility
      allow write: if isOwner(userId);
    }

    // Club cover media — cycling hero images/videos, admin-managed
    match /clubCoverMedia/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Club cover display settings (mode, single item, slideshow order)
    match /clubCoverSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Sacred Library: per-user Bible notes (doc id = {uid}__{ref}) ─────────────
    // Lectio service notes — the record of which passages a member was shown,
    // and when. One doc per user per service (id = {uid}__{sessionId}).
    // OWNER-ONLY IN BOTH DIRECTIONS: what someone was shown, and when they were
    // in a service, is a fact about their spiritual life. The church must never
    // be able to read this — it is the member's copy, and it leaves with them.
    match /lectioServiceNotes/{noteId} {
      allow read:   if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && noteId == request.auth.uid + '__' + request.resource.data.sessionId
                    && request.resource.data.notes is list
                    && request.resource.data.notes.size() <= 200;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /bibleNotes/{noteId} {
      allow read:   if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && noteId == request.auth.uid + '__' + request.resource.data.ref
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 5000;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── WC Video Chat Rooms ──────────────────────────────────────────────────────
    // Per-match World Cup fan rooms: room doc + members / chat / polls subcollections.
    // Publicly readable; any signed-in fan can join (members), chat, seed/vote polls.
    match /wcMatchRooms/{matchId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /wcVideoRooms/{clubId} {
      allow read: if isAuthenticated();
      // Room doc: any authenticated user can create/update (join/leave session state)
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      // Presence: each user manages their own presence doc
      match /presence/{uid} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow delete: if isAuthenticated() && request.auth.uid == uid;
        allow update: if isAuthenticated() && request.auth.uid == uid;
      }

      // WebRTC signaling: any participant in the room can read/write
      match /signals/{pairKey} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Watchers (spectators): signed-in OR guest (anonymous) viewers who follow
      // the conversation without taking a camera seat. Each manages their own doc.
      match /watchers/{watcherId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == watcherId;
        allow update: if isAuthenticated() && request.auth.uid == watcherId;
        allow delete: if isAuthenticated() && request.auth.uid == watcherId;
      }

      // Room chat: everyone in the room reads; only *real* (non-anonymous)
      // accounts may post — guests are read-only.
      match /chat/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // COMMUNITY PLAYLISTS — public playlist sharing across the platform
    // ===============================================================
    match /communityPlaylists/{playlistId} {
      allow read: if true;
      // Owner can create/update/delete their own shared playlists
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        // Any authenticated user can increment likes/plays
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Fan clubs — unofficial per-nation communities
    match /wcFanClubs/{clubId} {
      allow read: if true;
      allow write: if isAdmin();

      // Members subcollection — anyone can join/leave their own record
      match /members/{memberId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == memberId;
        allow delete: if isAuthenticated() && request.auth.uid == memberId;
      }

      // Posts — authenticated users can post, only own posts can be deleted
      match /posts/{postId} {
        allow read:   if true;
        allow create: if isAuthenticated()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow delete: if isAuthenticated()
                      && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // CONTENT SAFETY — user reports
    // ===============================================================
    // Anyone signed in can file a report; reports are only readable by staff.
    match /content_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && !(exists(/databases/$(database)/documents/user_sanctions/$(request.auth.uid))
                         && get(/databases/$(database)/documents/user_sanctions/$(request.auth.uid)).data.get('reportBlocked', false) == true)
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 40
                    && request.resource.data.contentId is string
                    && request.resource.data.contentId.size() <= 300
                    && (!('details' in request.resource.data) || request.resource.data.details.size() <= 2000)
                    && (!('snapshot' in request.resource.data) || request.resource.data.snapshot.size() <= 600);
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // COMMUNITY NOTES — crowd-sourced context on posts
    // ===============================================================
    // Contributors propose notes; raters score them; a note publishes when it
    // is found helpful by raters who usually disagree (bridge scoring,
    // computed client/agent-side and finalized by staff/admin tooling).
    match /community_notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.contentId is string
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() >= 30
                    && request.resource.data.summary.size() <= 1200
                    && request.resource.data.sources is list
                    && request.resource.data.sources.size() >= 1
                    && request.resource.data.status == 'NEEDS_RATINGS';
      // Authors may edit only while gathering ratings; status/score fields are
      // managed by admin tooling.
      allow update: if isAdmin() ||
                    (isAuthenticated() && resource.data.authorId == request.auth.uid
                     && resource.data.status == 'NEEDS_RATINGS'
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary', 'sources', 'updatedAt']));
      allow delete: if isAdmin();

      match /ratings/{raterId} {
        allow read: if true;
        // One rating per user, written as themselves, never on their own note
        allow create, update: if isAuthenticated()
                      && request.auth.uid == raterId
                      && request.resource.data.raterId == request.auth.uid
                      && request.resource.data.helpful in ['HELPFUL', 'SOMEWHAT', 'NOT_HELPFUL']
                      && get(/databases/$(database)/documents/community_notes/$(noteId)).data.authorId != request.auth.uid;
        allow delete: if isAuthenticated() && request.auth.uid == raterId;
      }
    }

    // ── Live streams — WebRTC signaling, counters, chat ──────────────────────
    // Without this block the default deny made EVERY live-stream operation fail
    // silently (creating the stream doc, viewer signaling, chat, view counts).
    // Living knowledge (Law + Medicine): public records and review queue. Written by the server job only
    // (service account bypasses rules); admins/staff may mark an impact reviewed or dismissed.
    match /knowledge_items/{itemId} { allow read: if true; allow write: if false; }
    match /knowledge_state/{cursorId} { allow read, write: if false; }
    match /knowledge_impacts/{impactId} {
      allow read: if true;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'reviewedBy', 'reviewedAt', 'note']);
      allow create, delete: if false;
    }

    match /streams/{streamId} {
      // Private producer streams (Artist Manager › Film) are scoped clubId "prod:<prodId>"
      // and marked isPrivate — readable ONLY by the broadcaster and members of that
      // production. Every other stream keeps its public/unlisted read behavior.
      function isProdPrivateStream() {
        return resource.data.isPrivate == true
          && resource.data.clubId is string
          && resource.data.clubId.split(':').size() == 2
          && resource.data.clubId.split(':')[0] == 'prod';
      }
      function prodStreamProdId() {
        return resource.data.clubId.split(':')[1];
      }
      function canReadProdStream() {
        return isAuthenticated() && (
          resource.data.ownerUid == request.auth.uid
          || (
            exists(/databases/$(database)/documents/productions/$(prodStreamProdId()))
            && (
              get(/databases/$(database)/documents/productions/$(prodStreamProdId())).data.ownerUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/productions/$(prodStreamProdId())).data.memberUids is list
                && request.auth.uid in get(/databases/$(database)/documents/productions/$(prodStreamProdId())).data.memberUids
              )
            )
          )
        );
      }

      allow read: if !isProdPrivateStream() || canReadProdStream();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
        // Non-owners (viewers) may bump the public counters, request to come on stage
        // (guestRequests), and leave the stage (guests). The host owns approving requests.
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewerCount', 'totalViews', 'likeCount', 'peakViewers', 'guestRequests', 'guests'])
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Signaling (viewers / ICE candidates) + live chat.
      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Unified real-time backbone (rtcCore): mesh calls, video rooms, talk rooms.
    // Presence + per-edge WebRTC signaling (offer/answer/ICE). Any signed-in
    // participant can read the session and write signaling within it.
    match /rtc_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Ambient presence ("who's here right now") for any surface — no media.
    // Anyone can read the count; you may only write your own heartbeat.
    match /presence/{key}/here/{uid} {
      allow read: if true;
      allow write: if isAuthenticated() && uid == request.auth.uid;
    }

    // Synchronized parties (watch-along / read-along / listening party). The host broadcasts a
    // playback state; the audience reads it and follows locally. Public read (shareable/joinable);
    // only the host may create/update/end their own party.
    // Service recaps (Vespers). Built from the Kairos cue log when a service
    // ends. Public read — a member must be able to open their briefing without
    // signing in. Only the host who filed it may write. NOTE: this doc holds
    // only what happened in public (passages, timecodes, the summary). What a
    // person highlighted or wrote is folded in on their own device and is
    // never stored here.
    match /serviceRecaps/{recapId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    // Live scripture cue sessions (Kairos). The operator broadcasts the passage
    // on screen; phones in the room and stream viewers read it and resolve
    // locally against their own clock. Public read — a congregation must be able
    // to follow along without an account. Only the host may write.
    match /scriptureSessions/{sessionId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    match /parties/{partyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    // ── Terra: the parcel spine ────────────────────────────────────────────
    // Public record, publicly readable — that is the entire point of the layer.
    // Writes come from the server-side ingestion worker or an admin; no client
    // may author the spine, because a forged parcel or civic record would be
    // indistinguishable from a real one in the UI.
    match /terraParcels/{parcelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /terraCivic/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Building energy/water benchmarking rollups, keyed by parcel. Public record
    // (the ordinance requires reporting), same write posture as the spine.
    match /terraEnergy/{parcelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Active business licence register — public record, drives verification.
    match /terraBusiness/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Rental compliance (registered vs certified) — a tenant's own building.
    match /terraRental/{parcelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Zoning rules are hand-encoded from the ordinance and drive a buildability
    // estimate — admin-only, and versioned rather than edited in place.
    match /terraZoningRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /terraIngestionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Open Listing Records. Publicly readable (they feed the public OLR feed).
    // A listing may be created or edited by its own lister or by an admin; the
    // content hash and revision are recomputed server-side on publish, so a
    // client cannot forge provenance by writing those fields directly.
    match /terraListings/{listingKey} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.data.X_Terra_ListerUid == request.auth.uid;
      allow update, delete: if isAuthenticated()
                    && (resource.data.data.X_Terra_ListerUid == request.auth.uid || isAdmin());
    }

    match /note_contributors/{uid} {
      allow read: if true;
      // Users enroll themselves; reputation fields are managed by admin tooling.
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'agreedToGuidelines'])
                    && request.resource.data.agreedToGuidelines == true;
      allow update: if isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // Film Production Management — Artist Manager › Film › On-Set suite.
    // A production is readable by its owner and any crew member listed in
    // memberUids (so signed-in crew get their daily briefs and offsite
    // producers can follow along). Only the owner mutates the production doc.
    // ===============================================================
    match /productions/{prodId} {
      function isProdOwner() {
        return isAuthenticated() && resource.data.get('isShowcase', false) != true && resource.data.ownerUid == request.auth.uid;
      }
      function isProdMember() {
        return isAuthenticated() && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );
      }
      function parentProd() {
        return get(/databases/$(database)/documents/productions/$(prodId)).data;
      }
      function isParentOwner() {
        return isAuthenticated() && parentProd().get('isShowcase', false) != true && parentProd().ownerUid == request.auth.uid;
      }
      function isParentMember() {
        return isAuthenticated() && (
          parentProd().ownerUid == request.auth.uid ||
          (parentProd().memberUids is list && request.auth.uid in parentProd().memberUids)
        );
      }
      function isParentWritableMember() {
        return isParentMember() && parentProd().get('isShowcase', false) != true;
      }
      function hasProdPermission(permission) {
        let p = parentProd();
        return isAuthenticated() && p.get('isShowcase', false) != true && (
          p.ownerUid == request.auth.uid ||
          (p.authority is map
            && request.auth.uid in p.authority
            && p.authority[request.auth.uid].permissions is list
            && permission in p.authority[request.auth.uid].permissions)
        );
      }
      function canManageBreakdownDepartment(department) {
        let p = parentProd();
        return isAuthenticated() && p.get('isShowcase', false) != true && (
          p.ownerUid == request.auth.uid ||
          (p.authority is map && request.auth.uid in p.authority &&
            p.authority[request.auth.uid].department == department &&
            p.authority[request.auth.uid].permissions is list &&
            'MANAGE_DEPARTMENT_BREAKDOWN' in p.authority[request.auth.uid].permissions)
        );
      }

      allow read: if isProdMember();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isProdOwner() ||
                       (hasProdPermission('EDIT_SCRIPT_BREAKDOWN') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedScriptId', 'currentDraftId', 'updatedAt'])) ||
                       (hasProdPermission('MANAGE_HIRING') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                       (hasProdPermission('MANAGE_SCHEDULE') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedScheduleId', 'approvedScheduleVersion', 'totalDays', 'updatedAt'])) ||
                       ((hasProdPermission('MANAGE_ROSTER') || hasProdPermission('MANAGE_SCHEDULE')) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatProvisionedAt', 'chatChannelKeys', 'updatedAt'])) ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                        request.auth.uid in request.resource.data.memberUids &&
                        getAfter(/databases/$(database)/documents/productions/$(prodId)/members/$(request.auth.uid)).data.uid == request.auth.uid) ||
                       isAdmin();
      allow delete: if isProdOwner() || isAdmin();

      // Roster, scenes, call sheets, tasks, craft menu — owner-managed, member-readable.
      match /members/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if hasProdPermission('MANAGE_ROSTER') || hasProdPermission('MANAGE_HIRING') ||
          (isAuthenticated() && docId == request.auth.uid && request.resource.data.uid == request.auth.uid &&
           request.resource.data.inviteToken is string &&
           get(/databases/$(database)/documents/productionInvites/$(request.resource.data.inviteToken)).data.productionId == prodId &&
           get(/databases/$(database)/documents/productionInvites/$(request.resource.data.inviteToken)).data.active == true &&
           get(/databases/$(database)/documents/productionInvites/$(request.resource.data.inviteToken)).data.expiresAt > request.time.toMillis()) || isAdmin();
        allow update, delete: if hasProdPermission('MANAGE_ROSTER') || isAdmin();
      }
      match /scenes/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('EDIT_SCRIPT_BREAKDOWN') || isAdmin();
      }
      match /breakdownElements/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if request.resource.data.id == docId &&
          request.resource.data.productionId == prodId &&
          request.resource.data.department is string &&
          request.resource.data.occurrences is list &&
          (!('attachments' in request.resource.data) || request.resource.data.attachments is list) &&
          request.resource.data.status in ['SUGGESTED', 'APPROVED', 'ASSIGNED', 'READY', 'BLOCKED', 'OMITTED'] &&
          (hasProdPermission('EDIT_SCRIPT_BREAKDOWN') ||
           canManageBreakdownDepartment(request.resource.data.department) || isAdmin());
        allow update: if request.resource.data.id == resource.data.id &&
          request.resource.data.productionId == resource.data.productionId &&
          (!('attachments' in request.resource.data) || request.resource.data.attachments is list) &&
          request.resource.data.status in ['SUGGESTED', 'APPROVED', 'ASSIGNED', 'READY', 'BLOCKED', 'OMITTED'] &&
          (hasProdPermission('EDIT_SCRIPT_BREAKDOWN') ||
           (canManageBreakdownDepartment(resource.data.department) &&
            request.resource.data.department == resource.data.department) || isAdmin());
        allow delete: if hasProdPermission('EDIT_SCRIPT_BREAKDOWN') ||
          canManageBreakdownDepartment(resource.data.department) || isAdmin();
      }
      // Approved script snapshots are immutable. Revisions create a new draft.
      match /scriptDrafts/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if hasProdPermission('EDIT_SCRIPT_BREAKDOWN') || isAdmin();
        allow update, delete: if false;
      }
      // Append-only audit trail for cross-tool workflow transitions.
      match /workflowEvents/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentOwner() || hasProdPermission('EDIT_SCRIPT_BREAKDOWN') ||
          hasProdPermission('MANAGE_DEPARTMENT_BREAKDOWN') ||
          hasProdPermission('MANAGE_SCHEDULE') || hasProdPermission('MANAGE_CALL_SHEETS') ||
          hasProdPermission('MANAGE_ROSTER') || hasProdPermission('MANAGE_HIRING') || isAdmin();
        allow update, delete: if false;
      }
      match /budgetLines/{docId} {
        allow read: if hasProdPermission('MANAGE_BUDGET') || (isParentMember() && parentProd().get('isShowcase', false) == true) || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_BUDGET') || isAdmin();
      }
      // Production finance (components/film/ProductionFinance): budget (single doc `main`) + logged costs.
      // Owner / MANAGE_BUDGET holders only — no crew-wide read.
      match /budget/{docId} {
        allow read, create, update, delete: if hasProdPermission('MANAGE_BUDGET') || isAdmin();
      }
      match /costs/{docId} {
        allow read, create, update, delete: if hasProdPermission('MANAGE_BUDGET') || isAdmin();
      }
      match /locations/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_LOCATIONS') || isAdmin();
      }
      match /festivals/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_POST') || isAdmin();
      }
      // Phone, address, tax and emergency data live separately from the public roster.
      match /memberPrivate/{memberUid} {
        allow read: if isAuthenticated() && (
          request.auth.uid == memberUid || hasProdPermission('VIEW_SENSITIVE_CONTACTS') || isAdmin()
        );
        allow create, update: if isAuthenticated() && (
          request.auth.uid == memberUid || hasProdPermission('MANAGE_ROSTER') || isAdmin()
        );
        allow delete: if hasProdPermission('MANAGE_ROSTER') || isAdmin();
      }
      match /callsheets/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_CALL_SHEETS') || isAdmin();
      }
      match /schedulePlans/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if (hasProdPermission('MANAGE_SCHEDULE') &&
          request.resource.data.id == docId && request.resource.data.productionId == prodId) || isAdmin();
        allow update, delete: if hasProdPermission('MANAGE_SCHEDULE') || isAdmin();
      }
      match /scheduleConstraints/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if (hasProdPermission('MANAGE_SCHEDULE') &&
          request.resource.data.id == docId && request.resource.data.productionId == prodId) || isAdmin();
        allow update, delete: if hasProdPermission('MANAGE_SCHEDULE') || isAdmin();
      }
      match /recipientDeliveries/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if (hasProdPermission('MANAGE_CALL_SHEETS') &&
          request.resource.data.id == docId && request.resource.data.productionId == prodId) || isAdmin();
        allow update: if hasProdPermission('MANAGE_CALL_SHEETS') ||
          (isParentWritableMember() && resource.data.memberUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt', 'confirmedAt', 'problemNote', 'updatedAt'])) || isAdmin();
        allow delete: if hasProdPermission('MANAGE_CALL_SHEETS') || isAdmin();
      }
      match /callSheetTemplates/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if (hasProdPermission('MANAGE_CALL_SHEETS') &&
          request.resource.data.id == docId && request.resource.data.productionId == prodId) || isAdmin();
        allow update, delete: if hasProdPermission('MANAGE_CALL_SHEETS') || isAdmin();
      }
      match /memberNotes/{memberUid} {
        allow read: if isAuthenticated() && request.auth.uid == memberUid;
        allow create, update: if isParentWritableMember() && request.auth.uid == memberUid &&
          request.resource.data.uid == request.auth.uid && request.resource.data.productionId == prodId;
        allow delete: if isParentWritableMember() && request.auth.uid == memberUid;
      }
      match /radioTransmissions/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentWritableMember() && request.resource.data.id == docId &&
          request.resource.data.productionId == prodId && request.resource.data.fromUid == request.auth.uid;
        allow delete: if (isParentWritableMember() && resource.data.fromUid == request.auth.uid) ||
          hasProdPermission('MANAGE_ROSTER') || isAdmin();
        allow update: if false;
      }
      match /tasks/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_TASKS') || isAdmin();
      }
      match /decisions/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentWritableMember() && request.resource.data.id == docId &&
          request.resource.data.productionId == prodId && request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 300 &&
          request.resource.data.status in ['OPEN', 'DECIDED'];
        allow update: if request.resource.data.id == resource.data.id &&
          request.resource.data.productionId == resource.data.productionId &&
          request.resource.data.authorUid == resource.data.authorUid &&
          ((isParentWritableMember() && resource.data.authorUid == request.auth.uid) ||
           hasProdPermission('MANAGE_SCHEDULE') || isAdmin());
        allow delete: if (isParentWritableMember() && resource.data.authorUid == request.auth.uid) ||
          hasProdPermission('MANAGE_SCHEDULE') || isAdmin();
      }
      match /alerts/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentWritableMember() && request.resource.data.id == docId &&
          request.resource.data.productionId == prodId && request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 300 &&
          request.resource.data.severity in ['INFO', 'IMPORTANT', 'URGENT'] && request.resource.data.status in ['ACTIVE', 'RESOLVED'];
        allow update: if request.resource.data.id == resource.data.id &&
          request.resource.data.productionId == resource.data.productionId &&
          request.resource.data.authorUid == resource.data.authorUid &&
          ((isParentWritableMember() && resource.data.authorUid == request.auth.uid) ||
           hasProdPermission('MANAGE_ROSTER') || isAdmin());
        allow delete: if (isParentWritableMember() && resource.data.authorUid == request.auth.uid) ||
          hasProdPermission('MANAGE_ROSTER') || isAdmin();
      }
      match /artifactAcknowledgements/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentWritableMember() && request.resource.data.id == docId &&
          request.resource.data.productionId == prodId && request.resource.data.uid == request.auth.uid &&
          (!('actionId' in request.resource.data) || request.resource.data.actionId is string) &&
          request.resource.data.entityType in ['TASK', 'SCENE', 'BREAKDOWN', 'CALL_SHEET', 'SCHEDULE', 'DECISION', 'ALERT', 'MEMBER', 'LOCATION'] &&
          request.resource.data.state in ['ACKNOWLEDGED', 'NEEDS_CLARIFICATION'];
        allow update: if isParentWritableMember() && resource.data.uid == request.auth.uid &&
          request.resource.data.id == resource.data.id && request.resource.data.uid == resource.data.uid &&
          request.resource.data.productionId == resource.data.productionId &&
          request.resource.data.entityType == resource.data.entityType && request.resource.data.entityId == resource.data.entityId &&
          request.resource.data.get('actionId', '') == resource.data.get('actionId', '') &&
          request.resource.data.state in ['ACKNOWLEDGED', 'NEEDS_CLARIFICATION'];
        allow delete: if (isParentWritableMember() && resource.data.uid == request.auth.uid) ||
          hasProdPermission('MANAGE_ROSTER') || isAdmin();
      }
      match /productionActions/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if request.resource.data.id == docId && request.resource.data.productionId == prodId &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.requiredPermission is string &&
          request.resource.data.status == 'READY' && request.resource.data.entity is map &&
          request.resource.data.routeChannelKeys is list && request.resource.data.targetUids is list &&
          request.resource.data.requiredAcknowledgementUids is list &&
          (hasProdPermission(request.resource.data.requiredPermission) ||
           (isParentWritableMember() && request.resource.data.trigger == 'SAFETY_ALERT' &&
            request.resource.data.routeChannelKeys == ['safety']) ||
           (isParentWritableMember() && request.resource.data.trigger == 'MEMBER_JOINED' &&
            request.resource.data.entity.entityType == 'MEMBER' && request.resource.data.entity.entityId == request.auth.uid &&
            request.resource.data.routeChannelKeys == ['general']) ||
           (request.resource.data.trigger == 'BREAKDOWN_BLOCKED' && request.resource.data.department is string &&
            request.resource.data.departmentChannel is string && request.resource.data.departmentChannel.matches('dept-.*') &&
            request.resource.data.routeChannelKeys.hasOnly([request.resource.data.departmentChannel, 'safety', 'crew-help']) &&
            canManageBreakdownDepartment(request.resource.data.department)) || isAdmin());
        allow update: if request.resource.data.id == resource.data.id &&
          request.resource.data.productionId == resource.data.productionId &&
          request.resource.data.actorUid == resource.data.actorUid &&
          request.resource.data.requiredPermission == resource.data.requiredPermission &&
          request.resource.data.entity == resource.data.entity &&
          request.resource.data.trigger == resource.data.trigger &&
          request.resource.data.routeChannelKeys == resource.data.routeChannelKeys &&
          request.resource.data.targetUids == resource.data.targetUids &&
          request.resource.data.requiredAcknowledgementUids == resource.data.requiredAcknowledgementUids &&
          request.resource.data.get('department', '') == resource.data.get('department', '') &&
          request.resource.data.get('departmentChannel', '') == resource.data.get('departmentChannel', '') &&
          request.resource.data.status in ['READY', 'PUBLISHING', 'PUBLISHED', 'ESCALATED', 'CANCELLED'] &&
          (hasProdPermission(resource.data.requiredPermission) || hasProdPermission('MANAGE_ROSTER') ||
           (isParentWritableMember() && resource.data.actorUid == request.auth.uid && resource.data.trigger == 'SAFETY_ALERT') ||
           (isParentWritableMember() && resource.data.actorUid == request.auth.uid && resource.data.trigger == 'MEMBER_JOINED' &&
            resource.data.entity.entityType == 'MEMBER' && resource.data.entity.entityId == request.auth.uid) ||
           (resource.data.actorUid == request.auth.uid && resource.data.trigger == 'BREAKDOWN_BLOCKED' && resource.data.department is string &&
            canManageBreakdownDepartment(resource.data.department)) || isAdmin());
        allow delete: if isParentOwner() || isAdmin();
      }
      match /craftMenu/{docId} {
        allow read: if isParentMember() || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_CRAFT') || isAdmin();
      }
      match /dprs/{docId} {
        allow read: if hasProdPermission('MANAGE_REPORTS') || (isParentMember() && parentProd().get('isShowcase', false) == true) || isAdmin();
        allow create, update, delete: if hasProdPermission('MANAGE_REPORTS') || isAdmin();
      }

      // Craft orders — any crew member may place & cancel their own request;
      // the owner (or on-set concierge) advances order status for everyone.
      match /craftOrders/{orderId} {
        allow read: if isParentMember() || isAdmin();
        allow create: if isParentWritableMember()
                      && request.resource.data.requestedByUid == request.auth.uid;
        allow update, delete: if hasProdPermission('MANAGE_CRAFT')
                      || (isParentWritableMember() && resource.data.requestedByUid == request.auth.uid)
                      || isAdmin();
      }
    }

    // ── Identifier registry (opt-in rights layer) ─────────────────────────────
    // Works, editions, releases and the subject→triple index. Public read: a rights
    // record is meant to be citable and checkable by anyone (that is the whole point of
    // a registry). Writes are owner-only, and ownerUid is immutable once set so a record
    // cannot be reassigned to another account.
    match /registryWorks/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /registryManifestations/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /registryProducts/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }
    // subjectKey (e.g. BOOK_abc123) → { workId, manifestationId, productId }. Never
    // deletable by a client: losing the index would orphan a work's whole rights record.
    match /registryRefs/{subjectKey} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // PLAJAH ACADEMIA — THE INTEGRITY WALL
    //
    // Core invariant: NO rule below grants an Independent-persona (creator/checkout) context
    // any read of districtPersona data. The only bridge is the server's conflict-check
    // endpoint, which uses the Admin REST path — it bypasses these rules entirely and returns
    // booleans, never records. If you are adding a rule here, the question to ask is not "can
    // this user read it" but "could a creator-side code path reach it".
    // ===============================================================

    // Published scan reconstructions. Artwork vectors, editable OCR text and interaction fields
    // remain one document, but only its teacher and assigned family accounts may retrieve it.
    match /digital_worksheets/{worksheetId} {
      allow read: if canAccessDigitalWorksheet(resource.data);
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isAdmin()) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /worksheet_assignments/{assignmentId} {
      allow read: if canAccessWorksheetAssignment(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.teacherUid == request.auth.uid &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow update: if isAuthenticated() &&
        (resource.data.teacherUid == request.auth.uid || isAdmin()) &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.worksheetId == resource.data.worksheetId;
      allow delete: if isAuthenticated() && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // Students own their response content; the linked teacher owns assignment/grade review.
    // Identity and assignment pointers cannot be swapped during an update.
    match /worksheet_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        request.auth.uid in resource.data.get('guardianUids', []) ||
        (resource.data.assignmentId is string &&
          worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.assignmentId is string && (
        request.resource.data.studentId == request.auth.uid ||
        worksheetAssignment(request.resource.data.assignmentId).teacherUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.worksheetId == resource.data.worksheetId &&
        request.resource.data.assignmentId == resource.data.assignmentId && (
          resource.data.studentId == request.auth.uid ||
          worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid ||
          isAdmin()
        );
      allow delete: if isAuthenticated() && (
        worksheetAssignment(resource.data.assignmentId).teacherUid == request.auth.uid || isAdmin()
      );
    }

    // Runtime failures and user ratings are append-only evidence. Actors may write only as
    // themselves and only for worksheets already inside their access boundary.
    match /assignment_quality_events/{eventId} {
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    match /assignment_quality_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        canAccessWorksheetById(request.resource.data.worksheetId);
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    match /assignment_quality/{qualityId} {
      allow read: if canAccessWorksheetById(resource.data.worksheetId);
      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/digital_worksheets/$(request.resource.data.worksheetId)).data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.worksheetId == resource.data.worksheetId &&
        get(/databases/$(database)/documents/digital_worksheets/$(resource.data.worksheetId)).data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    // The teacher's own integrity configuration: personas + Silent Mode settings.
    // Silent Mode may never be switched off while a verified district persona is active —
    // enforced here rather than only in the UI, because the UI is the part an attacker skips.
    match /teacherIntegrity/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Traversed with .get() defaults throughout: a teacher who hasn't linked a district has
      // no personas.district map at all, and a bare `resource.data.personas.district.active`
      // raises on the missing key — which denies the write. That would lock every teacher
      // WITHOUT a district out of their own settings, the exact opposite of the intent.
      allow update: if isOwner(uid) &&
        !(resource.data.get('personas', {}).get('district', {}).get('active', false) == true &&
          request.resource.data.get('integritySettings', {}).get('campusSilentMode', 'auto') == 'off');
      allow delete: if false;
    }

    // District-persona rosters. SALTED HASHES ONLY — raw student identity never reaches
    // Plajah. Readable by the owning teacher and their district admin; by no one else, and by
    // no creator-context path at all. Deletable by the teacher so leaving a district actually
    // removes the data.
    match /districtPersona/{uid}/rosters/{termId} {
      allow read: if isOwner(uid) ||
        (isAuthenticated() && request.auth.token.districtAdmin == resource.data.districtId);
      allow create, update: if isOwner(uid) ||
        (isAuthenticated() && request.auth.token.districtAdmin == request.resource.data.districtId);
      allow delete: if isOwner(uid);
    }

    // District roster salts. Server-only: with the salt, the hashes above become brute-forceable
    // against a list of student names, so no client — teacher, district admin, or Plajah admin —
    // reads or writes this from the SDK. Registration goes through POST /api/academia/district-salt.
    match /districtSecrets/{districtId} {
      allow read, write: if false;
    }

    // The integrity log — APPEND-ONLY, and the teacher's own property. This is the artifact
    // they hand to HR to prove they never operated on district time, so it must be impossible
    // to edit or prune after the fact, including by the person it protects.
    match /integrityLog/{uid}/events/{eventId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // Independent-persona offerings. Writes are refused while the Silent Mode claim is set —
    // the server mirrors that claim from the geofence/schedule engine, so a modified client
    // that ignores the UI lock still cannot transact or edit a storefront on campus.
    // Reads are unaffected: the storefront stays live to buyers the whole time.
    match /creators/{creatorId}/offerings/{offeringId} {
      allow read: if resource.data.visibility == 'public' || isOwner(creatorId);
      allow create, update, delete: if isOwner(creatorId) &&
        request.auth.token.silentMode != true;
    }

    // The OER library. Metadata is public — attribution and licence must be visible wherever
    // an item appears. Only a librarian may write, because `license` and `commercialOk` are
    // what the commercial gate reads; a teacher who could edit them could relicense CK-12.
    match /libraryItems/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.librarian == true;
    }

    // Assignment templates. The licence wall: a template may only claim commercialUse if the
    // server has already validated its materials. licenseValidated is server-set (Admin REST),
    // so a client cannot forge its way past the gate — it can only ever write the flag false.
    match /assignmentTemplates/{templateId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerUid);

      // A new template is always unvalidated and non-commercial. Validation is something the
      // server grants afterwards; it is never a property a document can be born with.
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.licenseValidated == false &&
        request.resource.data.commercialUse == false;

      // The client may LOWER licenseValidated (editing materials invalidates prior approval)
      // but never raise it — writing `true` is the one transition reserved for the server's
      // Admin REST path, which bypasses these rules. Without this clause a client could simply
      // set the flag itself and walk straight through the commercial gate.
      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (request.resource.data.licenseValidated == false ||
         request.resource.data.licenseValidated == resource.data.licenseValidated) &&
        (request.resource.data.commercialUse == false ||
         request.resource.data.licenseValidated == true);

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // A template handed to a class. Readable by the assigning teacher and by the students it
    // was assigned to — students need it to actually do the work, but must never be able to
    // edit the rubric they're about to be graded against.
    match /templateAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.studentIds ||
        request.auth.uid in resource.data.get('guardianUids', [])
      );
      allow create: if isAuthenticated() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }

    // A student's turned-in work. The student owns the submission; the teacher owns the grade.
    match /templateSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.get('guardianUids', [])
      );
      // Turning in must arrive ungraded — otherwise a student could submit with a grade
      // already attached and the ledger would credit mastery nobody assessed.
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.grade == null;
      // Only the teacher grades. A student may still edit their own work, but may never
      // touch the grade field — hence the two separate, non-overlapping update paths.
      allow update: if isAuthenticated() && (
        (resource.data.teacherUid == request.auth.uid) ||
        (resource.data.studentId == request.auth.uid &&
         resource.data.status != 'graded' &&
         request.resource.data.grade == resource.data.grade &&
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }
  
    // ── Template library (Ambo slide templates, scripture looks, Tela motion templates) ──
    // A saved template is a customised copy of a platform designer: base id + theme +
    // field values + motion/palette overrides. Owner edits; read when public, shared
    // with you, or yours. Anyone signed in may bump the `uses` counter on what they can read.
    function tplReadable(d) {
      return d.visibility == 'public'
        || (isAuthenticated() && (d.ownerUid == request.auth.uid || request.auth.uid in d.get('sharedWith', [])))
        || isAdmin();
    }
    function tplValid(d) {
      return d.ownerUid == request.auth.uid
        && d.kind in ['ambo-slide', 'scripture-look', 'tela-motion']
        && d.visibility in ['private', 'shared', 'public']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.get('sharedWith', []) is list && d.get('sharedWith', []).size() <= 200
        && d.get('thumb', '') is string && d.get('thumb', '').size() <= 200000;
    }
    match /templateLibrary/{templateId} {
      allow read: if tplReadable(resource.data);
      allow create: if isAuthenticated() && tplValid(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid && tplValid(request.resource.data))
        || (tplReadable(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
            && request.resource.data.uses == resource.data.get('uses', 0) + 1)
      );
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ── Tela document manifest (services/telaStore.ts) — owner only ──
    match /tela_docs/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // ── "Say hi" one-way greetings (services/sayHiService.ts) ──
    // hellos/{from_to}: created ONLY by `from`, once per ordered pair (no update path for the
    // sender, so a second create is an overwrite and is denied). Opt-OUT: recipient sets
    // users/{to}.sayHiOptOut. Readable by either party; recipient may mark seen / dismiss.
    // Block checks are enforced client-side in sayHiService (+ SAFETY's rules for follows).
    match /hellos/{helloId} {
      allow read: if isAuthenticated() &&
                    (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                      request.resource.data.fromUid == request.auth.uid &&
                      request.resource.data.toUid is string &&
                      request.resource.data.toUid != request.auth.uid &&
                      helloId == request.auth.uid + '_' + request.resource.data.toUid &&
                      request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromName', 'fromPhoto', 'message', 'timestamp']) &&
                      (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 140)) &&
                      get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.get('sayHiOptOut', false) != true &&
                      // Rate limit: the SAME batch must bump rateLimits/{me} (hlCount/hlWindowStart/lastHelloAt rules above).
                      getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.get('lastHelloAt', null) == request.time;
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']);
      allow delete: if isAuthenticated() && (resource.data.toUid == request.auth.uid || isAdmin());
    }

    // ── Posting power (services/bookmarkService, draftService, scheduledPostService,
    //    hashtagService, postAnalyticsService, retentionService) ──
    // Saved posts, collections, drafts and retention state are private to the owner.
    match /users/{userId}/bookmarks/{postId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/bookmarkCollections/{collectionId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/retention/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Scheduled posts: only the author reads/creates/cancels. The payload is published by the
    // author's client (or a future server job using the Admin SDK, which bypasses rules).
    // Reply audience / canReply is UI-level only: comment rules are intentionally unchanged.
    match /scheduled_posts/{id} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow create: if isRegisteredUser() && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.post is map
                    && request.resource.data.publishAt is number
                    && request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Hashtag rollup: public read; any signed-in user may create a tag doc with count 1 or bump
    // an existing one by exactly 1. Used for autocomplete + tag header totals only (trending is
    // computed from posts), so a spoofed count is cosmetic.
    match /hashtags/{tag} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.tag == tag
                    && request.resource.data.count == 1
                    && request.resource.data.keys().hasOnly(['tag', 'count', 'lastUsed']);
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastUsed'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // Post analytics: ONLY the post's author can read. Any signed-in viewer may write bounded,
    // batched increments (the client de-dupes per viewer/post/day) and may only create the doc
    // with the post's real authorId. No deletes. Numbers are approximate by design.
    match /postStats/{postId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.authorId == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
                    && request.resource.data.get('impressions', 0) <= 25
                    && request.resource.data.get('uniqueViewers', 0) <= 25
                    && request.resource.data.get('dwellMs', 0) <= 120000
                    && request.resource.data.get('profileVisits', 0) <= 5
                    && request.resource.data.get('followsFromPost', 0) <= 5;
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['impressions', 'uniqueViewers', 'dwellMs', 'profileVisits', 'followsFromPost', 'hourly', 'referrers', 'updatedAt'])
                    && request.resource.data.get('impressions', 0) - resource.data.get('impressions', 0) >= 0
                    && request.resource.data.get('impressions', 0) - resource.data.get('impressions', 0) <= 25
                    && request.resource.data.get('uniqueViewers', 0) - resource.data.get('uniqueViewers', 0) >= 0
                    && request.resource.data.get('uniqueViewers', 0) - resource.data.get('uniqueViewers', 0) <= 25
                    && request.resource.data.get('dwellMs', 0) - resource.data.get('dwellMs', 0) >= 0
                    && request.resource.data.get('dwellMs', 0) - resource.data.get('dwellMs', 0) <= 120000
                    && request.resource.data.get('profileVisits', 0) - resource.data.get('profileVisits', 0) >= 0
                    && request.resource.data.get('profileVisits', 0) - resource.data.get('profileVisits', 0) <= 5
                    && request.resource.data.get('followsFromPost', 0) - resource.data.get('followsFromPost', 0) >= 0
                    && request.resource.data.get('followsFromPost', 0) - resource.data.get('followsFromPost', 0) <= 5;
    }

    // ── Ambo projects (services/ambo/amboStorageService.ts) ──
    match /users/{userId}/amboProjects/{projectId} {
      allow read, write: if isOwner(userId);
    }
    match /organizations/{orgId}/amboProjects/{projectId} {
      allow read, write: if orgAdminOf(orgId)
        || (isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', []));
    }
  }
}

    // ── Ambo party/event mesh + TV receivers (services/ambo/amboPartyEventService.ts,
    //    services/tv/tvReceiverService.ts). A user's own screens and the session that drives them.
    match /users/{userId}/event_devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/ambo_party_event/{docId} {
      allow read, write: if isOwner(userId);
    }
    // TV pairing codes: the TV creates a short-lived code; one other signed-in user may claim it
    // (only the claim fields), and only that claimer may then push duties (only duty fields).
    match /tv_pairings/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
        || (!('claimedBy' in resource.data)
            && resource.data.expiresAt > request.time.toMillis()
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedByName', 'claimedAt']))
        || (resource.data.get('claimedBy', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duty', 'dutySeq']))
      );
      allow delete: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || resource.data.get('claimedBy', '') == request.auth.uid);
    }

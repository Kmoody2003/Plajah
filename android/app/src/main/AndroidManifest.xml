<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background media playback (music while screen off) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Embedded smart-home hub (PlajahHubService) — connectedDevice FGS type; CHANGE_WIFI_MULTICAST_STATE below satisfies its prerequisite. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Local Media player permissions: music, video, photos -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Camera + microphone: live streaming, video calls, WebRTC, VTuber, podcast/recording.
         Capacitor's WebView grants getUserMedia at runtime only if these are declared here. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera hardware is optional so the APK still installs on TV / camera-less tablets -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Boot receiver for scheduled recordings -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Signage autostart (BootReceiver): Android 10+ only lets a background receiver start an
         activity when the app holds "Display over other apps". On TVs without that settings
         screen: adb shell appops set com.plajah.app SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Direct Cast engine (speakers/CastDiscovery.kt): raw mDNS fallback needs a multicast lock -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        FireTV / Android TV: mark touchscreen as optional so the APK passes
        certification on leanback (D-pad only) devices.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Meta Horizon OS (Quest) spatial device compatibility -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" />

    <!-- Android 11+ package visibility: let SpeechRecognizer find the system speech service (Voca read-aloud) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Android 11+ package visibility: let SpeechRecognizer find the system speech service (Voca read-aloud) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Matter casting Content App (MatterCasting.kt / MatterCommandReceiver.kt). Bind to the TV's
         Matter agent service to report attribute changes; <queries> makes that service visible on
         Android 11+ without QUERY_ALL_PACKAGES. Inert on TVs that ship no Matter agent. -->
    <uses-permission android:name="com.matter.tv.app.api.permission.BIND_SERVICE_PERMISSION" />
    <queries>
        <intent>
            <action android:name="com.matter.tv.app.api.action.MatterAppAgent" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- Phone / tablet launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- FireTV / Android TV leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Universal link / deep link (plajah.com) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="plajah.com" />
            </intent-filter>

            <!-- Custom URI scheme for Alexa / voice assistants -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.plajah.app" />
            </intent-filter>

            <!-- Media button (headset buttons, Alexa media control) -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>

            <!-- "Open with Plajah" for local photos, videos and music (file managers, galleries,
                 downloads). MainActivity boots the light LocalMediaLaunch viewer (?open=media)
                 instead of the full platform, so the file is on screen almost immediately. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Experience launchers: extra home-screen / app-drawer icons that open Plajah straight
             into one experience. Each alias targets MainActivity; the experience slug rides in
             meta-data, MainActivity turns it into the web start path ?view=<slug>
             (src/lib/launchTarget.ts). Phone/tablet launcher only — TV keeps the single Plajah
             tile. Icons: node scripts/generate-experience-icons.mjs -->
        <activity-alias
            android:name=".launch.Chora"
            android:targetActivity=".MainActivity"
            android:label="Chora"
            android:icon="@mipmap/ic_launch_chora"
            android:roundIcon="@mipmap/ic_launch_chora_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="chora" />
        </activity-alias>
        <activity-alias
            android:name=".launch.Reello"
            android:targetActivity=".MainActivity"
            android:label="Reello"
            android:icon="@mipmap/ic_launch_reello"
            android:roundIcon="@mipmap/ic_launch_reello_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="reello" />
        </activity-alias>
        <activity-alias
            android:name=".launch.Taleo"
            android:targetActivity=".MainActivity"
            android:label="Taleo"
            android:icon="@mipmap/ic_launch_taleo"
            android:roundIcon="@mipmap/ic_launch_taleo_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="taleo" />
        </activity-alias>
        <activity-alias
            android:name=".launch.Fabula"
            android:targetActivity=".MainActivity"
            android:label="Fabula"
            android:icon="@mipmap/ic_launch_fabula"
            android:roundIcon="@mipmap/ic_launch_fabula_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="fabula" />
        </activity-alias>
        <activity-alias
            android:name=".launch.Pixels"
            android:targetActivity=".MainActivity"
            android:label="Pixels"
            android:icon="@mipmap/ic_launch_pixels"
            android:roundIcon="@mipmap/ic_launch_pixels_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="pixels" />
        </activity-alias>
        <activity-alias
            android:name=".launch.ChoraStudio"
            android:targetActivity=".MainActivity"
            android:label="Chora Studio"
            android:icon="@mipmap/ic_launch_chora_studio"
            android:roundIcon="@mipmap/ic_launch_chora_studio_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="chora_studio" />
        </activity-alias>
        <activity-alias
            android:name=".launch.Academia"
            android:targetActivity=".MainActivity"
            android:label="Academia"
            android:icon="@mipmap/ic_launch_academia"
            android:roundIcon="@mipmap/ic_launch_academia_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.plajah.app.EXPERIENCE" android:value="academia" />
        </activity-alias>

        <!-- Native Jetpack Compose shell (opt-in "Native" mode). Not a launcher: the app
             always starts at MainActivity (the Capacitor web shell), which hands off here when
             the user has toggled Native on. Uses the standard app theme (no splash). -->
        <activity
            android:name=".NativeActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:launchMode="singleTask" />

        <!-- Background media service — enables playback controls in notification shade,
             lock screen, Android Auto, Google Assistant, and Alexa Media Player -->
        <service
            android:name=".PlajahMediaService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Embedded Node.js smart-home hub (Matter controller, Hue, /api/home). Own process because
             node::Start runs once per process; stop = process exit. See PlajahHubService.kt. -->
        <service
            android:name=".PlajahHubService"
            android:process=":hub"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Android Auto descriptor -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Meta Horizon OS (Quest) spatial app compatibility -->
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data android:name="com.oculus.supportedPlatform" android:value="quest|quest2|questpro|quest3" />

        <!-- Google Cast receiver metadata (required by Cast SDK) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.plajah.app.PlajahCastOptionsProvider"
        />

        <!-- Matter casting Content App identity, read by the TV's Matter agent at the APPLICATION
             level (connectedhomeip platform-app ContentAppDiscoveryService). vendor_id 65521 =
             0xFFF1, a CSA TEST vendor id: fine for development against a test agent, not for
             certification or production; replace with Plajah's CSA-assigned VID/PID. The clusters
             key is declared under both spellings in the wild (upstream "app", Amazon's docs
             "application"). -->
        <meta-data android:name="com.matter.tv.app.api.clusters" android:resource="@raw/static_matter_clusters" />
        <meta-data android:name="com.matter.tv.application.api.clusters" android:resource="@raw/static_matter_clusters" />
        <meta-data android:name="com.matter.tv.app.api.vendor_name" android:value="Plajah" />
        <meta-data android:name="com.matter.tv.app.api.vendor_id" android:value="65521" />
        <meta-data android:name="com.matter.tv.app.api.product_id" android:value="32769" />

        <!-- Signage autostart after boot / power cut; inert unless PlajahDevice enabled it. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Matter commands / attribute reads from the agent. Only holders of SEND_DATA (the agent)
             can deliver them. -->
        <receiver
            android:name=".MatterCommandReceiver"
            android:permission="com.matter.tv.app.api.permission.SEND_DATA"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.matter.tv.app.api.action.MATTER_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

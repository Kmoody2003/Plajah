<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 base theme — Compose components inherit this automatically -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Plajah brand orange as primary -->
        <item name="colorPrimary">#FF8C00</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#FF8C00</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorTertiary">#FF8C00</item>

        <!-- Transparent system bars so WebView renders edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Brand-black behind the WebView so the splash → app handoff never flashes white. -->
        <item name="android:windowBackground">@color/plajah_splash_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Splash screen — transitions into AppTheme once the WebView is ready.
         Android 12+ uses the SplashScreen API and IGNORES `android:background`, falling back to the
         system default (the launcher icon on its own background) — that is the green Android screen.
         Setting the SplashScreen attributes explicitly replaces it with Plajah's mark on brand black,
         so the launch reads as Plajah and hands off to the in-app ident without a colour flash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/plajah_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/plajah_splash_bg</item>
        <!-- Pre-12 devices still honour this. -->
        <item name="android:windowBackground">@color/plajah_splash_bg</item>
        <item name="android:background">@color/plajah_splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>

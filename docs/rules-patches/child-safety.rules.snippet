                       request.resource.data.get('teacherVerification', 'UNVERIFIED') == 'UNVERIFIED' &&
                       noPlatformPrivilegeGrab(request.resource.data)) ||
                      (isAuthenticated() &&
                       request.resource.data.isChild == true &&
                       request.resource.data.guardianUid == request.auth.uid) ||
                      // Managed EMPLOYEE profile: a business owner/admin provisions a Firestore-only
                      // work identity (no login). Must be flagged isEmployee and owned by the creator.
                      (isAuthenticated() &&
                       request.resource.data.isEmployee == true &&
                       request.resource.data.managedByUid == request.auth.uid);
      allow update: if (isOwner(userId) && isValidUserProfile(request.resource.data) &&
                       request.resource.data.get('teacherVerification', 'UNVERIFIED') == resource.data.get('teacherVerification', 'UNVERIFIED') &&
                       platformPrivilegeUnchanged(request.resource.data, resource.data)) ||
                      (isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) &&
                       math.abs(request.resource.data.followerCount - resource.data.followerCount) == 1) ||
                      (isAuthenticated() &&
                       resource.data.isChild == true &&
                       resource.data.guardianUid == request.auth.uid) ||
*/

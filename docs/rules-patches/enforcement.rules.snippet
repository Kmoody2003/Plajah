// Fair Process enforcement — paste inside `match /databases/{database}/documents { ... }` of the LIVE
// rules (the small set, e.g. .rules-hotfix/firestore.rules), next to the other top-level matches.
// Uses the helpers isAuthenticated(), isOwner(uid), isAdmin() that the live set already defines.
// NOTE: the live set (as of 2026-10-08) has NO user_sanctions block, so the client cannot read its own
// standing via snapshot (hooks/useAccountStanding.ts falls back to GET /api/enforcement/me). Include it.
// All three collections are written by the server (service account bypasses rules) — never by clients.
// The legacy ReportsQueue "block reporter" action still writes user_sanctions client-side as an admin,
// hence `allow create, update: if isAdmin()` on that one only.

    match /user_sanctions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /enforcement_actions/{actionId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /appeals/{appealId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for Plajah Visualizer Engine, this defines Forward+ Vulkan,
; SDFGI real-time global illumination, Screen Space Reflections (SSR),
; and Volumetric Fog.

config_version=5

[application]

config/name="Plajah Audio Visualizer Engine (Godot 4)"
config/description="Next-generation real-time audio visualizer for Plajah Desktop using Vulkan Forward+, SDFGI, and Screen Space Reflections."
run/main_scene="res://scenes/MasterGalleryGD.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="PlajahVisualizerGodot4"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_environment="res://default_env.tres"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=1
global_illumination/sdfgi/frames_to_update_lights=1
camera/depth_of_field/depth_of_field_bokeh_shape=2

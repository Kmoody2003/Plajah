# Stripe TEST MODE for local store testing. Copy to .env.stripe-test.local (git-ignored) and fill in.
# Get the secret key from https://dashboard.stripe.com/test/apikeys (Test mode toggle ON). Only an sk_test_ key works:
# the server refuses a live key while test mode is on. (Store checkout is Stripe-hosted, so no publishable key is needed.)
STRIPE_SECRET_KEY=sk_test_...

# The one test connected account every test checkout pays out to. scripts/stripeTestSetup.mjs creates it and fills this in.
STRIPE_TEST_DESTINATION=

# From `stripe listen --forward-to localhost:3300/api/stripe/webhook --forward-connect-to localhost:3300/api/stripe/connect-webhook`
# (it prints one whsec_ secret; use it for all three).
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_MERCH_WEBHOOK_SECRET=whsec_...

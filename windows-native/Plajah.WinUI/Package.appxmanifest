<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap rescap desktop4 uap10">

  <Identity Name="Plajah.Platform" Publisher="CN=Plajah" Version="1.0.56.0" />

  <Properties>
    <DisplayName>Plajah</DisplayName>
    <PublisherDisplayName>Plajah</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Plajah"
        Description="Plajah — the creator platform: Fabula editor, Reello video, Chora music, live streaming and more, native on Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- File type associations: Photos & Images -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="image">
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.raw</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Media Plajah Photo Viewer</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- File type associations: Videos -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="video">
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Media Plajah Video Player</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- File type associations: Audio / Music -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="audio">
            <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Media Plajah Music Player</uap:DisplayName>
            <uap:EditFlags OpenIsSafe="true" />
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
    <Application Id="MediaPlajah" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Media Plajah"
        Description="Media Plajah — Standalone high-fidelity local media player with Chora bit-perfect audio, 4K video, and creative bridges."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
    <!-- Experience launchers: same exe, opened straight into one experience. Each shows as its own
         entry in Start / All apps. MainWindow.ParseExperience reads the slug and the web layer maps
         it (src/lib/launchTarget.ts). Icons: node scripts/generate-experience-icons.mjs -->
    <Application Id="Chora" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=chora">
      <uap:VisualElements
        DisplayName="Chora"
        Description="Chora — stream music, albums, mixes and your local library."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Chora.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Chora.Square44x44Logo.png" />
    </Application>
    <Application Id="Reello" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=reello">
      <uap:VisualElements
        DisplayName="Reello"
        Description="Reello — creator video, shorts and live."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Reello.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Reello.Square44x44Logo.png" />
    </Application>
    <Application Id="Taleo" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=taleo">
      <uap:VisualElements
        DisplayName="Taleo"
        Description="Taleo — films, series and TV."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Taleo.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Taleo.Square44x44Logo.png" />
    </Application>
    <Application Id="Fabula" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=fabula">
      <uap:VisualElements
        DisplayName="Fabula"
        Description="Fabula — the AI film editor."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Fabula.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Fabula.Square44x44Logo.png" />
    </Application>
    <Application Id="Pixels" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=pixels">
      <uap:VisualElements
        DisplayName="Plajah Pixels"
        Description="Plajah Pixels — live visuals and VJ performance."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Pixels.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Pixels.Square44x44Logo.png" />
    </Application>
    <Application Id="ChoraStudio" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=chora_studio">
      <uap:VisualElements
        DisplayName="Chora Studio"
        Description="Chora Studio — music production, powered by Melos."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\ChoraStudio.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\ChoraStudio.Square44x44Logo.png" />
    </Application>
    <Application Id="Academia" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true" uap10:Parameters="--experience=academia">
      <uap:VisualElements
        DisplayName="Academia"
        Description="Plajah Academia — classes, assignments and learning."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Experiences\Academia.Square150x150Logo.png"
        Square44x44Logo="Assets\Experiences\Academia.Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <uap:Capability Name="picturesLibrary" />
    <uap:Capability Name="videosLibrary" />
    <uap:Capability Name="musicLibrary" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Plajah.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Always build for one Windows runtime (release already passes -r win-x64). Without it,
         LLamaSharp's native packages copy every OS's libraries and the resource indexer fails. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Single-project MSIX: the modern packaging target — no separate .wapproj needed. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>129FDFBD536732010E512F6F30F73E38410CEB7F</PackageCertificateThumbprint>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.cs owns Main so single-instance redirection runs before XAML starts (no UI-thread deadlock). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 1.7 = current WinUI 3 line (Mica, AppWindow title bar, etc.) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <!-- On-device language models (NativeLlmService): llama.cpp through LLamaSharp. Vulkan reaches
         NVIDIA RTX / AMD / Intel GPUs from one small runtime; CPU is the fallback. CUDA is left out
         on purpose — it would add ~0.5 GB+ to every install for a modest speedup on NVIDIA only. -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <!-- ASIO driver host for Chora multitrack capture (AsioMultitrackRecorder). MIT. -->
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Processing.NDI.Lib.x64.dll" Condition="Exists('Processing.NDI.Lib.x64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Open Media Transport (MIT) — official libomtnet v1.0.0.19 release binaries from
       github.com/openmediatransport/libomtnet: the managed library + its native VMX codec. -->
  <ItemGroup>
    <Reference Include="libomtnet">
      <HintPath>..\third_party\omt\win-x64\libomtnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="..\third_party\omt\win-x64\libvmx.dll">
      <Link>libvmx.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SRT in/out runs through an ffmpeg child built with libsrt (see FfmpegLocator.cs). Optional:
       drop an SRT-capable ffmpeg.exe into third_party\ffmpeg\win-x64 and it ships in <app>\ffmpeg\. -->
  <ItemGroup Condition="Exists('..\third_party\ffmpeg\win-x64\ffmpeg.exe')">
    <Content Include="..\third_party\ffmpeg\win-x64\ffmpeg.exe">
      <Link>ffmpeg\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\dist')">
    <Content Include="..\..\dist\**\*.*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

<Window
    x:Class="Plajah.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- drag region for the custom title bar (content extends into it → Win11-native look) -->
    <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent" />
    <wv2:WebView2 x:Name="Web" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,0,0" />
  </Grid>
</Window>

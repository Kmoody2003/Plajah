<Window
    x:Class="Plajah.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls">
  <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PointerWheelChanged="Root_PointerWheelChanged">
    <wv2:WebView2 x:Name="Web"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="0,0,0,0"
            WebMessageReceived="Web_WebMessageReceived" />
  </Grid>
</Window>

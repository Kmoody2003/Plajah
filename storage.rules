rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Shared helpers ────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // NOTE: Firebase Storage cross-service Firestore lookups only support the
    // (default) Firestore database. This project uses a named database so the
    // firestore.exists() call always returns false. isAdmin() is kept for the
    // existing rules that depend on it; it effectively means "deny" for those
    // fallback branches, which was already the case before.
    function isAdmin() {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Content-type must be a recognised media or document type
    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/epub.*') ||
             request.resource.contentType.matches('text/.*');
    }

    // Maximum 2 GB for any single file
    function withinSizeLimit() {
      return request.resource.size < 2 * 1024 * 1024 * 1024;
    }

    // ── User-scoped files ─────────────────────────────────────────────────────
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAuth() && request.auth.uid == uid && isAllowedContentType() && withinSizeLimit())
                   || isAdmin();
    }

    // ── Album content ─────────────────────────────────────────────────────────
    match /albums/{albumId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAuth() && isAllowedContentType() && withinSizeLimit()) || isAdmin();
    }

    // ── Video content ─────────────────────────────────────────────────────────
    match /videos/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAuth() && isAllowedContentType() && withinSizeLimit()) || isAdmin();
    }

    // ── HideNSeek game assets ─────────────────────────────────────────────────
    match /hideNSeek/{allPaths=**} {
      allow read: if true;
      allow write: if (isAuth() && isAllowedContentType() && withinSizeLimit()) || isAdmin();
    }

    // ── Club cover media ──────────────────────────────────────────────────────
    // Admin-managed via the admin dashboard. Cross-service Firestore admin
    // checks don't work with named databases, so we check auth + content type.
    // The admin gate is enforced at the UI layer and in Firestore rules.
    match /club-cover-media/{fileName} {
      allow read: if true;
      allow write: if isAuth() && isAllowedContentType() && withinSizeLimit();
    }

    // ── Classic books — public domain texts hosted on Plajah storage ─────────
    match /books/classics/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Fallback: deny everything not explicitly matched ──────────────────────
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
